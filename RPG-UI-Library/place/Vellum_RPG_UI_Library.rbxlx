    <Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">Theme</string><ProtectedString name="Source"><![CDATA[--!strict
-- Vellum design tokens: colour, type, spacing, motion and rarity. Every component reads from here;
-- nothing hard-codes a colour or a font.
--
-- Identity: an illuminated grimoire. Dark umber leather panels with gilt edges, parchment cards with
-- iron-gall ink, jewel-toned rarity and a single arcane teal for magic and focus.

local Theme = {}

local function hex(s: string): Color3
	return Color3.fromHex(s)
end

Theme.color = {
	-- leather surfaces (darkest → raised)
	void = hex("0E0A08"),
	leather0 = hex("17100C"),
	leather1 = hex("221812"),
	leather2 = hex("2E2119"),
	leather3 = hex("3C2C21"),
	seam = hex("4A3628"),

	-- parchment surfaces
	vellum = hex("EADCBF"),
	vellumDeep = hex("D9C59E"),
	vellumEdge = hex("B39568"),
	ink = hex("2B1D12"),
	inkSoft = hex("5E4630"),
	inkFaint = hex("8C735A"),

	-- gilt
	gold = hex("D4A55A"),
	goldBright = hex("F3D08A"),
	goldPale = hex("FBEBC4"),
	goldDeep = hex("8A6630"),
	bronze = hex("6E4E2A"),

	-- text on leather
	text = hex("F1E6D2"),
	textSoft = hex("C2B39C"),
	textFaint = hex("8D7D69"),
	textGhost = hex("5F5246"),

	-- signal
	arcane = hex("57D1C4"), -- focus, magic, selection
	arcaneDeep = hex("1E5D58"),
	good = hex("7BCB5E"),
	bad = hex("E5574F"),
	warn = hex("F0B04A"),
	info = hex("6FB3EE"),

	-- vitals
	health = hex("D8453F"),
	healthDeep = hex("6E1A18"),
	mana = hex("4D8FE6"),
	manaDeep = hex("1B3466"),
	stamina = hex("E0B23C"),
	staminaDeep = hex("6A4F12"),
	xp = hex("B98CF0"),
	xpDeep = hex("3D2466"),
}

export type Rarity = "common" | "uncommon" | "rare" | "epic" | "legendary" | "mythic"
Theme.rarityOrder = { "common", "uncommon", "rare", "epic", "legendary", "mythic" } :: { Rarity }
Theme.rarity = {
	common = { name = "Common", color = hex("B7AE9F"), deep = hex("3A342D"), rank = 1 },
	uncommon = { name = "Uncommon", color = hex("72C45A"), deep = hex("1D3A17"), rank = 2 },
	rare = { name = "Rare", color = hex("4F9DE8"), deep = hex("132E4F"), rank = 3 },
	epic = { name = "Epic", color = hex("B472EE"), deep = hex("341A4D"), rank = 4 },
	legendary = { name = "Legendary", color = hex("F2A93B"), deep = hex("4D300B"), rank = 5 },
	mythic = { name = "Mythic", color = hex("EE5A5F"), deep = hex("4D1517"), rank = 6 },
}

local FAMILY = "rbxasset://fonts/families/"
Theme.font = {
	display = Font.new(FAMILY .. "AccanthisADFStd.json", Enum.FontWeight.Regular),
	blackletter = Font.new(FAMILY .. "GrenzeGotisch.json", Enum.FontWeight.SemiBold),
	body = Font.new(FAMILY .. "Merriweather.json", Enum.FontWeight.Regular),
	bodyLight = Font.new(FAMILY .. "Merriweather.json", Enum.FontWeight.Light),
	bodyBold = Font.new(FAMILY .. "Merriweather.json", Enum.FontWeight.Bold),
	bodyHeavy = Font.new(FAMILY .. "Merriweather.json", Enum.FontWeight.Heavy),
	italic = Font.new(FAMILY .. "Merriweather.json", Enum.FontWeight.Regular, Enum.FontStyle.Italic),
	numeric = Font.new(FAMILY .. "Merriweather.json", Enum.FontWeight.Bold),
}

-- type scale (px at UIScale 1)
Theme.text = { hero = 44, title = 26, heading = 20, label = 16, body = 15, small = 13, tiny = 11 }

Theme.space = { xxs = 2, xs = 4, sm = 8, md = 12, lg = 16, xl = 24, xxl = 32 }
Theme.radius = { sm = 3, md = 6, lg = 10, pill = 999 }

-- sizes that keep proportions consistent between components
Theme.size = {
	control = 40, -- buttons, inputs, dropdowns
	controlSmall = 32,
	controlLarge = 52,
	slot = 64, -- inventory / equipment slot
	slotSmall = 48,
	icon = 20,
	node = 58, -- skill tree node
}

Theme.motion = {
	fast = 0.08,
	base = 0.16,
	slow = 0.32,
	reveal = 0.55,
	ease = Enum.EasingStyle.Quint,
	spring = Enum.EasingStyle.Back,
}

Theme.z = { base = 1, raised = 5, popover = 50, tooltip = 80, modal = 100, toast = 120, drag = 200 }

function Theme.rarityOf(r: string?)
	return (Theme.rarity :: any)[r or "common"] or Theme.rarity.common
end

-- Layout classes: components read the class, not raw pixels.
export type LayoutClass = "wide" | "compact" | "narrow"
function Theme.layoutClass(width: number): LayoutClass
	if width >= 1100 then
		return "wide"
	elseif width >= 720 then
		return "compact"
	end
	return "narrow"
end

return Theme
]]></ProtectedString></Properties>
    </Item>
    <Item class="Folder" referent="RBX10"><Properties><string name="Name">Components</string></Properties>
      <Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">Button</string><ProtectedString name="Source"><![CDATA[--!strict
-- Button: gilded primary, leather secondary, ghost, danger and arcane variants in three sizes.
-- States (via Interact): hover lifts and brightens, pressed sinks, focus draws an arcane ring,
-- selected shows a gem, disabled desaturates, loading swaps the icon for a turning rune and blocks input.
local Theme = require(script.Parent.Parent.Theme)
local Atlas = require(script.Parent.Parent.Atlas)
local Create = require(script.Parent.Parent.Core.Create)
local Motion = require(script.Parent.Parent.Core.Motion)
local Interact = require(script.Parent.Parent.Core.Interact)
local Surface = require(script.Parent.Surface)

local C = Theme.color
local Button = {}

export type Variant = "primary" | "secondary" | "ghost" | "danger" | "arcane" | "ink"
export type Size = "small" | "medium" | "large"

type Look = { fill: { Color3 }, text: Color3, stroke: Color3, strokeT: number, inset: Color3, insetT: number }

local LOOK: { [string]: Look } = {
	primary = { fill = { C.goldPale, C.goldBright, C.gold, C.goldDeep }, text = C.ink, stroke = C.void, strokeT = 0.1, inset = C.goldPale, insetT = 0.25 },
	secondary = { fill = { C.leather3, C.leather2, C.leather1 }, text = C.goldBright, stroke = C.gold, strokeT = 0.15, inset = C.gold, insetT = 0.75 },
	ghost = { fill = { C.leather2, C.leather2 }, text = C.goldBright, stroke = C.gold, strokeT = 1, inset = C.gold, insetT = 1 },
	-- for parchment surfaces: ink text, appears on hover like ghost
	ink = { fill = { C.vellumDeep, C.vellumDeep }, text = C.ink, stroke = C.inkSoft, strokeT = 1, inset = C.ink, insetT = 1 },
	danger = { fill = { Color3.fromHex("D0574F"), Color3.fromHex("A8332D"), Color3.fromHex("6E1A18") }, text = C.goldPale, stroke = C.void, strokeT = 0.1, inset = Color3.fromHex("F2A097"), insetT = 0.55 },
	arcane = { fill = { Color3.fromHex("7FE3D7"), Color3.fromHex("3FAEA2"), Color3.fromHex("1E5D58") }, text = C.void, stroke = C.void, strokeT = 0.1, inset = Color3.fromHex("CFF7F2"), insetT = 0.4 },
}

local SIZE = {
	small = { h = Theme.size.controlSmall, text = 14, pad = 14, icon = 16 },
	medium = { h = Theme.size.control, text = 16, pad = 20, icon = 18 },
	large = { h = Theme.size.controlLarge, text = 19, pad = 28, icon = 22 },
}

local function lerp(a: Color3, b: Color3, t: number)
	return a:Lerp(b, t)
end

local function seq(colors: { Color3 }, f: (Color3) -> Color3): ColorSequence
	local keys = {}
	for i, c in colors do
		table.insert(keys, ColorSequenceKeypoint.new((i - 1) / math.max(1, #colors - 1), f(c)))
	end
	if #keys == 1 then
		table.insert(keys, ColorSequenceKeypoint.new(1, f(colors[1])))
	end
	return ColorSequence.new(keys)
end

export type Props = {
	text: string?,
	variant: Variant?,
	size: Size?,
	icon: string?, -- glyph name
	width: number?, -- fixed width; otherwise fits the label
	fill: boolean?, -- stretch to parent width
	keyHint: string?,
	disabled: boolean?,
	selected: boolean?,
	onClick: (() -> ())?,
	layoutOrder: number?,
	parent: Instance?,
}

function Button.new(scope: any, props: Props)
	local variant = props.variant or "primary"
	local look = LOOK[variant]
	local sz = SIZE[props.size or "medium"]

	local root = Create("TextButton", {
		Name = "Button_" .. variant,
		Text = "",
		BackgroundTransparency = 1,
		Size = if props.fill then UDim2.new(1, 0, 0, sz.h) elseif props.width then UDim2.fromOffset(props.width, sz.h) else UDim2.fromOffset(120, sz.h),
		LayoutOrder = props.layoutOrder or 0,
	})
	scope:add(root)

	-- Decorations live in a scale-1 container: an auto-sized root only measures its direct children,
	-- so rings that overhang the button (scale 1 + offset) cannot feed back into its width.
	local deco = Create.box({ Name = "Deco", Size = UDim2.fromScale(1, 1), Parent = root })
	-- body moves for press / hover; root keeps the hitbox steady
	local body = Create("Frame", {
		Name = "Body",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Parent = deco,
	}, { Create.corner(5) })
	local gradient = Create.gradient(look.fill, 90)
	gradient.Parent = body
	local stroke = Create.stroke(look.stroke, 2, look.strokeT)
	stroke.Parent = body
	local inset = Atlas.image("chrome", "frame_inset", {
		Name = "Inset",
		Size = UDim2.fromScale(1, 1),
		ImageColor3 = look.inset,
		ImageTransparency = look.insetT,
		SliceScale = 1,
		ZIndex = 2,
		Parent = body,
	})
	-- top sheen
	local sheen = Create("Frame", {
		Name = "Sheen",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = if variant == "ghost" or variant == "ink" then 1 else 0.82,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(3, 3),
		Size = UDim2.new(1, -6, 0.42, -3),
		ZIndex = 2,
		Parent = body,
	}, { Create.corner(3), Create("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(0, 1) }) })
	local press = Create.scale(1)
	press.Parent = root

	local row = Create.box({
		Name = "Row",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = if not (props.fill or props.width) then UDim2.fromScale(0, 1) else UDim2.fromScale(1, 1),
		AutomaticSize = if not (props.fill or props.width) then Enum.AutomaticSize.X else Enum.AutomaticSize.None,
		ZIndex = 3,
		Parent = root,
	}, {
		Create.list("x", 8, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center),
		Create.padding(0, sz.pad, 0, sz.pad),
	})

	if not (props.fill or props.width) then
		scope:add(Create.fitWidth(root, row, sz.h))
	end

	local icon: ImageLabel? = nil
	if props.icon then
		icon = Atlas.image("glyph", props.icon, {
			Name = "Icon",
			Size = UDim2.fromOffset(sz.icon, sz.icon),
			ImageColor3 = look.text,
			LayoutOrder = 1,
			ZIndex = 3,
			Parent = row,
		})
	end
	local spinner = Atlas.image("chrome", "spinner", {
		Name = "Spinner",
		Size = UDim2.fromOffset(sz.icon, sz.icon),
		ImageColor3 = look.text,
		Visible = false,
		LayoutOrder = 1,
		ZIndex = 3,
		Parent = row,
	})
	local label = Surface.text({
		role = "heading",
		text = props.text or "",
		size = sz.text,
		color = look.text,
		LayoutOrder = 2,
		ZIndex = 3,
		Parent = row,
	})
	label.Name = "Label"
	label.Visible = (props.text or "") ~= ""
	if variant == "primary" or variant == "arcane" or variant == "danger" then
		-- engraved text: a 1px highlight under the ink on light fills, a shadow on dark ones
		label.TextStrokeTransparency = 1
	end

	local keycap: Frame? = nil
	if props.keyHint then
		keycap = Create("Frame", {
			Name = "KeyHint",
			BackgroundColor3 = C.void,
			BackgroundTransparency = 0.55,
			Size = UDim2.fromOffset(0, 20),
			AutomaticSize = Enum.AutomaticSize.X,
			LayoutOrder = 3,
			ZIndex = 3,
			Parent = row,
		}, { Create.corner(4), Create.padding(0, 6, 0, 6), Create.stroke(look.text, 1, 0.5) })
		Surface.text({ role = "tiny", text = props.keyHint, color = if variant == "secondary" or variant == "ghost" then C.textSoft else C.goldPale, size = 11, Size = UDim2.fromScale(0, 1), AutomaticSize = Enum.AutomaticSize.X, ZIndex = 4, Parent = keycap })
	end

	-- selected gem and focus ring sit outside the body
	local gem = Atlas.image("chrome", "gem", {
		Name = "SelectedGem",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, -1),
		Size = UDim2.fromOffset(16, 16),
		ImageColor3 = C.arcane,
		Visible = false,
		ZIndex = 6,
		Parent = deco,
	})
	local ring = Create("Frame", {
		Name = "FocusRing",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(-5, -5),
		Size = UDim2.new(1, 10, 1, 10),
		Visible = false,
		ZIndex = 5,
		Parent = deco,
	}, { Create.corner(8), Create.stroke(C.arcane, 2, 0) })
	local ringGlow = Create.stroke(C.arcane, 6, 0.8)
	ringGlow.Parent = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = ring }, { Create.corner(8) })

	local spinConn: RBXScriptConnection? = nil
	local handle = {} :: any

	local function render(s)
		local bright = if s.pressed then -0.12 elseif s.hover or s.focused then 0.12 else 0
		local disabled = s.disabled
		local f = function(c: Color3)
			if disabled then
				local g = c.R * 0.3 + c.G * 0.55 + c.B * 0.15
				return Color3.new(g, g, g):Lerp(C.leather2, 0.55)
			end
			if bright > 0 then
				return lerp(c, Color3.new(1, 1, 1), bright)
			elseif bright < 0 then
				return lerp(c, Color3.new(0, 0, 0), -bright)
			end
			return c
		end
		gradient.Color = seq(look.fill, f)
		if variant == "ghost" or variant == "ink" then
			body.BackgroundTransparency = if disabled then 1 elseif s.pressed then 0.55 elseif s.hover or s.focused or s.selected then 0.75 else 1
			stroke.Transparency = if s.hover or s.focused or s.selected then 0.45 else 1
		else
			body.BackgroundTransparency = 0
			stroke.Transparency = if disabled then 0.6 else look.strokeT
		end
		local textColor = if disabled then (if variant == "ink" then C.inkFaint else C.textFaint) else look.text
		label.TextColor3 = textColor
		if icon then
			icon.ImageColor3 = textColor
		end
		spinner.ImageColor3 = textColor
		inset.ImageTransparency = if disabled then 0.9 else look.insetT
		sheen.Visible = not disabled and not s.pressed and variant ~= "ghost" and variant ~= "ink"
		Motion.tween(press, { Scale = if s.pressed then 0.96 else 1 }, Theme.motion.fast, nil, nil, "press")
		local dy = if s.pressed then 1 elseif (s.hover and not disabled) then -1 else 0
		Motion.tween(body, { Position = UDim2.fromOffset(0, dy) }, Theme.motion.fast, nil, nil, "lift")
		Motion.tween(row, { Position = UDim2.new(0.5, 0, 0, dy) }, Theme.motion.fast, nil, nil, "lift")
		ring.Visible = s.focused and not disabled
		gem.Visible = s.selected
		if s.selected and variant == "secondary" then
			stroke.Color = C.goldBright
			stroke.Thickness = 2.5
		else
			stroke.Color = look.stroke
			stroke.Thickness = 2
		end

		local loading = s.loading
		spinner.Visible = loading
		if icon then
			icon.Visible = not loading
		end
		if loading and not spinConn then
			spinConn = scope:connect(game:GetService("RunService").RenderStepped, function(dt)
				if Motion.paused then
					return
				end
				spinner.Rotation = (spinner.Rotation + dt * 300) % 360
			end)
		elseif not loading and spinConn then
			spinConn:Disconnect()
			spinConn = nil
		end
		label.TextTransparency = if loading then 0.35 else 0
	end

	local ctl = Interact.attach(root, scope, render, function()
		if props.onClick then
			props.onClick()
		end
	end)
	ctl:set({ disabled = props.disabled == true, selected = props.selected == true })

	handle.Instance = root
	handle.controller = ctl
	function handle.setText(_, t: string)
		label.Text = t
		label.Visible = t ~= ""
	end
	function handle.setDisabled(_, v: boolean)
		ctl:set({ disabled = v })
	end
	function handle.setLoading(_, v: boolean)
		ctl:set({ loading = v })
	end
	function handle.setSelected(_, v: boolean)
		ctl:set({ selected = v })
	end
	function handle.force(_, patch)
		ctl:force(patch)
	end
	if props.parent then
		root.Parent = props.parent
	end
	return handle
end

return Button
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">Controls</string><ProtectedString name="Source"><![CDATA[--!strict
-- Controls: IconButton, Toggle, Checkbox / Radio, Segmented, Tabs, Slider, Dropdown and SearchBox.
-- Every control: new(scope, props) -> handle with .Instance, setters, and a `changed` callback in props.
-- All pressables go through Interact, so hover / press / focus / disabled behave the same everywhere.
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")

local Theme = require(script.Parent.Parent.Theme)
local Atlas = require(script.Parent.Parent.Atlas)
local Create = require(script.Parent.Parent.Core.Create)
local Motion = require(script.Parent.Parent.Core.Motion)
local Interact = require(script.Parent.Parent.Core.Interact)
local Layers = require(script.Parent.Parent.Core.Layers)
local Surface = require(script.Parent.Surface)

local C = Theme.color
local M = Theme.motion
local Controls = {}

local function focusRing(parent: GuiObject, radius: number, pad: number?): Frame
	local p = pad or 4
	return Create("Frame", {
		Name = "FocusRing",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(-p, -p),
		Size = UDim2.new(1, p * 2, 1, p * 2),
		Visible = false,
		ZIndex = 8,
		Parent = parent,
	}, { Create.corner(radius + p), Create.stroke(C.arcane, 2, 0) })
end

---------------------------------------------------------------- IconButton
-- Round gilt medallion with a glyph. props: icon, size, badge (number), tone ("gold" | "arcane" | "danger"), onClick
function Controls.iconButton(scope: any, props: { [string]: any })
	local size = props.size or 46
	local root = scope:add(Create("ImageButton", {
		Name = "IconButton_" .. (props.icon or ""),
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(size, size),
		LayoutOrder = props.layoutOrder or 0,
		Image = "",
	}))
	local disc = Atlas.image("chrome", "disc", { Name = "Disc", Size = UDim2.fromScale(0.86, 0.86), Position = UDim2.fromScale(0.07, 0.07), ImageColor3 = C.leather2, Parent = root })
	local grad = Create.gradient({ C.leather3, C.leather1 }, 90)
	grad.Parent = disc
	local ring = Atlas.image("chrome", "medallion", { Name = "Ring", Size = UDim2.fromScale(1, 1), ZIndex = 2, Parent = root })
	local glyph = Atlas.image("glyph", props.icon or "star", {
		Name = "Glyph",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.46, 0.46),
		ImageColor3 = C.goldBright,
		ZIndex = 3,
		Parent = root,
	})
	local glow = Atlas.image("chrome", "glow", { Name = "Glow", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1.5, 1.5), ImageColor3 = C.goldBright, ImageTransparency = 1, ZIndex = 0, Parent = root })
	local fr = focusRing(root, size / 2, 3)
	local press = Create.scale(1)
	press.Parent = root
	local badge: TextLabel? = nil
	local badgeFrame: Frame? = nil
	if props.badge then
		badgeFrame = Create("Frame", {
			Name = "Badge",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 4, 0, -2),
			Size = UDim2.fromOffset(20, 20),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = C.bad,
			ZIndex = 9,
			Parent = root,
		}, { Create.corner(10), Create.stroke(C.void, 2, 0), Create.padding(0, 5, 0, 5) })
		badge = Surface.text({ role = "tiny", text = tostring(props.badge), color = C.goldPale, Size = UDim2.fromScale(0, 1), AutomaticSize = Enum.AutomaticSize.X, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 10, Parent = badgeFrame })
	end
	local tone = if props.tone == "arcane" then C.arcane elseif props.tone == "danger" then C.bad else C.goldBright

	local ctl = Interact.attach(root, scope, function(s)
		glyph.ImageColor3 = if s.disabled then C.textGhost elseif s.selected then C.void else tone
		disc.ImageColor3 = if s.selected then tone else Color3.new(1, 1, 1)
		grad.Enabled = not s.selected
		ring.ImageColor3 = if s.disabled then Color3.fromRGB(120, 110, 100) else Color3.new(1, 1, 1)
		Motion.tween(glow, { ImageTransparency = if s.disabled then 1 elseif s.hover or s.selected then 0.6 else 1 }, M.base)
		Motion.tween(press, { Scale = if s.pressed then 0.92 elseif s.hover and not s.disabled then 1.05 else 1 }, M.fast, nil, nil, "press")
		fr.Visible = s.focused and not s.disabled
	end, props.onClick)
	ctl:set({ disabled = props.disabled == true, selected = props.selected == true })

	return {
		Instance = root,
		controller = ctl,
		setBadge = function(_, n: number?)
			if badgeFrame and badge then
				badgeFrame.Visible = n ~= nil and n > 0
				badge.Text = tostring(n or 0)
			end
		end,
		force = function(_, p)
			ctl:force(p)
		end,
	}
end

---------------------------------------------------------------- Toggle
-- Rune switch with label. props: label, value, disabled, changed(value)
function Controls.toggle(scope: any, props: { [string]: any })
	local value = props.value == true
	local root = scope:add(Create("TextButton", {
		Name = "Toggle",
		Text = "",
		BackgroundTransparency = 1,
		Size = UDim2.new(if props.width then 0 else 1, props.width or 0, 0, 34),
		LayoutOrder = props.layoutOrder or 0,
	}))
	local labelColor = props.labelColor or C.text
	local label = Surface.text({ role = "body", text = props.label or "", color = labelColor, Position = UDim2.fromScale(0, 0.5), AnchorPoint = Vector2.new(0, 0.5), Parent = root })
	local track = Create("Frame", {
		Name = "Track",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		Size = UDim2.fromOffset(56, 26),
		BackgroundColor3 = C.void,
		Parent = root,
	}, { Create.corner(13), Create.stroke(C.goldDeep, 1.5, 0) })
	local fill = Create("Frame", { Name = "Fill", Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.arcaneDeep, BackgroundTransparency = 1, Parent = track }, { Create.corner(13) })
	local rune = Atlas.image("glyph", "sparkle", { Name = "Rune", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 9, 0.5, 0), Size = UDim2.fromOffset(12, 12), ImageColor3 = C.arcane, ImageTransparency = 1, ZIndex = 2, Parent = track })
	local knob = Create("Frame", {
		Name = "Knob",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(20, 20),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 3,
		Parent = track,
	}, { Create.corner(10), Create.gradient({ C.goldPale, C.gold, C.goldDeep }, 90), Create.stroke(C.void, 1.5, 0.1) })
	local fr = focusRing(track, 13, 3)
	local handle = {} :: any
	local ctl

	local function paint(s)
		local on = value
		Motion.tween(knob, { Position = UDim2.new(0, if on then 33 else 3, 0.5, 0) }, M.base, M.ease, nil, "slide")
		Motion.tween(fill, { BackgroundTransparency = if on then 0 else 1 }, M.base)
		Motion.tween(rune, { ImageTransparency = if on and not s.disabled then 0 else 1 }, M.base)
		track:FindFirstChildOfClass("UIStroke").Color = if s.disabled then C.seam elseif on or s.hover then C.arcane else C.goldDeep
		label.TextColor3 = if s.disabled then C.textGhost else labelColor
		knob.BackgroundTransparency = if s.disabled then 0.5 else 0
		fr.Visible = s.focused and not s.disabled
	end
	ctl = Interact.attach(root, scope, paint, function()
		handle:set(not value)
		if props.changed then
			props.changed(value)
		end
	end)
	ctl:set({ disabled = props.disabled == true })
	handle.Instance = root
	handle.controller = ctl
	function handle.set(_, v: boolean)
		value = v
		paint(ctl.state)
	end
	function handle.get()
		return value
	end
	return handle
end

---------------------------------------------------------------- Checkbox / Radio
-- props: label, value, radio (bool), group (shared table for radios), disabled, changed(value)
function Controls.checkbox(scope: any, props: { [string]: any })
	local value = props.value == true
	local radio = props.radio == true
	local root = scope:add(Create("TextButton", {
		Name = if radio then "Radio" else "Checkbox",
		Text = "",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(0, 28),
		AutomaticSize = Enum.AutomaticSize.X,
		LayoutOrder = props.layoutOrder or 0,
	}, { Create.list("x", 10, nil, Enum.VerticalAlignment.Center) }))
	local box = Create("Frame", {
		Name = "Box",
		Size = UDim2.fromOffset(22, 22),
		BackgroundColor3 = C.void,
		LayoutOrder = 1,
		Parent = root,
	}, { Create.corner(if radio then 11 else 4), Create.stroke(C.gold, 1.5, 0) })
	local mark: GuiObject
	if radio then
		mark = Create("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(10, 10), BackgroundColor3 = C.goldBright, Parent = box }, { Create.corner(5), Create.gradient({ C.goldPale, C.gold }, 90) })
	else
		mark = Atlas.image("glyph", "check", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(18, 18), ImageColor3 = C.goldBright, Parent = box })
	end
	local markScale = Create.scale(value and 1 or 0)
	markScale.Parent = mark
	local label = Surface.text({ role = "body", text = props.label or "", LayoutOrder = 2, Parent = root })
	local fr = focusRing(box, 4, 3)
	local handle = {} :: any
	local ctl
	local function paint(s)
		Motion.tween(markScale, { Scale = if value then 1 else 0 }, M.base, if value then M.spring else M.ease, nil, "mark")
		local st = box:FindFirstChildOfClass("UIStroke") :: UIStroke
		st.Color = if s.disabled then C.seam elseif s.hover or s.focused then C.goldBright else C.gold
		box.BackgroundColor3 = if value and not s.disabled then C.leather3 else C.void
		label.TextColor3 = if s.disabled then C.textGhost else C.text
		fr.Visible = s.focused and not s.disabled
	end
	ctl = Interact.attach(root, scope, paint, function()
		if radio then
			if value then
				return
			end
			if props.group then
				for _, other in props.group do
					if other ~= handle then
						other:set(false)
					end
				end
			end
			handle:set(true)
		else
			handle:set(not value)
		end
		if props.changed then
			props.changed(value)
		end
	end)
	ctl:set({ disabled = props.disabled == true })
	handle.Instance = root
	handle.controller = ctl
	function handle.set(_, v: boolean)
		value = v
		paint(ctl.state)
	end
	function handle.get()
		return value
	end
	if props.group then
		table.insert(props.group, handle)
	end
	return handle
end

---------------------------------------------------------------- Segmented
-- props: options {string}, index, width, disabled {[index]=true}, changed(index, option)
function Controls.segmented(scope: any, props: { [string]: any })
	local options = props.options
	local index = props.index or 1
	local h = props.height or 36
	local root = scope:add(Create("Frame", {
		Name = "Segmented",
		Size = UDim2.fromOffset(props.width or (#options * 96), h),
		BackgroundColor3 = C.void,
		LayoutOrder = props.layoutOrder or 0,
	}, { Create.corner(6), Create.stroke(C.goldDeep, 1.5, 0) }))
	local plate = Create("Frame", {
		Name = "Plate",
		Size = UDim2.new(1 / #options, -6, 1, -6),
		Position = UDim2.new((index - 1) / #options, 3, 0, 3),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = root,
	}, { Create.corner(4), Create.gradient({ C.goldPale, C.goldBright, C.gold }, 90), Create.stroke(C.void, 1, 0.2) })
	local row = Create.box({ Size = UDim2.fromScale(1, 1), ZIndex = 2, Parent = root }, { Create.list("x", 0) })
	local labels, ctls = {}, {}
	local handle = {} :: any
	local function paintAll()
		for i, l in labels do
			if not ctls[i] then
				continue
			end
			local s = ctls[i].state
			local dis = props.disabled and props.disabled[i]
			l.TextColor3 = if i == index then C.ink elseif dis then C.textGhost elseif s.hover or s.focused then C.goldPale else C.textSoft
		end
		Motion.tween(plate, { Position = UDim2.new((index - 1) / #options, 3, 0, 3) }, M.slow, M.ease, nil, "slide")
	end
	for i, opt in options do
		local b = Create("TextButton", { Name = "Option" .. i, Text = "", BackgroundTransparency = 1, Size = UDim2.new(1 / #options, 0, 1, 0), LayoutOrder = i, Parent = row })
		local l = Surface.text({ role = "label", text = opt, size = 14, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 3, Parent = b })
		local fr = Create("Frame", { Name = "Focus", BackgroundTransparency = 1, Size = UDim2.new(1, -2, 1, -2), Position = UDim2.fromOffset(1, 1), Visible = false, ZIndex = 4, Parent = b }, { Create.corner(5), Create.stroke(C.arcane, 2, 0) })
		labels[i] = l
		ctls[i] = Interact.attach(b, scope, function(s)
			fr.Visible = s.focused
			paintAll()
		end, function()
			if props.disabled and props.disabled[i] then
				return
			end
			handle:set(i)
			if props.changed then
				props.changed(i, opt)
			end
		end)
		if props.disabled and props.disabled[i] then
			ctls[i]:set({ disabled = true })
		end
	end
	handle.Instance = root
	function handle.set(_, i: number)
		index = i
		paintAll()
	end
	function handle.get()
		return index
	end
	paintAll()
	return handle
end

---------------------------------------------------------------- Tabs
-- Bookmark tabs. props: tabs { {text, icon?, badge?} }, index, changed(index), width (per tab)
function Controls.tabs(scope: any, props: { [string]: any })
	local index = props.index or 1
	local root = scope:add(Create.box({
		Name = "Tabs",
		Size = UDim2.new(1, 0, 0, 46),
		LayoutOrder = props.layoutOrder or 0,
	}, { Create.list("x", props.gap or 4, nil, Enum.VerticalAlignment.Bottom) }))
	local handle = {} :: any
	local items = {}
	local function paint()
		for i, it in items do
			if not it.ctl then
				continue
			end
			local s = it.ctl.state
			local active = i == index
			it.bg.ImageColor3 = if active then C.leather3 elseif s.hover then C.leather2 else C.leather1
			Motion.tween(it.btn, { Size = UDim2.fromOffset(it.w, if active then 46 else 40) }, M.base, M.ease, nil, "grow")
			it.label.TextColor3 = if active then C.goldBright elseif s.hover or s.focused then C.text else C.textFaint
			if it.icon then
				it.icon.ImageColor3 = it.label.TextColor3
			end
			it.edge.Visible = active
			it.fr.Visible = s.focused
		end
	end
	for i, t in props.tabs do
		local w = props.width or 132
		local btn = Create("TextButton", { Name = "Tab" .. i, Text = "", BackgroundTransparency = 1, Size = UDim2.fromOffset(w, 40), LayoutOrder = i, Parent = root })
		local bg = Atlas.image("chrome", "tab", { Name = "Bookmark", Size = UDim2.new(1, 0, 1, 8), SliceScale = 0.5, ImageColor3 = C.leather1, Parent = btn })
		local edge = Create("Frame", { Name = "Edge", BackgroundColor3 = C.gold, BorderSizePixel = 0, Size = UDim2.new(1, -8, 0, 2), Position = UDim2.fromOffset(4, 0), ZIndex = 3, Parent = btn })
		local row = Create.box({ Size = UDim2.new(1, 0, 1, 0), ZIndex = 2, Parent = btn }, { Create.list("x", 7, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center), Create.padding(4, 6, 0, 6) })
		local icon = if t.icon then Atlas.image("glyph", t.icon, { Size = UDim2.fromOffset(16, 16), LayoutOrder = 1, ZIndex = 3, Parent = row }) else nil
		local label = Surface.text({ role = "heading", text = t.text, size = 16, LayoutOrder = 2, ZIndex = 3, Parent = row })
		if t.badge then
			local b = Create("Frame", { Size = UDim2.fromOffset(18, 18), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = C.bad, LayoutOrder = 3, ZIndex = 3, Parent = row }, { Create.corner(9), Create.padding(0, 4, 0, 4) })
			Surface.text({ role = "tiny", text = tostring(t.badge), color = C.goldPale, Size = UDim2.fromScale(0, 1), AutomaticSize = Enum.AutomaticSize.X, ZIndex = 4, Parent = b })
		end
		local fr = Create("Frame", { Name = "Focus", BackgroundTransparency = 1, Size = UDim2.new(1, -4, 1, -2), Position = UDim2.fromOffset(2, 2), Visible = false, ZIndex = 5, Parent = btn }, { Create.corner(5), Create.stroke(C.arcane, 2, 0) })
		local it = { btn = btn, bg = bg, label = label, icon = icon, edge = edge, fr = fr, w = w } :: any
		items[i] = it
		it.ctl = Interact.attach(btn, scope, function()
			paint()
		end, function()
			if index ~= i then
				handle:set(i)
				if props.changed then
					props.changed(i)
				end
			end
		end)
	end
	handle.Instance = root
	function handle.set(_, i: number)
		index = i
		paint()
	end
	function handle.get()
		return index
	end
	paint()
	return handle
end

---------------------------------------------------------------- Slider
-- props: label, min, max, step, value, width, format(v) -> string, changed(v), disabled
function Controls.slider(scope: any, props: { [string]: any })
	local min, max, step = props.min or 0, props.max or 100, props.step or 1
	local value = math.clamp(props.value or min, min, max)
	local root = scope:add(Create("TextButton", {
		Name = "Slider",
		Text = "",
		BackgroundTransparency = 1,
		Size = UDim2.new(if props.width then 0 else 1, props.width or 0, 0, 52),
		LayoutOrder = props.layoutOrder or 0,
	}))
	local label = Surface.text({ role = "body", text = props.label or "", color = C.text, Parent = root })
	local readout = Surface.text({ role = "number", text = "", color = C.goldBright, AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Parent = root })
	local rail = Create.box({ Name = "Rail", Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 18), Parent = root })
	Atlas.image("chrome", "frame_bar", { Size = UDim2.fromScale(1, 1), SliceScale = 0.6, ZIndex = 3, Parent = rail })
	local well = Create("Frame", { Name = "Well", BackgroundColor3 = C.void, Position = UDim2.fromOffset(4, 4), Size = UDim2.new(1, -8, 1, -8), Parent = rail }, { Create.corner(3) })
	local fill = Atlas.image("chrome", "bar_fill", { Name = "Fill", SliceScale = 0.5, ImageColor3 = C.gold, Size = UDim2.fromScale(0, 1), ZIndex = 2, Parent = well })
	-- tick marks every quarter
	for q = 1, 3 do
		Create("Frame", { BackgroundColor3 = C.goldDeep, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(q / 4, 0, 1, 4), Size = UDim2.fromOffset(1, 4), Parent = rail })
	end
	local knob = Atlas.image("chrome", "gem", {
		Name = "Knob",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(26, 26),
		ImageColor3 = C.goldBright,
		ZIndex = 5,
		Parent = rail,
	})
	local knobGlow = Atlas.image("chrome", "glow", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(2.2, 2.2), ImageColor3 = C.arcane, ImageTransparency = 1, ZIndex = 4, Parent = knob })
	local handle = {} :: any
	local ctl
	local dragging = false

	local function text(v: number)
		return if props.format then props.format(v) else tostring(v)
	end
	local function paint(s)
		local t = (value - min) / (max - min)
		fill.Size = UDim2.fromScale(t, 1)
		knob.Position = UDim2.fromScale(t, 0.5)
		readout.Text = text(value)
		local dis = s.disabled
		fill.ImageColor3 = if dis then C.seam else C.gold
		knob.ImageColor3 = if dis then C.textGhost elseif s.focused or dragging then C.arcane else C.goldBright
		knobGlow.ImageTransparency = if (s.focused or s.hover or dragging) and not dis then 0.55 else 1
		label.TextColor3 = if dis then C.textGhost else C.text
		readout.TextColor3 = if dis then C.textGhost else C.goldBright
	end
	local function setValue(v: number, fire: boolean)
		v = math.clamp(math.floor((v - min) / step + 0.5) * step + min, min, max)
		if v ~= value then
			value = v
			paint(ctl.state)
			if fire and props.changed then
				props.changed(value)
			end
		end
	end
	local function fromX(x: number)
		local a, w = rail.AbsolutePosition.X, rail.AbsoluteSize.X
		setValue(min + math.clamp((x - a) / w, 0, 1) * (max - min), true)
	end
	ctl = Interact.attach(root, scope, paint)
	scope:connect(root.InputBegan, function(input)
		if ctl.state.disabled then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			fromX(input.Position.X)
		end
	end)
	scope:connect(UserInputService.InputChanged, function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			fromX(input.Position.X)
		end
	end)
	scope:connect(UserInputService.InputEnded, function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
			paint(ctl.state)
		end
	end)
	-- keyboard: left/right step, shift = 10 steps (when focused, arrows are taken from UI navigation)
	scope:connect(UserInputService.InputBegan, function(input)
		if GuiService.SelectedObject ~= root or ctl.state.disabled then
			return
		end
		local mult = if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then 10 else 1
		if input.KeyCode == Enum.KeyCode.Right or input.KeyCode == Enum.KeyCode.D then
			setValue(value + step * mult, true)
		elseif input.KeyCode == Enum.KeyCode.Left or input.KeyCode == Enum.KeyCode.A then
			setValue(value - step * mult, true)
		end
	end)
	-- Left/Right must adjust the value, not move UI selection
	root.NextSelectionLeft = root
	root.NextSelectionRight = root
	ctl:set({ disabled = props.disabled == true })
	handle.Instance = root
	handle.controller = ctl
	function handle.set(_, v: number)
		setValue(v, false)
	end
	function handle.get()
		return value
	end
	paint(ctl.state)
	return handle
end

---------------------------------------------------------------- Dropdown
-- props: options { {text, icon?} | string }, index, width, label (placeholder), changed(index)
function Controls.dropdown(scope: any, props: { [string]: any })
	local options = {}
	for i, o in props.options do
		options[i] = if type(o) == "string" then { text = o } else o
	end
	local index = props.index
	local width = props.width or 220
	local root = scope:add(Create("TextButton", {
		Name = "Dropdown",
		Text = "",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromOffset(width, Theme.size.control),
		LayoutOrder = props.layoutOrder or 0,
	}, { Create.corner(6), Create.gradient({ C.leather2, C.leather1 }, 90), Create.stroke(C.goldDeep, 1.5, 0) }))
	local value = Surface.text({ role = "body", text = "", Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -48, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, Parent = root })
	local chev = Atlas.image("glyph", "chevron_down", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(16, 16), ImageColor3 = C.gold, Parent = root })
	local fr = focusRing(root, 6, 3)
	local handle = {} :: any
	local menuScope: any = nil
	local open = false
	local ctl

	local function paint(s)
		local stroke = root:FindFirstChildOfClass("UIStroke") :: UIStroke
		stroke.Color = if s.disabled then C.seam elseif open or s.hover or s.focused then C.gold else C.goldDeep
		value.Text = if index then options[index].text else (props.label or "Choose…")
		value.TextColor3 = if s.disabled then C.textGhost elseif index then C.text else C.textFaint
		Motion.tween(chev, { Rotation = if open then 180 else 0 }, M.base, nil, nil, "chev")
		fr.Visible = s.focused and not open
	end

	local function close(refocus: boolean?)
		if menuScope then
			menuScope:Destroy()
			menuScope = nil
		end
		open = false
		paint(ctl.state)
		if refocus and GuiService.SelectedObject == nil then
			pcall(function()
				GuiService.SelectedObject = root
			end)
		end
	end

	local function openMenu()
		if open then
			close()
			return
		end
		open = true
		menuScope = scope:child()
		local overlay = Layers.get()
		-- click-away catcher
		local catcher = menuScope:add(Create("TextButton", { Name = "DropdownCatcher", Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = Theme.z.popover, Parent = overlay }))
		menuScope:connect(catcher.Activated, function()
			close()
		end)
		local pos, size = Layers.rectOf(root)
		local itemH = 36
		local h = #options * itemH + 12
		local at = Layers.place(pos, size, Vector2.new(size.X, h), "below", 4)
		local menu = menuScope:add(Create("Frame", {
			Name = "DropdownMenu",
			Position = UDim2.fromOffset(at.X, at.Y),
			Size = UDim2.fromOffset(size.X, h),
			BackgroundColor3 = C.leather1,
			ZIndex = Theme.z.popover + 1,
			Parent = overlay,
		}, { Create.corner(6), Create.stroke(C.gold, 1.5, 0), Create.padding(6), Create.list("y", 0) }))
		local appear = Create.scale(0.96)
		appear.Parent = menu
		Motion.tween(appear, { Scale = 1 }, M.base, M.spring)
		local first: GuiObject? = nil
		for i, o in options do
			local b = Create("TextButton", { Name = "Item" .. i, Text = "", BackgroundColor3 = C.leather3, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, itemH), LayoutOrder = i, ZIndex = Theme.z.popover + 2, Parent = menu }, { Create.corner(4) })
			local row = Create.box({ Size = UDim2.fromScale(1, 1), ZIndex = Theme.z.popover + 3, Parent = b }, { Create.list("x", 8, nil, Enum.VerticalAlignment.Center), Create.padding(0, 10, 0, 10) })
			if o.icon then
				Atlas.image("glyph", o.icon, { Size = UDim2.fromOffset(16, 16), ImageColor3 = C.gold, LayoutOrder = 1, ZIndex = Theme.z.popover + 3, Parent = row })
			end
			local t = Surface.text({ role = "body", text = o.text, LayoutOrder = 2, ZIndex = Theme.z.popover + 3, Parent = row })
			if i == index then
				Atlas.image("glyph", "check", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(14, 14), ImageColor3 = C.arcane, ZIndex = Theme.z.popover + 3, Parent = b })
				t.TextColor3 = C.goldBright
			end
			Interact.attach(b, menuScope, function(s)
				b.BackgroundTransparency = if s.hover or s.focused then 0 else 1
			end, function()
				index = i
				close(true)
				if props.changed then
					props.changed(i, o)
				end
			end)
			if i == (index or 1) then
				first = b
			end
		end
		-- keyboard: focus the current item; Backspace/Escape closes
		if GuiService.SelectedObject ~= nil and first then
			GuiService.SelectedObject = first
		end
		menuScope:connect(UserInputService.InputBegan, function(input)
			if input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.Escape then
				close(true)
			end
		end)
		paint(ctl.state)
	end

	ctl = Interact.attach(root, scope, paint, openMenu)
	ctl:set({ disabled = props.disabled == true })
	handle.Instance = root
	handle.controller = ctl
	function handle.set(_, i: number?)
		index = i
		paint(ctl.state)
	end
	function handle.get()
		return index
	end
	function handle.open()
		if not open then
			openMenu()
		end
	end
	handle.close = function()
		close()
	end
	return handle
end

---------------------------------------------------------------- SearchBox
-- props: placeholder, width, changed(text)
function Controls.search(scope: any, props: { [string]: any })
	local root = scope:add(Create("Frame", {
		Name = "Search",
		Size = UDim2.new(if props.width then 0 else 1, props.width or 0, 0, Theme.size.control),
		BackgroundColor3 = C.void,
		LayoutOrder = props.layoutOrder or 0,
	}, { Create.corner(6), Create.stroke(C.goldDeep, 1.5, 0) }))
	Atlas.image("glyph", "search", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 12, 0.5, 0), Size = UDim2.fromOffset(16, 16), ImageColor3 = C.gold, Parent = root })
	local box = Create("TextBox", {
		Name = "Input",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(36, 0),
		Size = UDim2.new(1, -70, 1, 0),
		FontFace = Theme.font.body,
		TextSize = 15,
		TextColor3 = C.text,
		PlaceholderText = props.placeholder or "Search…",
		PlaceholderColor3 = C.textFaint,
		Text = "",
		ClearTextOnFocus = false,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = root,
	})
	local clear = Create("ImageButton", { Name = "Clear", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(20, 20), BackgroundTransparency = 1, Image = "", Visible = false, Parent = root })
	local cg = Atlas.image("glyph", "close", { Size = UDim2.fromScale(1, 1), ImageColor3 = C.textSoft, Parent = clear })
	local stroke = root:FindFirstChildOfClass("UIStroke") :: UIStroke
	scope:connect(box.Focused, function()
		stroke.Color = C.arcane
	end)
	scope:connect(box.FocusLost, function()
		stroke.Color = C.goldDeep
	end)
	scope:connect(box:GetPropertyChangedSignal("Text"), function()
		clear.Visible = box.Text ~= ""
		if props.changed then
			props.changed(box.Text)
		end
	end)
	scope:connect(clear.MouseEnter, function()
		cg.ImageColor3 = C.goldBright
	end)
	scope:connect(clear.MouseLeave, function()
		cg.ImageColor3 = C.textSoft
	end)
	scope:connect(clear.Activated, function()
		box.Text = ""
	end)
	return {
		Instance = root,
		box = box,
		set = function(_, t: string)
			box.Text = t
		end,
		get = function()
			return box.Text
		end,
	}
end

return Controls
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">Feedback</string><ProtectedString name="Source"><![CDATA[--!strict
-- Feedback & overlays: Tooltip, ContextMenu, Modal, Toast, ProgressBar, Radial (ring / cooldown sweep),
-- Tag, Spinner and Currency. Overlay pieces render into Layers, so they work inside any host.
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local RunService = game:GetService("RunService")

local Theme = require(script.Parent.Parent.Theme)
local Atlas = require(script.Parent.Parent.Atlas)
local Create = require(script.Parent.Parent.Core.Create)
local Motion = require(script.Parent.Parent.Core.Motion)
local Interact = require(script.Parent.Parent.Core.Interact)
local Layers = require(script.Parent.Parent.Core.Layers)
local Surface = require(script.Parent.Surface)
local Button = require(script.Parent.Button)

local C = Theme.color
local M = Theme.motion
local Z = Theme.z
local Feedback = {}

-- Overlay coordination: open menus and dialogs suppress hover tooltips, and hide any that are showing.
local liveTips: { [() -> ()]: boolean } = {}
local suppress = 0
function Feedback.hideTooltips()
	for hide in liveTips do
		hide()
	end
end
local function holdTooltips(scope: any)
	suppress += 1
	Feedback.hideTooltips()
	scope:defer(function()
		suppress -= 1
	end)
end

---------------------------------------------------------------- Tooltip
-- A dark card with a thin gilt frame. props: title, body, hint, width, accent
function Feedback.tooltipCard(props: { [string]: any }): Frame
	-- root: auto height; fill inset under a thin gilt frame that sits on the bounds (no overhang)
	local card = Create.box({ Name = "Tooltip", Size = UDim2.fromOffset(props.width or 240, 0), AutomaticSize = Enum.AutomaticSize.Y })
	Create("Frame", {
		Name = "Fill",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Parent = card,
	}, { Create.corner(7), Create.gradient({ C.leather2, C.leather0 }, 90) })
	Atlas.image("chrome", "frame_thin", { Name = "Frame", Size = UDim2.fromScale(1, 1), SliceScale = 0.6, ZIndex = 3, Parent = card })
	local body = Create.box({ Name = "Body", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 2, Parent = card }, {
		Create.padding(13, 15, 13, 15),
		Create.list("y", 6),
	})
	if props.title then
		Surface.text({ role = "heading", text = props.title, color = props.accent or C.goldBright, size = 17, LayoutOrder = 1, ZIndex = 2, Parent = body, wrap = true })
	end
	if props.body then
		Surface.text({ role = "small", text = props.body, color = C.textSoft, LayoutOrder = 2, ZIndex = 2, Parent = body, wrap = true, rich = true })
	end
	if props.hint then
		Surface.text({ role = "lore", text = props.hint, color = C.textFaint, size = 12, LayoutOrder = 3, ZIndex = 2, Parent = body, wrap = true })
	end
	return card
end

-- Attach a hover / focus tooltip to `target`. build() returns the card (built fresh on each show).
-- opts: side ("right" default), delay (s)
function Feedback.tooltip(scope: any, target: GuiObject, build: () -> GuiObject, opts: { [string]: any }?)
	local o = opts or {}
	local showing: any = nil
	local pending: thread? = nil
	local function hide()
		if pending then
			pcall(task.cancel, pending)
			pending = nil
		end
		if showing then
			showing:Destroy()
			showing = nil
		end
	end
	local function show()
		hide()
		if suppress > 0 then
			return
		end
		local s = scope:child()
		showing = s
		local card = build()
		card.Visible = false
		card.ZIndex = Z.tooltip
		card.Parent = Layers.get()
		s:add(card)
		-- raise every descendant above popovers
		for _, d in card:GetDescendants() do
			if d:IsA("GuiObject") then
				d.ZIndex += Z.tooltip
			end
		end
		task.defer(function()
			if showing ~= s or not card.Parent then
				return
			end
			local pos, size = Layers.rectOf(target)
			local cs = card.AbsoluteSize / Layers.scale()
			local at = Layers.place(pos, size, cs, o.side or "right", 10)
			card.Position = UDim2.fromOffset(at.X, at.Y + 4)
			card.Visible = true
			Motion.tween(card, { Position = UDim2.fromOffset(at.X, at.Y) }, M.base)
		end)
	end
	local function queue()
		if pending then
			return
		end
		pending = task.delay(o.delay or 0.18, function()
			pending = nil
			show()
		end)
	end
	scope:connect(target.MouseEnter, queue)
	scope:connect(target.MouseLeave, hide)
	scope:connect(target.SelectionGained, queue)
	scope:connect(target.SelectionLost, hide)
	liveTips[hide] = true
	scope:defer(function()
		liveTips[hide] = nil
		hide()
	end)
	return { show = show, hide = hide }
end

---------------------------------------------------------------- ContextMenu
-- items: { {text, icon?, danger?, disabled?, hint?, run?} | "-" }. at: overlay-local position.
function Feedback.contextMenu(scope: any, at: Vector2, items: { any }, title: string?)
	local s = scope:child()
	holdTooltips(s)
	local overlay = Layers.get()
	local catcher = s:add(Create("TextButton", { Name = "MenuCatcher", Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = Z.popover, Parent = overlay }))
	local w = 210
	local menu = s:add(Create("Frame", {
		Name = "ContextMenu",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromOffset(w, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Visible = false,
		ZIndex = Z.popover + 1,
		Parent = overlay,
	}, { Create.corner(6), Create.gradient({ C.leather2, C.leather1 }, 90), Create.stroke(C.gold, 1.5, 0), Create.padding(6), Create.list("y", 2) }))
	local function close()
		s:Destroy()
	end
	s:connect(catcher.Activated, close)
	s:connect(catcher.MouseButton2Click, close)
	if title then
		Surface.text({ role = "caps", text = title, color = C.gold, Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 0, ZIndex = Z.popover + 2, Parent = menu }, nil)
		local t = menu:FindFirstChildOfClass("TextLabel") :: TextLabel
		Create.padding(0, 0, 0, 8).Parent = t
	end
	local first: GuiObject? = nil
	for i, it in items do
		if it == "-" then
			Create("Frame", { BackgroundColor3 = C.seam, BorderSizePixel = 0, Size = UDim2.new(1, -12, 0, 1), LayoutOrder = i, ZIndex = Z.popover + 2, Parent = menu })
			continue
		end
		local b = Create("TextButton", { Name = "Item_" .. it.text, Text = "", BackgroundColor3 = if it.danger then C.healthDeep else C.leather3, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 32), LayoutOrder = i, ZIndex = Z.popover + 2, Parent = menu }, { Create.corner(4) })
		local row = Create.box({ Size = UDim2.fromScale(1, 1), ZIndex = Z.popover + 3, Parent = b }, { Create.list("x", 9, nil, Enum.VerticalAlignment.Center), Create.padding(0, 8, 0, 8) })
		local col = if it.disabled then C.textGhost elseif it.danger then C.bad else C.text
		local ic = Atlas.image("glyph", it.icon or "chevron_right", { Size = UDim2.fromOffset(16, 16), ImageColor3 = if it.disabled then C.textGhost elseif it.danger then C.bad else C.gold, LayoutOrder = 1, ZIndex = Z.popover + 3, Parent = row })
		local t = Surface.text({ role = "body", text = it.text, color = col, size = 14, LayoutOrder = 2, ZIndex = Z.popover + 3, Parent = row })
		if it.hint then
			Surface.text({ role = "tiny", text = it.hint, color = C.textFaint, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), ZIndex = Z.popover + 3, Parent = b })
		end
		Interact.attach(b, s, function(st)
			b.BackgroundTransparency = if not it.disabled and (st.hover or st.focused) then 0 else 1
			t.TextColor3 = if not it.disabled and (st.hover or st.focused) and not it.danger then C.goldPale else col
			local _ = ic
		end, function()
			if it.disabled then
				return
			end
			close()
			if it.run then
				it.run()
			end
		end)
		if not first and not it.disabled then
			first = b
		end
	end
	s:connect(UserInputService.InputBegan, function(input)
		if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
			close()
		end
	end)
	task.defer(function()
		if not menu.Parent then
			return
		end
		local size = menu.AbsoluteSize / Layers.scale()
		local area = Layers.size()
		local x = math.clamp(at.X, 4, area.X - size.X - 4)
		local y = if at.Y + size.Y > area.Y - 4 then at.Y - size.Y else at.Y
		menu.Position = UDim2.fromOffset(x, math.max(4, y))
		menu.Visible = true
		local sc = Create.scale(0.94)
		sc.Parent = menu
		Motion.tween(sc, { Scale = 1 }, M.base, M.spring)
		if GuiService.SelectedObject ~= nil and first then
			GuiService.SelectedObject = first
		end
	end)
	return { close = close, Instance = menu }
end

---------------------------------------------------------------- Modal
-- props: title, body (string), icon (item icon name), tone ("gold" | "danger" | "arcane"),
-- confirm {text, variant}, cancel {text}, onConfirm, onCancel, width, extra (builder fn(parent))
function Feedback.modal(scope: any, props: { [string]: any })
	local s = scope:child()
	holdTooltips(s)
	local overlay = Layers.get()
	local dim = s:add(Create("TextButton", {
		Name = "ModalDim",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = C.void,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = Z.modal,
		Parent = overlay,
	}))
	Motion.tween(dim, { BackgroundTransparency = 0.35 }, M.slow)
	local width = props.width or 420
	local panel, content = Surface.panel({ title = props.title, size = UDim2.fromOffset(width, 0), autoSize = Enum.AutomaticSize.Y, padding = 22, parent = overlay })
	panel.Name = "Modal"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	s:add(panel)
	for _, d in panel:GetDescendants() do
		if d:IsA("GuiObject") then
			d.ZIndex += Z.modal
		end
	end
	panel.ZIndex = Z.modal + 1
	Create.list("y", 14, Enum.HorizontalAlignment.Center).Parent = content
	local appear = Create.scale(0.9)
	appear.Parent = panel
	Motion.tween(appear, { Scale = 1 }, M.slow, M.spring)

	if props.icon then
		local medal = Create.box({ Size = UDim2.fromOffset(84, 84), LayoutOrder = 1, ZIndex = Z.modal + 3, Parent = content })
		Atlas.image("chrome", "glow", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1.6, 1.6), ImageColor3 = props.glow or C.goldBright, ImageTransparency = 0.6, ZIndex = Z.modal + 3, Parent = medal })
		Atlas.image("chrome", "disc", { Size = UDim2.fromScale(0.86, 0.86), Position = UDim2.fromScale(0.07, 0.07), ImageColor3 = C.leather0, ZIndex = Z.modal + 4, Parent = medal })
		Atlas.image("icon", props.icon, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.7, 0.7), ZIndex = Z.modal + 5, Parent = medal })
		Atlas.image("chrome", "medallion", { Size = UDim2.fromScale(1, 1), ZIndex = Z.modal + 6, Parent = medal })
	end
	if props.body then
		local t = Surface.text({ role = "body", text = props.body, color = C.textSoft, rich = true, wrap = true, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 2, ZIndex = Z.modal + 3, Parent = content })
		t.LineHeight = 1.15
	end
	if props.extra then
		local holder = Create.box({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, ZIndex = Z.modal + 3, Parent = content })
		props.extra(holder, s)
		for _, d in holder:GetDescendants() do
			if d:IsA("GuiObject") and d.ZIndex < Z.modal then
				d.ZIndex += Z.modal + 3
			end
		end
	end
	local actions = Create.box({ Size = UDim2.new(1, 0, 0, Theme.size.control), LayoutOrder = 4, ZIndex = Z.modal + 3, Parent = content }, { Create.list("x", 12, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center) })
	Surface.divider({ LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 14), Parent = content })

	local closed = false
	local handle = {} :: any
	local function close(confirmed: boolean)
		if closed then
			return
		end
		closed = true
		Motion.tween(appear, { Scale = 0.94 }, M.base)
		Motion.tween(dim, { BackgroundTransparency = 1 }, M.base)
		task.delay(M.base, function()
			s:Destroy()
		end)
		if confirmed and props.onConfirm then
			props.onConfirm()
		elseif not confirmed and props.onCancel then
			props.onCancel()
		end
	end
	local cancelBtn, confirmBtn
	if props.cancel ~= false then
		cancelBtn = Button.new(s, { text = (props.cancel and props.cancel.text) or "Cancel", variant = "secondary", width = 150, keyHint = "Esc", layoutOrder = 1, onClick = function()
			close(false)
		end })
		cancelBtn.Instance.Parent = actions
	end
	confirmBtn = Button.new(s, { text = (props.confirm and props.confirm.text) or "Confirm", variant = (props.confirm and props.confirm.variant) or "primary", width = 170, keyHint = "Enter", disabled = props.confirm and props.confirm.disabled, layoutOrder = 2, onClick = function()
		close(true)
	end })
	confirmBtn.Instance.Parent = actions
	for _, b in { cancelBtn, confirmBtn } do
		if b then
			for _, d in b.Instance:GetDescendants() do
				if d:IsA("GuiObject") then
					d.ZIndex += Z.modal + 3
				end
			end
			b.Instance.ZIndex += Z.modal + 3
		end
	end
	-- focus trap: keyboard focus starts on the safe choice for danger dialogs, otherwise on confirm,
	-- and can only move between the dialog's buttons
	local safe = if props.tone == "danger" and cancelBtn then cancelBtn else confirmBtn
	if cancelBtn then
		cancelBtn.Instance.NextSelectionRight = confirmBtn.Instance
		cancelBtn.Instance.NextSelectionLeft = confirmBtn.Instance
		confirmBtn.Instance.NextSelectionLeft = cancelBtn.Instance
		confirmBtn.Instance.NextSelectionRight = cancelBtn.Instance
		for _, b in { cancelBtn, confirmBtn } do
			b.Instance.NextSelectionUp = b.Instance
			b.Instance.NextSelectionDown = b.Instance
		end
	end
	if GuiService.SelectedObject ~= nil or props.focus then
		task.defer(function()
			pcall(function()
				GuiService.SelectedObject = safe.Instance
			end)
		end)
	end
	s:connect(UserInputService.InputBegan, function(input)
		if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
			close(false)
		elseif (input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.KeypadEnter)
			and GuiService.SelectedObject == nil
			and not UserInputService:GetFocusedTextBox()
			and not confirmBtn.controller.state.disabled
		then
			-- Enter confirms when nothing has keyboard focus (with focus, the focused button handles it)
			close(true)
		end
	end)
	handle.close = close
	handle.Instance = panel
	handle.confirm = confirmBtn
	handle.cancel = cancelBtn
	return handle
end

---------------------------------------------------------------- Toast
-- Stacked notifications in the overlay's top-right. props: tone, title, text, icon (item icon) or glyph, duration
local TONES = {
	info = { color = C.info, glyph = "info" },
	success = { color = C.good, glyph = "check" },
	warning = { color = C.warn, glyph = "bell" },
	error = { color = C.bad, glyph = "close" },
	reward = { color = C.goldBright, glyph = "sparkle" },
	quest = { color = C.arcane, glyph = "quest" },
}
Feedback.TONES = TONES

function Feedback.toastCard(props: { [string]: any }): Frame
	local tone = TONES[props.tone or "info"]
	local card = Create("Frame", {
		Name = "Toast",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromOffset(props.width or 320, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	}, { Create.corner(6), Create.gradient({ C.leather2, C.leather1 }, 90), Create.stroke(C.void, 2, 0.2) })
	Create("Frame", { Name = "Accent", BackgroundColor3 = tone.color, BorderSizePixel = 0, Size = UDim2.new(0, 4, 1, 0), Parent = card }, { Create.corner(2) })
	local body = Create.box({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = card }, { Create.padding(12, 14, 12, 64), Create.list("y", 3) })
	local badge = Create.box({ Name = "Badge", Size = UDim2.fromOffset(38, 38), Position = UDim2.fromOffset(18, 10), Parent = card })
	if props.icon then
		Atlas.image("chrome", "disc", { Size = UDim2.fromScale(1, 1), ImageColor3 = C.leather0, Parent = badge })
		Atlas.image("icon", props.icon, { Size = UDim2.fromScale(0.86, 0.86), Position = UDim2.fromScale(0.07, 0.07), ZIndex = 2, Parent = badge })
		Atlas.image("chrome", "ring_thin", { Size = UDim2.fromScale(1, 1), ImageColor3 = tone.color, ZIndex = 3, Parent = badge })
	else
		Atlas.image("chrome", "disc", { Size = UDim2.fromScale(1, 1), ImageColor3 = tone.color, ImageTransparency = 0.82, Parent = badge })
		Atlas.image("chrome", "ring_thin", { Size = UDim2.fromScale(1, 1), ImageColor3 = tone.color, ZIndex = 2, Parent = badge })
		Atlas.image("glyph", props.glyph or tone.glyph, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.5, 0.5), ImageColor3 = tone.color, ZIndex = 3, Parent = badge })
	end
	if props.title then
		Surface.text({ role = "label", text = props.title, color = tone.color, size = 15, wrap = true, LayoutOrder = 1, Parent = body })
	end
	if props.text then
		Surface.text({ role = "small", text = props.text, color = C.textSoft, wrap = true, rich = true, LayoutOrder = 2, Parent = body })
	end
	local timer = Create("Frame", { Name = "Timer", BackgroundColor3 = tone.color, BackgroundTransparency = 0.4, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 6, 1, 0), Size = UDim2.new(1, -12, 0, 2), Visible = false, Parent = card })
	local _ = timer
	return card
end

local stackFrame: Frame? = nil
function Feedback.toast(scope: any, props: { [string]: any })
	local overlay = Layers.get()
	if not stackFrame or stackFrame.Parent ~= overlay then
		stackFrame = Create.box({
			Name = "ToastStack",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -16, 0, 16),
			Size = UDim2.fromOffset(props.width or 320, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			ZIndex = Z.toast,
			Parent = overlay,
		}, { Create.list("y", 10, Enum.HorizontalAlignment.Right) })
		scope:add(stackFrame)
	end
	local stack = stackFrame :: Frame
	local s = scope:child()
	-- keep at most 4: drop the oldest
	local cards = {}
	for _, c in stack:GetChildren() do
		if c:IsA("Frame") then
			table.insert(cards, c)
		end
	end
	if #cards >= 4 then
		table.sort(cards, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		cards[1]:Destroy()
	end
	local holder = s:add(Create.box({ Name = "ToastSlot", Size = UDim2.fromOffset(props.width or 320, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = os.clock() * 1000 // 1, Parent = stack }))
	local card = Feedback.toastCard(props)
	card.Position = UDim2.fromOffset(40, 0)
	card.Parent = holder
	for _, d in holder:GetDescendants() do
		if d:IsA("GuiObject") then
			d.ZIndex += Z.toast
		end
	end
	Motion.tween(card, { Position = UDim2.fromOffset(0, 0) }, M.slow, M.spring)
	local timer = card:FindFirstChild("Timer") :: Frame
	local duration = props.duration or 4
	if duration > 0 then
		timer.Visible = true
		Motion.tween(timer, { Size = UDim2.new(0, 0, 0, 2) }, duration, Enum.EasingStyle.Linear)
		s:delay(duration, function()
			Motion.tween(card, { Position = UDim2.fromOffset(60, 0) }, M.base)
			task.wait(M.base)
			s:Destroy()
		end)
	end
	return { close = function()
		s:Destroy()
	end }
end

---------------------------------------------------------------- ProgressBar
-- props: value, max, color, deep, width, height, label, showValue, segments, glyph, format(v, max)
-- set(v) animates; drops leave a pale trail that drains after a beat (damage), gains flash the edge.
function Feedback.bar(scope: any, props: { [string]: any })
	local max = props.max or 100
	local value = math.clamp(props.value or max, 0, max)
	local h = props.height or 18
	local root = scope:add(Create.box({
		Name = "Bar",
		Size = UDim2.new(if props.width then 0 else 1, props.width or 0, 0, h + (if props.label then 22 else 0)),
		LayoutOrder = props.layoutOrder or 0,
	}))
	local top = 0
	local readout: TextLabel? = nil
	if props.label then
		local lab = Create.box({ Size = UDim2.new(1, 0, 0, 18), Parent = root })
		local x = 0
		if props.glyph then
			Atlas.image("glyph", props.glyph, { Size = UDim2.fromOffset(14, 14), Position = UDim2.fromOffset(0, 2), ImageColor3 = props.color, Parent = lab })
			x = 20
		end
		Surface.text({ role = "caps", text = props.label, color = C.textSoft, Position = UDim2.fromOffset(x, 0), Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, Parent = lab })
		readout = Surface.text({ role = "number", text = "", color = C.text, size = 13, AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, Parent = lab })
		top = 22
	end
	local rail = Create.box({ Name = "Rail", Position = UDim2.fromOffset(0, top), Size = UDim2.new(1, 0, 0, h), Parent = root })
	Atlas.image("chrome", "frame_bar", { Size = UDim2.new(1, 0, 1, 0), SliceScale = math.min(0.75, h / 30), ZIndex = 5, Parent = rail })
	local inset = math.max(3, math.floor(h * 0.2))
	local well = Create("Frame", { Name = "Well", BackgroundColor3 = props.deep or C.void, Position = UDim2.fromOffset(inset, inset), Size = UDim2.new(1, -inset * 2, 1, -inset * 2), ClipsDescendants = true, Parent = rail }, { Create.corner(2) })
	Create("Frame", { BackgroundColor3 = C.void, BackgroundTransparency = 0.45, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Parent = well })
	local trail = Create("Frame", { Name = "Trail", BackgroundColor3 = C.goldPale, BackgroundTransparency = 0.25, BorderSizePixel = 0, Size = UDim2.fromScale(value / max, 1), ZIndex = 2, Parent = well }, { Create.corner(2) })
	local fill = Atlas.image("chrome", "bar_fill", { Name = "Fill", ImageColor3 = props.color or C.gold, SliceScale = 0.4, Size = UDim2.fromScale(value / max, 1), ZIndex = 3, Parent = well })
	local edge = Create("Frame", { Name = "Edge", BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0, 6, 1, 0), ZIndex = 4, Parent = fill })
	if props.segments then
		for i = 1, props.segments - 1 do
			Create("Frame", { BackgroundColor3 = C.void, BackgroundTransparency = 0.25, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(i / props.segments, 0), Size = UDim2.new(0, 2, 1, 0), ZIndex = 4, Parent = well })
		end
	end
	local function txt(v: number)
		if readout then
			readout.Text = if props.format then props.format(v, max) else `{math.floor(v + 0.5)} / {max}`
		end
	end
	txt(value)
	local handle = {} :: any
	local cancelCount: (() -> ())? = nil
	function handle.set(_, v: number, instant: boolean?)
		v = math.clamp(v, 0, max)
		local from = value
		value = v
		local t = v / max
		if instant or Motion.reduced then
			fill.Size = UDim2.fromScale(t, 1)
			trail.Size = UDim2.fromScale(t, 1)
			txt(v)
			return
		end
		if cancelCount then
			cancelCount()
		end
		cancelCount = Motion.number(from, v, M.slow, txt)
		if v < from then
			-- damage: fill snaps, the pale trail lingers then drains
			Motion.tween(fill, { Size = UDim2.fromScale(t, 1) }, M.fast, nil, nil, "fill")
			trail.BackgroundColor3 = C.goldPale
			scope:add(task.delay(0.35, function()
				Motion.tween(trail, { Size = UDim2.fromScale(t, 1) }, 0.5, Enum.EasingStyle.Quad, nil, "trail")
			end))
		else
			-- gain: trail leads, fill catches up, the edge flashes
			trail.Size = UDim2.fromScale(t, 1)
			trail.BackgroundColor3 = props.color or C.gold
			Motion.tween(fill, { Size = UDim2.fromScale(t, 1) }, M.slow, nil, nil, "fill")
			edge.BackgroundTransparency = 0.2
			Motion.tween(edge, { BackgroundTransparency = 1 }, 0.6, nil, nil, "edge")
		end
	end
	function handle.get()
		return value
	end
	function handle.setMax(_, m: number)
		max = m
		handle:set(math.min(value, m), true)
	end
	handle.Instance = root
	return handle
end

---------------------------------------------------------------- Radial
-- Clockwise sweep from 12 o'clock built from two clipped halves of a sprite with a hard-edged
-- UIGradient. Used for progress rings (sprite "ring") and cooldown shades (sprite "disc").
function Feedback.radial(scope: any, props: { [string]: any })
	local size = props.size or 64
	local root = scope:add(Create.box({ Name = "Radial", Size = UDim2.fromOffset(size, size), LayoutOrder = props.layoutOrder or 0 }))
	local sprite = props.sprite or "ring"
	if props.track ~= false then
		Atlas.image("chrome", sprite, { Name = "Track", Size = UDim2.fromScale(1, 1), ImageColor3 = props.trackColor or C.void, ImageTransparency = props.trackTransparency or 0.3, Parent = root })
	end
	local halves = {}
	for i, side in { "Right", "Left" } do
		local clip = Create.box({ Name = side, ClipsDescendants = true, Size = UDim2.fromScale(0.5, 1), Position = UDim2.fromScale(if side == "Right" then 0.5 else 0, 0), ZIndex = 2, Parent = root })
		local img = Atlas.image("chrome", sprite, {
			Size = UDim2.fromScale(2, 1),
			Position = UDim2.fromScale(if side == "Right" then -1 else 0, 0),
			ImageColor3 = props.color or C.gold,
			ImageTransparency = props.transparency or 0,
			ZIndex = 2,
			Parent = clip,
		})
		local g = Create("UIGradient", {
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(0.5001, 1), NumberSequenceKeypoint.new(1, 1) }),
			Parent = img,
		})
		halves[i] = { clip = clip, img = img, g = g }
	end
	local value = 0
	local handle = {} :: any
	-- a = swept angle in degrees (0..360), clockwise from 12 o'clock
	local function draw(a: number)
		local right, left = halves[1], halves[2]
		right.clip.Visible = a > 0
		right.g.Rotation = math.min(a, 180)
		left.clip.Visible = a > 180
		left.g.Rotation = a
	end
	function handle.set(_, v: number)
		value = math.clamp(v, 0, 1)
		draw(value * 360)
	end
	function handle.get()
		return value
	end
	function handle.setColor(_, c: Color3)
		for _, h in halves do
			h.img.ImageColor3 = c
		end
	end
	-- Animate from the current value to v over t seconds.
	function handle.animate(_, v: number, t: number, style: Enum.EasingStyle?)
		return Motion.number(value, v, t, function(x)
			handle:set(x)
		end, style)
	end
	handle.Instance = root
	handle:set(props.value or 0)
	return handle
end

-- Progress ring with a centred label.
function Feedback.ring(scope: any, props: { [string]: any })
	local r = Feedback.radial(scope, { size = props.size or 72, color = props.color, sprite = "ring", trackColor = C.void, trackTransparency = 0.2, value = props.value, layoutOrder = props.layoutOrder })
	Atlas.image("chrome", "ring_thin", { Size = UDim2.new(1, 8, 1, 8), Position = UDim2.fromOffset(-4, -4), ImageColor3 = C.goldDeep, ZIndex = 3, Parent = r.Instance })
	local label = Surface.text({ role = "number", text = "", color = C.text, size = props.textSize or 16, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, if props.caption then 0.44 else 0.5), ZIndex = 4, Parent = r.Instance })
	if props.caption then
		Surface.text({ role = "caps", text = props.caption, color = C.textFaint, size = 9, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.66), ZIndex = 4, Parent = r.Instance })
	end
	local set = r.set
	function r.set(self, v: number)
		set(self, v)
		label.Text = if props.format then props.format(v) else `{math.floor(v * 100 + 0.5)}%`
	end
	r:set(props.value or 0)
	return r
end

---------------------------------------------------------------- Tag / Badge
-- props: text, color, glyph, solid
function Feedback.tag(props: { [string]: any }): Frame
	local color = props.color or C.gold
	local f = Create("Frame", {
		Name = "Tag",
		BackgroundColor3 = if props.solid then color else C.void,
		BackgroundTransparency = if props.solid then 0 else 0.35,
		Size = UDim2.fromOffset(0, props.height or 22),
		AutomaticSize = Enum.AutomaticSize.X,
		LayoutOrder = props.layoutOrder or 0,
		Parent = props.parent,
	}, { Create.corner(4), Create.stroke(color, 1, if props.solid then 1 else 0.2), Create.padding(0, 8, 0, 8), Create.list("x", 5, nil, Enum.VerticalAlignment.Center) })
	if props.glyph then
		Atlas.image("glyph", props.glyph, { Size = UDim2.fromOffset(12, 12), ImageColor3 = if props.solid then C.void else color, LayoutOrder = 1, Parent = f })
	end
	Surface.text({ role = "caps", text = props.text, color = if props.solid then C.void else color, size = props.textSize or 11, LayoutOrder = 2, Parent = f })
	return f
end

---------------------------------------------------------------- Spinner
-- props: size, color, text
function Feedback.spinner(scope: any, props: { [string]: any })
	local size = props.size or 44
	local root = scope:add(Create.box({ Name = "Spinner", Size = UDim2.fromOffset(size, size + (if props.text then 26 else 0)), LayoutOrder = props.layoutOrder or 0 }))
	local rune = Atlas.image("chrome", "spinner", { Size = UDim2.fromOffset(size, size), ImageColor3 = props.color or C.goldBright, Parent = root })
	if props.ring ~= false then
		Atlas.image("chrome", "node_round", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(size / 2, size / 2), Size = UDim2.fromOffset(size * 0.55, size * 0.55), Parent = root })
	end
	if props.text then
		Surface.text({ role = "lore", text = props.text, color = C.textSoft, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, size + 8), Parent = root })
	end
	scope:connect(RunService.RenderStepped, function(dt)
		if Motion.paused then
			return
		end
		rune.Rotation = (rune.Rotation + dt * (props.speed or 240)) % 360
	end)
	return { Instance = root }
end

---------------------------------------------------------------- Currency
-- props: amount, kind ("gold" | "gem" | "shard"), size; set(n) counts up/down with a flash
local CUR = {
	gold = { glyph = "coin", color = C.goldBright },
	gem = { glyph = "gem", color = Color3.fromHex("8FD3FF") },
	shard = { glyph = "sparkle", color = Color3.fromHex("C9A2FF") },
}
local function group(n: number): string
	local s = tostring(math.floor(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return out
end
Feedback.formatNumber = group

function Feedback.currency(scope: any, props: { [string]: any })
	local kind = CUR[props.kind or "gold"]
	local amount = props.amount or 0
	local size = props.size or 16
	local root = scope:add(Create.box({ Name = "Currency", Size = UDim2.fromOffset(0, size + 8), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = props.layoutOrder or 0 }, { Create.list("x", 6, nil, Enum.VerticalAlignment.Center) }))
	local icon = Atlas.image("glyph", kind.glyph, { Size = UDim2.fromOffset(size + 2, size + 2), ImageColor3 = kind.color, LayoutOrder = 1, Parent = root })
	local label = Surface.text({ role = "number", text = group(amount), color = props.color or C.text, size = size, LayoutOrder = 2, Parent = root })
	local pop = Create.scale(1)
	pop.Parent = icon
	local handle = {} :: any
	local cancel: (() -> ())? = nil
	function handle.set(_, n: number, instant: boolean?)
		local from = amount
		amount = n
		if cancel then
			cancel()
		end
		if instant then
			label.Text = group(n)
			return
		end
		label.TextColor3 = if n < from then C.bad else C.good
		cancel = Motion.number(from, n, 0.6, function(v)
			label.Text = group(v)
		end)
		Motion.pop(pop, 0.25)
		scope:add(task.delay(0.7, function()
			Motion.tween(label, { TextColor3 = props.color or C.text }, M.slow)
		end))
	end
	function handle.get()
		return amount
	end
	function handle.setInsufficient(_, v: boolean)
		label.TextColor3 = if v then C.bad else (props.color or C.text)
	end
	handle.Instance = root
	return handle
end

return Feedback
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX7"><Properties><string name="Name">ItemCard</string><ProtectedString name="Source"><![CDATA[--!strict
-- ItemCard: the item tooltip. Rarity header, type and level, stat lines, comparison deltas against an
-- equipped item, special effect, lore, value and weight. Static (returns a Frame), so the same card is
-- used as a hover tooltip, in comparison pairs and on its own.
local Theme = require(script.Parent.Parent.Theme)
local Atlas = require(script.Parent.Parent.Atlas)
local Create = require(script.Parent.Parent.Core.Create)
local Surface = require(script.Parent.Surface)
local Items = require(script.Parent.Parent.Data.Items)

local C = Theme.color
local ItemCard = {}

local function group(n: number): string
	local s = tostring(math.floor(n)):reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return if s:sub(1, 1) == "," then s:sub(2) else s
end

local function line(parent: Instance, order: number, h: number?): Frame
	return Create.box({ Size = UDim2.new(1, 0, 0, h or 20), LayoutOrder = order, Parent = parent })
end

-- opts: compare (Item to compare against), equipped (bool: this card is the equipped one), count, width, price
function ItemCard.new(item: any, opts: { [string]: any }?): Frame
	local o = opts or {}
	local r = Theme.rarityOf(item.rarity)
	local width = o.width or 290
	local card = Create.box({ Name = "ItemCard", Size = UDim2.fromOffset(width, 0), AutomaticSize = Enum.AutomaticSize.Y })
	-- body
	Create("Frame", {
		Name = "Fill",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromScale(1, 1),
		Parent = card,
	}, { Create.corner(7), Create.gradient({ C.leather1, C.leather0 }, 90) })
	-- rarity wash behind the header
	Create("Frame", {
		Name = "Wash",
		BackgroundColor3 = r.color,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(2, 2),
		Size = UDim2.new(1, -4, 0, 86),
		Parent = card,
	}, { Create.corner(6), Create("UIGradient", { Rotation = 90, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 1) }) }) })
	Atlas.image("chrome", "frame_thin", { Name = "Frame", Size = UDim2.fromScale(1, 1), SliceScale = 0.6, ImageColor3 = r.color:Lerp(Color3.new(1, 1, 1), 0.25), ZIndex = 4, Parent = card })

	local body = Create.box({ Name = "Body", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 2, Parent = card }, {
		Create.padding(14, 16, 14, 16),
		Create.list("y", 8),
	})

	-- header: icon, name, type
	local head = Create.box({ Name = "Head", Size = UDim2.new(1, 0, 0, 58), LayoutOrder = 1, Parent = body })
	local iconBox = Create.box({ Size = UDim2.fromOffset(56, 56), Parent = head })
	Create("Frame", { BackgroundColor3 = C.void, Size = UDim2.new(1, -4, 1, -4), Position = UDim2.fromOffset(2, 2), Parent = iconBox }, { Create.corner(6) })
	Atlas.image("chrome", "glow", { Size = UDim2.fromScale(1, 1), ImageColor3 = r.color, ImageTransparency = 0.5, ZIndex = 2, Parent = iconBox })
	Atlas.image("icon", item.icon, { Size = UDim2.fromScale(0.84, 0.84), Position = UDim2.fromScale(0.08, 0.08), ZIndex = 3, Parent = iconBox })
	Atlas.image("chrome", "frame_slot", { Size = UDim2.fromScale(1, 1), SliceScale = 0.35, ImageColor3 = r.color, ZIndex = 4, Parent = iconBox })
	local names = Create.box({ Position = UDim2.fromOffset(68, 0), Size = UDim2.new(1, -68, 1, 0), Parent = head }, { Create.list("y", 3, nil, Enum.VerticalAlignment.Center) })
	Surface.text({ role = "heading", text = item.name, color = r.color:Lerp(Color3.new(1, 1, 1), 0.15), size = 19, wrap = true, LayoutOrder = 1, Parent = names })
	Surface.text({ role = "small", text = `{r.name} {item.type}`, color = C.textSoft, size = 12, LayoutOrder = 2, Parent = names })
	if o.equipped or o.compare then
		local tagRow = Create.box({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 0, Parent = body })
		local t = Create("Frame", { BackgroundColor3 = if o.equipped then C.goldDeep else C.arcaneDeep, Size = UDim2.fromOffset(0, 20), AutomaticSize = Enum.AutomaticSize.X, Parent = tagRow }, { Create.corner(4), Create.padding(0, 8, 0, 8) })
		Surface.text({ role = "caps", text = if o.equipped then "Equipped" else "Compare to equipped", color = C.goldPale, size = 10, Size = UDim2.fromScale(0, 1), AutomaticSize = Enum.AutomaticSize.X, Parent = t })
	end

	-- level / slot line
	local meta = line(body, 2, 16)
	Surface.text({ role = "caps", text = if item.slot then (`{item.slot == "mainhand" and "Main hand" or item.slot == "offhand" and "Off hand" or item.slot}`) else item.kind, color = C.textFaint, size = 10, Parent = meta })
	Surface.text({ role = "caps", text = `Item level {item.level}`, color = C.textFaint, size = 10, AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Parent = meta })

	-- stats with comparison
	if item.stats then
		Surface.divider({ LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 12), Parent = body })
		local stats = Create.box({ Name = "Stats", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 4, Parent = body }, { Create.list("y", 3) })
		local cmp = o.compare and o.compare.stats or nil
		local keys = {}
		for _, k in Items.statOrder do
			if item.stats[k] or (cmp and cmp[k]) then
				table.insert(keys, k)
			end
		end
		for i, k in keys do
			local v = item.stats[k] or 0
			local row = line(stats, i, 20)
			local primary = k == "power" or k == "armor"
			Surface.text({
				role = if primary then "label" else "body",
				text = if v ~= 0 then Items.formatStat(k, v) else `— {Items.statNames[k]}`,
				color = if v == 0 then C.textGhost elseif primary then C.text else C.textSoft,
				size = if primary then 16 else 14,
				Parent = row,
			})
			if cmp then
				local d = v - (cmp[k] or 0)
				if d ~= 0 then
					local up = d > 0
					local dr = Create.box({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromOffset(0, 20), AutomaticSize = Enum.AutomaticSize.X, Parent = row }, { Create.list("x", 3, nil, Enum.VerticalAlignment.Center) })
					Atlas.image("glyph", if up then "arrow_up" else "arrow_down", { Size = UDim2.fromOffset(12, 12), ImageColor3 = if up then C.good else C.bad, LayoutOrder = 1, Parent = dr })
					Surface.text({ role = "number", text = `{math.abs(d)}{if Items.percentStats[k] then "%" else ""}`, color = if up then C.good else C.bad, size = 13, LayoutOrder = 2, Parent = dr })
				end
			end
		end
	end
	if item.effect then
		local eff = Create.box({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 5, Parent = body }, { Create.list("x", 8) })
		Atlas.image("glyph", "sparkle", { Size = UDim2.fromOffset(14, 14), Position = UDim2.fromOffset(0, 3), ImageColor3 = C.arcane, LayoutOrder = 1, Parent = eff })
		local t = Surface.text({ role = "small", text = item.effect, color = C.arcane, wrap = true, LayoutOrder = 2, Parent = eff })
		t.Size = UDim2.new(1, -22, 0, 0)
	end
	if item.lore then
		Surface.text({ role = "lore", text = `“{item.lore}”`, color = C.textFaint, wrap = true, LayoutOrder = 6, Parent = body })
	end
	-- footer
	local foot = line(body, 9, 22)
	Create("Frame", { BackgroundColor3 = C.seam, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 1), Parent = foot })
	local left = Create.box({ Position = UDim2.fromOffset(0, 6), Size = UDim2.new(0.5, 0, 0, 16), Parent = foot }, { Create.list("x", 5, nil, Enum.VerticalAlignment.Center) })
	if item.kind == "quest" then
		Surface.text({ role = "caps", text = "Quest item · cannot be sold", color = C.arcane, size = 10, Parent = left })
	else
		local price = o.price or item.value
		Atlas.image("glyph", "coin", { Size = UDim2.fromOffset(14, 14), ImageColor3 = C.goldBright, LayoutOrder = 1, Parent = left })
		Surface.text({ role = "number", text = group(price * (o.count or 1)), color = C.goldBright, size = 13, LayoutOrder = 2, Parent = left })
		if (o.count or 1) > 1 then
			Surface.text({ role = "small", text = `({price} each)`, color = C.textFaint, size = 11, LayoutOrder = 3, Parent = left })
		end
	end
	Surface.text({ role = "small", text = `{item.weight} lb`, color = C.textFaint, size = 12, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 6), Parent = foot })
	return card
end

return ItemCard
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">Slot</string><ProtectedString name="Source"><![CDATA[--!strict
-- Slot: the square every item lives in (inventory, equipment, vendor, rewards, crafting).
-- Rarity tints the frame and an inner glow; count, lock, equipped mark, drag highlight and dim states.
local Theme = require(script.Parent.Parent.Theme)
local Atlas = require(script.Parent.Parent.Atlas)
local Create = require(script.Parent.Parent.Core.Create)
local Motion = require(script.Parent.Parent.Core.Motion)
local Interact = require(script.Parent.Parent.Core.Interact)
local Surface = require(script.Parent.Surface)

local C = Theme.color
local M = Theme.motion
local Slot = {}

export type Props = {
	size: number?,
	item: any?,
	count: number?,
	locked: boolean?,
	emptyGlyph: string?,
	label: string?, -- caption under an empty slot (equipment)
	equipped: boolean?,
	onClick: (() -> ())?,
	layoutOrder: number?,
	parent: Instance?,
}

function Slot.new(scope: any, props: Props)
	local size = props.size or Theme.size.slot
	local root = scope:add(Create("ImageButton", {
		Name = "Slot",
		BackgroundTransparency = 1,
		Image = "",
		Size = UDim2.fromOffset(size, size),
		LayoutOrder = props.layoutOrder or 0,
	}))
	local face = Create.box({ Name = "Face", Size = UDim2.fromScale(1, 1), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Parent = root })
	local scale = Create.scale(1)
	scale.Parent = face
	local well = Create("Frame", { Name = "Well", BackgroundColor3 = Color3.new(1, 1, 1), Position = UDim2.fromOffset(3, 3), Size = UDim2.new(1, -6, 1, -6), Parent = face }, {
		Create.corner(math.floor(size * 0.1)),
		Create.gradient({ C.leather1, C.void }, 90),
	})
	local glow = Atlas.image("chrome", "glow", { Name = "Glow", Size = UDim2.fromScale(1.05, 1.05), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.62), ImageTransparency = 0.6, ZIndex = 1, Parent = face })
	local empty = Atlas.image("glyph", props.emptyGlyph or "bag", { Name = "EmptyGlyph", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, if props.label then 0.42 else 0.5), Size = UDim2.fromScale(0.36, 0.36), ImageColor3 = C.textGhost, ImageTransparency = 0.35, ZIndex = 1, Parent = face })
	local caption: TextLabel? = nil
	if props.label then
		caption = Surface.text({ role = "caps", text = props.label, color = C.textGhost, size = 9, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -7), ZIndex = 1, Parent = face })
	end
	local icon = Create("ImageLabel", { Name = "Icon", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.8, 0.8), ZIndex = 2, Parent = face })
	local frame = Atlas.image("chrome", "frame_slot", { Name = "Frame", Size = UDim2.fromScale(1, 1), SliceScale = math.clamp(size / 150, 0.3, 0.6), ZIndex = 3, Parent = face })
	local count = Surface.text({
		role = "number",
		text = "",
		size = math.max(12, math.floor(size * 0.22)),
		color = C.text,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -6, 1, -3),
		ZIndex = 5,
		Parent = face,
	})
	count.TextStrokeColor3 = C.void
	count.TextStrokeTransparency = 0.1
	local equippedMark = Atlas.image("chrome", "pip", { Name = "Equipped", Position = UDim2.fromOffset(4, 4), Size = UDim2.fromOffset(14, 14), Visible = false, ZIndex = 5, Parent = face })
	local lock = Create("Frame", { Name = "Lock", BackgroundColor3 = C.void, BackgroundTransparency = 0.35, Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 6, Parent = face }, { Create.corner(math.floor(size * 0.1)) })
	Atlas.image("glyph", "lock", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.34, 0.34), ImageColor3 = C.textSoft, ZIndex = 7, Parent = lock })
	local ring = Create("Frame", { Name = "Ring", BackgroundTransparency = 1, Size = UDim2.new(1, -2, 1, -2), Position = UDim2.fromOffset(1, 1), Visible = false, ZIndex = 8, Parent = face }, { Create.corner(math.floor(size * 0.12)), Create.stroke(C.arcane, 2.5, 0) })
	local hint = Create("Frame", { Name = "DropHint", BackgroundColor3 = C.arcane, BackgroundTransparency = 1, Size = UDim2.new(1, -6, 1, -6), Position = UDim2.fromOffset(3, 3), ZIndex = 4, Parent = face }, { Create.corner(math.floor(size * 0.1)) })

	local item: any = nil
	local n = 0
	local flags = { selected = false, dim = false, drop = false :: string | boolean, lifted = false, locked = props.locked == true, equipped = props.equipped == true }
	local ctl

	local function paint(s)
		local r = Theme.rarityOf(item and item.rarity)
		local has = item ~= nil
		icon.Visible = has
		empty.Visible = not has
		if caption then
			caption.Visible = not has
		end
		glow.Visible = has
		glow.ImageColor3 = r.color
		glow.ImageTransparency = if s.hover or flags.selected then 0.4 else 0.62
		frame.ImageColor3 = if has then r.color else C.seam
		if has and r.rank == 1 then
			frame.ImageColor3 = Color3.fromHex("9C9385")
		end
		if s.hover and not flags.locked then
			frame.ImageColor3 = frame.ImageColor3:Lerp(Color3.new(1, 1, 1), 0.3)
		end
		count.Visible = has and n > 1
		count.Text = tostring(n)
		equippedMark.Visible = has and flags.equipped
		lock.Visible = flags.locked
		ring.Visible = flags.selected or (s.focused and not flags.locked)
		ring:FindFirstChildOfClass("UIStroke").Color = if flags.selected then C.goldBright else C.arcane
		local fade = if flags.lifted then 0.75 elseif flags.dim then 0.78 else 0
		icon.ImageTransparency = fade
		well.BackgroundTransparency = if flags.dim then 0.5 else 0
		frame.ImageTransparency = if flags.dim then 0.6 else 0
		hint.BackgroundTransparency = if flags.drop == "valid" then 0.72 elseif flags.drop == "invalid" then 0.75 else 1
		hint.BackgroundColor3 = if flags.drop == "invalid" then C.bad else C.arcane
		Motion.tween(scale, { Scale = if s.pressed then 0.94 elseif s.hover and has and not flags.locked then 1.04 else 1 }, M.fast, nil, nil, "press")
	end

	ctl = Interact.attach(root, scope, paint, props.onClick)
	local handle = {} :: any
	function handle.setItem(_, it: any?, c: number?)
		item = it
		n = if it then (c or 1) else 0
		if it then
			for k, v in Atlas.icon(it.icon) do
				(icon :: any)[k] = v
			end
		end
		paint(ctl.state)
	end
	function handle.set(_, patch: { [string]: any })
		for k, v in patch do
			(flags :: any)[k] = v
		end
		paint(ctl.state)
	end
	function handle.getItem()
		return item, n
	end
	function handle.pop()
		Motion.pop(scale, 0.12)
	end
	function handle.force(_, p)
		ctl:force(p)
	end
	handle.Instance = root
	handle.icon = icon
	handle.controller = ctl
	handle:setItem(props.item, props.count)
	if props.parent then
		root.Parent = props.parent
	end
	return handle
end

return Slot
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">Surface</string><ProtectedString name="Source"><![CDATA[--!strict
-- Surface: the shared building blocks every component is made of.
--   text      typographic label with the library's type roles
--   panel     leather panel: grained fill, gilt 9-slice frame, flourished corners, optional title plaque
--   parchment vellum card with fibres and an inked edge
--   well      recessed dark area inside a panel (lists, slot grids)
--   divider   gilt rule with a centre ornament
--   header    panel title row: display title, optional subtitle and right-side content
local Theme = require(script.Parent.Parent.Theme)
local Atlas = require(script.Parent.Parent.Atlas)
local Create = require(script.Parent.Parent.Core.Create)

local C = Theme.color
local Surface = {}

export type TextRole = "hero" | "title" | "heading" | "label" | "body" | "small" | "tiny" | "lore" | "number" | "caps"

local ROLE: { [string]: { font: Font, size: number } } = {
	hero = { font = Theme.font.blackletter, size = Theme.text.hero },
	title = { font = Theme.font.display, size = Theme.text.title },
	heading = { font = Theme.font.display, size = Theme.text.heading },
	label = { font = Theme.font.bodyBold, size = Theme.text.label },
	body = { font = Theme.font.body, size = Theme.text.body },
	small = { font = Theme.font.body, size = Theme.text.small },
	tiny = { font = Theme.font.bodyBold, size = Theme.text.tiny },
	lore = { font = Theme.font.italic, size = Theme.text.small },
	number = { font = Theme.font.numeric, size = Theme.text.label },
	caps = { font = Theme.font.bodyBold, size = Theme.text.tiny },
}

-- props: text, role, color, size (font size), plus any TextLabel props.
-- Labels auto-size on X unless a Size is given; `wrap = true` makes width fixed and height automatic.
function Surface.text(props: { [string]: any }): TextLabel
	local role = ROLE[props.role or "body"]
	local p: { [string]: any } = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		FontFace = role.font,
		TextSize = props.size or role.size,
		TextColor3 = props.color or C.text,
		Text = props.text or "",
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		RichText = props.rich == true,
		AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.new(),
	}
	if props.role == "caps" then
		p.Text = string.upper(p.Text)
	end
	if props.wrap then
		p.TextWrapped = true
		p.AutomaticSize = Enum.AutomaticSize.Y
		p.Size = UDim2.new(1, 0, 0, 0)
		p.TextYAlignment = Enum.TextYAlignment.Top
	end
	if props.Size ~= nil and props.AutomaticSize == nil and not props.wrap then
		-- an explicit Size means a fixed box (truncation, alignment); auto-size only when asked
		p.AutomaticSize = Enum.AutomaticSize.None
	end
	for k, v in props do
		if k ~= "role" and k ~= "color" and k ~= "size" and k ~= "text" and k ~= "wrap" and k ~= "rich" then
			p[k] = v
		end
	end
	if props.size and typeof(props.size) == "UDim2" then
		p.Size = props.size
		p.TextSize = role.size
		p.AutomaticSize = if props.wrap then Enum.AutomaticSize.Y else Enum.AutomaticSize.None
	end
	return Create("TextLabel", p)
end

-- Leather panel. Returns (panel, content) where content is the padded inner frame.
-- opts: title, subtitle, size, padding, corners (bool), tone ("leather" | "deep"), parent
function Surface.panel(opts: { [string]: any }): (Frame, Frame)
	local pad = opts.padding or 18
	-- Auto-sized frames also measure scale-sized descendants that carry offsets or UIStrokes, so every
	-- decoration here is exactly scale (1, 1) with no offset and no stroke: the gilt frame covers the
	-- fill's rounded edge.
	local panel = Create.box({
		Name = opts.name or "Panel",
		Size = opts.size or UDim2.fromOffset(360, 240),
		Position = opts.position,
		AnchorPoint = opts.anchor,
		LayoutOrder = opts.layoutOrder or 0,
		Parent = opts.parent,
	})
	local fill = Create("Frame", {
		Name = "Fill",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 0,
		Parent = panel,
	}, {
		Create.corner(10),
		Create.gradient(if opts.tone == "deep" then { C.leather1, C.leather0 } else { C.leather2, C.leather1, C.leather0 }, 90),
	})
	Atlas.texture("leather", { Name = "Grain", ImageColor3 = C.goldPale, ImageTransparency = 0.9, ZIndex = 0, Parent = fill })
	Atlas.image("chrome", "frame_gilt", {
		Name = "Frame",
		Size = UDim2.fromScale(1, 1),
		SliceScale = opts.frameScale or 0.62,
		ZIndex = 4,
		Parent = panel,
	})

	local content = Create.box({
		Name = "Content",
		Size = UDim2.fromScale(1, 1),
		ZIndex = 2,
		Parent = panel,
	}, { Create.padding(pad + 4, pad + 2, pad + 2, pad + 2) })
	if opts.autoSize then
		-- Height from the content's UIListLayout (exact extent of the direct children). AutomaticSize would
		-- also count decorative overflow deep in the tree (glows, rays) and leave dead space.
		local function hook(layout: UIListLayout)
			local function fit()
				local unit = panel.Size.X.Offset
				local scale = if unit > 0 and panel.AbsoluteSize.X > 0 then panel.AbsoluteSize.X / unit else 1
				local padding = content:FindFirstChildOfClass("UIPadding") :: UIPadding
				local h = layout.AbsoluteContentSize.Y / scale + padding.PaddingTop.Offset + padding.PaddingBottom.Offset
				panel.Size = UDim2.new(panel.Size.X, UDim.new(0, math.ceil(h)))
			end
			layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(fit)
			panel:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
			task.defer(fit)
		end
		content.ChildAdded:Connect(function(c)
			if c:IsA("UIListLayout") then
				hook(c)
			end
		end)
	end

	if opts.title then
		local plaque = Atlas.image("chrome", "plaque", {
			Name = "TitlePlaque",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0, 0),
			Size = UDim2.fromOffset(0, 40),
			AutomaticSize = Enum.AutomaticSize.X,
			SliceScale = 0.8,
			ZIndex = 6,
			Parent = panel,
		})
		Create.padding(0, 34, 0, 34).Parent = plaque
		local t = Surface.text({
			role = "heading",
			text = opts.title,
			color = C.goldBright,
			size = 19,
			Size = UDim2.new(0, 0, 1, 0),
			AutomaticSize = Enum.AutomaticSize.X,
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = 7,
			Parent = plaque,
		})
		t.Name = "Title"
		content:FindFirstChildOfClass("UIPadding").PaddingTop = UDim.new(0, pad + 22)
	end
	return panel, content
end

-- Parchment card. Returns (card, content).
function Surface.parchment(opts: { [string]: any }): (Frame, Frame)
	local pad = opts.padding or 14
	local card = Create("Frame", {
		Name = opts.name or "Parchment",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Size = opts.size or UDim2.fromOffset(300, 180),
		AutomaticSize = opts.autoSize,
		Position = opts.position,
		AnchorPoint = opts.anchor,
		Parent = opts.parent,
	}, {
		Create.corner(5),
		Create.gradient(ColorSequence.new({
			ColorSequenceKeypoint.new(0, C.goldPale),
			ColorSequenceKeypoint.new(0.45, C.vellum),
			ColorSequenceKeypoint.new(1, C.vellumDeep),
		}), 60),
		Create.stroke(C.vellumEdge, 2, 0),
	})
	Atlas.texture("parchment", { Name = "Fibres", Parent = card })
	local content = Create.box({
		Name = "Content",
		Size = UDim2.fromScale(1, 1),
		AutomaticSize = opts.autoSize,
		ZIndex = 2,
		Parent = card,
	}, { Create.padding(pad) })
	return card, content
end

-- Recessed well inside a panel.
function Surface.well(props: { [string]: any }): Frame
	local p: { [string]: any } = {
		Name = "Well",
		BackgroundColor3 = C.void,
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
	}
	for k, v in props do
		p[k] = v
	end
	return Create("Frame", p, { Create.corner(6), Create.stroke(C.seam, 1, 0.2) })
end

-- Gilt rule with the centre ornament. Fills its parent's width.
function Surface.divider(props: { [string]: any }?): Frame
	local p: { [string]: any } = { Name = "Divider", Size = UDim2.new(1, 0, 0, 16) }
	for k, v in props or {} do
		p[k] = v
	end
	local f = Create.box(p)
	local fade = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 0) })
	for _, side in { -1, 1 } do
		Create("Frame", {
			BackgroundColor3 = C.gold,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(if side < 0 then 1 else 0, 0.5),
			Position = UDim2.new(0.5, side * 30, 0.5, 0),
			Size = UDim2.new(0.5, -32, 0, 1),
			Parent = f,
		}, { Create("UIGradient", { Transparency = fade, Rotation = if side < 0 then 0 else 180 }) })
	end
	Atlas.image("chrome", "divider_mark", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(64, 16),
		Parent = f,
	})
	return f
end

-- Small uppercase section caption followed by a fading hairline, used inside panels.
function Surface.caption(text: string, props: { [string]: any }?): Frame
	local p: { [string]: any } = { Name = "Caption", Size = UDim2.new(1, 0, 0, 18) }
	for k, v in props or {} do
		p[k] = v
	end
	local f = Create.box(p, { Create.list("x", 10, nil, Enum.VerticalAlignment.Center) })
	Surface.text({ role = "caps", text = text, color = C.gold, LayoutOrder = 1, Parent = f })
	Create("Frame", {
		BackgroundColor3 = C.goldDeep,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 0, 0, 1),
		LayoutOrder = 2,
		Parent = f,
	}, { Create.flex(), Create("UIGradient", { Transparency = NumberSequence.new(0.1, 1) }) })
	return f
end

return Surface
]]></ProtectedString></Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="RBX19"><Properties><string name="Name">Core</string></Properties>
      <Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">Create</string><ProtectedString name="Source"><![CDATA[--!strict
-- Instance builder: Create("Frame", { Size = ..., Parent = ... }, { children })
-- Parent is assigned last so the subtree is complete before it enters the DataModel.
-- Shorthands for the modifiers used everywhere (corner, stroke, padding, list, gradient, scale).
local Create = {}

local function new(class: string, props: { [string]: any }?, children: { Instance? }?): any
	local inst = Instance.new(class)
	local parent
	if props then
		for k, v in props do
			if k == "Parent" then
				parent = v
			else
				(inst :: any)[k] = v
			end
		end
	end
	if children then
		for _, c in children do
			if c then
				c.Parent = inst
			end
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

setmetatable(Create, {
	__call = function(_, class, props, children)
		return new(class, props, children)
	end,
})
Create.new = new

function Create.corner(r: number): UICorner
	return new("UICorner", { CornerRadius = UDim.new(0, r) })
end

function Create.stroke(color: Color3, thickness: number?, transparency: number?, mode: Enum.ApplyStrokeMode?): UIStroke
	return new("UIStroke", {
		Color = color,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = mode or Enum.ApplyStrokeMode.Border,
	})
end

function Create.padding(t: number, r: number?, b: number?, l: number?): UIPadding
	return new("UIPadding", {
		PaddingTop = UDim.new(0, t),
		PaddingRight = UDim.new(0, r or t),
		PaddingBottom = UDim.new(0, b or t),
		PaddingLeft = UDim.new(0, l or r or t),
	})
end

function Create.list(dir: "x" | "y", gap: number?, halign: Enum.HorizontalAlignment?, valign: Enum.VerticalAlignment?): UIListLayout
	return new("UIListLayout", {
		FillDirection = if dir == "x" then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical,
		Padding = UDim.new(0, gap or 0),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = halign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = valign or Enum.VerticalAlignment.Top,
	})
end

function Create.gradient(colors: { Color3 } | ColorSequence, rotation: number?, transparency: NumberSequence?): UIGradient
	local seq: ColorSequence
	if typeof(colors) == "ColorSequence" then
		seq = colors
	else
		local list = colors :: { Color3 }
		local keys = {}
		for i, c in list do
			table.insert(keys, ColorSequenceKeypoint.new((i - 1) / math.max(1, #list - 1), c))
		end
		if #keys == 1 then
			table.insert(keys, ColorSequenceKeypoint.new(1, list[1]))
		end
		seq = ColorSequence.new(keys)
	end
	return new("UIGradient", { Color = seq, Rotation = rotation or 90, Transparency = transparency })
end

function Create.scale(s: number?): UIScale
	return new("UIScale", { Scale = s or 1 })
end

function Create.flex(mode: Enum.UIFlexMode?, grow: number?): UIFlexItem
	return new("UIFlexItem", { FlexMode = mode or Enum.UIFlexMode.Fill, GrowRatio = grow or 1 })
end

-- Size `root` to the width of an auto-sized `row` inside it, in root's own units. AutomaticSize on
-- root would also measure decorations that overhang (focus rings), so width is set explicitly; the
-- scale factor of any ancestor UIScale is recovered from the known height.
function Create.fitWidth(root: GuiObject, row: GuiObject, height: number, extra: number?): RBXScriptConnection
	local function fit()
		local a = row.AbsoluteSize
		if a.Y > 0 then
			root.Size = UDim2.fromOffset(math.ceil(a.X * height / a.Y) + (extra or 0), height)
		end
	end
	local c = row:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
	task.defer(fit)
	return c
end

-- Transparent container frame.
function Create.box(props: { [string]: any }?, children: { Instance? }?): Frame
	local p = { BackgroundTransparency = 1, BorderSizePixel = 0 }
	if props then
		for k, v in props do
			p[k] = v
		end
	end
	return new("Frame", p, children)
end

return Create
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX12"><Properties><string name="Name">DragDrop</string><ProtectedString name="Source"><![CDATA[--!strict
-- DragDrop: pointer drag between registered targets. A source starts a drag with a payload after a small
-- movement threshold; a ghost follows the pointer in the overlay; targets under the pointer are asked
-- accepts(payload) and get highlight(state) ("valid" | "invalid" | nil); release calls drop(payload) on the
-- target or cancel on the source. Works inside a UIScale (coordinates go through Layers).
local UserInputService = game:GetService("UserInputService")
local Layers = require(script.Parent.Layers)
local Motion = require(script.Parent.Motion)
local Theme = require(script.Parent.Parent.Theme)

export type Target = {
	gui: GuiObject,
	accepts: (payload: any) -> boolean,
	highlight: (state: string?) -> (),
	drop: (payload: any) -> (),
}

local DragDrop = {}
DragDrop.__index = DragDrop

-- One context per widget (or shared between widgets that exchange items).
function DragDrop.new(scope: any)
	local self = setmetatable({ targets = {} :: { Target }, active = nil :: any, scope = scope }, DragDrop)
	scope:add(function()
		self:_end(nil)
	end)
	return self
end

function DragDrop:addTarget(t: Target)
	table.insert(self.targets, t)
	return function()
		local i = table.find(self.targets, t)
		if i then
			table.remove(self.targets, i)
		end
	end
end

local function inside(gui: GuiObject, p: Vector2): boolean
	local a, s = gui.AbsolutePosition, gui.AbsoluteSize
	return gui.Visible and p.X >= a.X and p.Y >= a.Y and p.X <= a.X + s.X and p.Y <= a.Y + s.Y
end

function DragDrop:_targetAt(p: Vector2): Target?
	for _, t in self.targets do
		if t.gui.Parent and inside(t.gui, p) then
			return t
		end
	end
	return nil
end

-- source: the pressed GuiObject. payload: anything. makeGhost(): GuiObject sized in local units.
-- callbacks: onStart(), onCancel(), onEnd()
function DragDrop:bindSource(scope: any, source: GuiObject, getPayload: () -> any?, makeGhost: () -> GuiObject, callbacks: { [string]: any }?)
	local cb = callbacks or {}
	scope:connect(source.InputBegan, function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		local payload = getPayload()
		if payload == nil or self.active then
			return
		end
		local start = Vector2.new(input.Position.X, input.Position.Y)
		local pending = { payload = payload, start = start, source = source, makeGhost = makeGhost, cb = cb, started = false }
		self.active = pending
		local moveConn, endConn
		moveConn = UserInputService.InputChanged:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
				self:_move(Vector2.new(i.Position.X, i.Position.Y))
			end
		end)
		endConn = UserInputService.InputEnded:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				moveConn:Disconnect()
				endConn:Disconnect()
				self:_end(Vector2.new(i.Position.X, i.Position.Y))
			end
		end)
		pending.conns = { moveConn, endConn }
	end)
end

function DragDrop:_move(p: Vector2)
	local a = self.active
	if not a then
		return
	end
	if not a.started then
		if (p - a.start).Magnitude < 6 then
			return
		end
		a.started = true
		local ghost = a.makeGhost()
		ghost.AnchorPoint = Vector2.new(0.5, 0.5)
		ghost.ZIndex = Theme.z.drag
		for _, d in ghost:GetDescendants() do
			if d:IsA("GuiObject") then
				d.ZIndex += Theme.z.drag
			end
		end
		ghost.Parent = Layers.get()
		local sc = Instance.new("UIScale")
		sc.Scale = 1
		sc.Parent = ghost
		Motion.tween(sc, { Scale = 1.12 }, Theme.motion.base, Theme.motion.spring)
		a.ghost = ghost
		if a.cb.onStart then
			a.cb.onStart()
		end
	end
	local l = Layers.toLocal(p)
	a.ghost.Position = UDim2.fromOffset(l.X, l.Y)
	a.ghost.Rotation = math.clamp((p.X - (a.lastX or p.X)) * 0.6, -8, 8)
	a.lastX = p.X
	local t = self:_targetAt(p)
	if t ~= a.hover then
		if a.hover then
			a.hover.highlight(nil)
		end
		a.hover = t
		if t and t.gui ~= a.source then
			t.highlight(if t.accepts(a.payload) then "valid" else "invalid")
		end
	end
end

-- Programmatic drag (tests, keyboard moves and the gallery's scripted demo): drop payload on a target gui.
function DragDrop:dropOn(payload: any, gui: GuiObject): boolean
	for _, t in self.targets do
		if t.gui == gui and t.accepts(payload) then
			t.drop(payload)
			return true
		end
	end
	return false
end

function DragDrop:_end(p: Vector2?)
	local a = self.active
	if not a then
		return
	end
	self.active = nil
	if a.conns then
		for _, c in a.conns do
			c:Disconnect()
		end
	end
	if a.hover then
		a.hover.highlight(nil)
	end
	if a.ghost then
		a.ghost:Destroy()
	end
	if not a.started then
		return
	end
	local t = if p then self:_targetAt(p) else nil
	if t and t.accepts(a.payload) then
		t.drop(a.payload)
	elseif a.cb.onCancel then
		a.cb.onCancel()
	end
	if a.cb.onEnd then
		a.cb.onEnd()
	end
end

function DragDrop:isDragging(): boolean
	return self.active ~= nil and self.active.started == true
end

return DragDrop
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX13"><Properties><string name="Name">Interact</string><ProtectedString name="Source"><![CDATA[--!strict
-- Interact: one state machine for every pressable control. Tracks hover, press, keyboard focus,
-- selected, disabled and loading, and calls render(state) whenever any of them changes. Controls
-- never wire MouseEnter/InputBegan themselves, so behaviour is identical across the library.
--
-- Keyboard: controls are Selectable; GuiService.SelectedObject drives focus. Each control draws its own
-- focus treatment (SelectionImageObject is an empty frame so Roblox's default ring never overlaps).
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")

export type State = {
	hover: boolean,
	pressed: boolean,
	focused: boolean,
	selected: boolean,
	disabled: boolean,
	loading: boolean,
}

export type Controller = {
	state: State,
	set: (self: Controller, patch: { [string]: boolean }) -> (),
	-- force a visual state (gallery state boards); nil returns to live input
	force: (self: Controller, patch: { [string]: boolean }?) -> (),
}

local Interact = {}

local emptySelection: Frame? = nil
function Interact.noRing(): Frame
	if not emptySelection then
		local f = Instance.new("Frame")
		f.Name = "VellumNoRing"
		f.BackgroundTransparency = 1
		f.Size = UDim2.fromScale(0, 0)
		emptySelection = f
	end
	return emptySelection :: Frame
end

local function isPointer(input: InputObject)
	local t = input.UserInputType
	return t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch
end

-- button: the GuiButton receiving input. scope: owner. render: called with the effective state.
-- onActivate: called on click / Enter / tap unless disabled or loading.
function Interact.attach(button: GuiButton, scope: any, render: (State) -> (), onActivate: (() -> ())?): Controller
	local live: State = { hover = false, pressed = false, focused = false, selected = false, disabled = false, loading = false }
	local forced: { [string]: boolean }? = nil

	button.AutoButtonColor = false
	button.Selectable = true
	button.SelectionImageObject = Interact.noRing()

	local ctl = {} :: any
	ctl.state = live

	local function effective(): State
		if not forced then
			return live
		end
		local s = table.clone(live)
		for k, v in forced do
			(s :: any)[k] = v
		end
		return s
	end

	local function refresh()
		render(effective())
	end

	function ctl:set(patch)
		for k, v in patch do
			(live :: any)[k] = v
		end
		if live.disabled then
			live.pressed = false
		end
		button.Selectable = not live.disabled
		refresh()
	end

	function ctl:force(patch)
		forced = patch
		refresh()
	end

	scope:connect(button.MouseEnter, function()
		live.hover = true
		refresh()
	end)
	scope:connect(button.MouseLeave, function()
		live.hover = false
		live.pressed = false
		refresh()
	end)
	scope:connect(button.InputBegan, function(input)
		if isPointer(input) and not live.disabled then
			live.pressed = true
			refresh()
		end
	end)
	scope:connect(button.InputEnded, function(input)
		if isPointer(input) and live.pressed then
			live.pressed = false
			refresh()
		end
	end)
	scope:connect(button.SelectionGained, function()
		live.focused = true
		refresh()
	end)
	scope:connect(button.SelectionLost, function()
		live.focused = false
		live.pressed = false
		refresh()
	end)
	-- keyboard press feedback while focused
	scope:connect(UserInputService.InputBegan, function(input)
		if GuiService.SelectedObject == button and (input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.KeypadEnter) and not live.disabled then
			live.pressed = true
			refresh()
		end
	end)
	scope:connect(UserInputService.InputEnded, function(input)
		if live.pressed and (input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.KeypadEnter) then
			live.pressed = false
			refresh()
		end
	end)
	scope:connect(button.Activated, function()
		if live.disabled or live.loading then
			return
		end
		if onActivate then
			onActivate()
		end
	end)

	refresh()
	return ctl
end

return Interact
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX14"><Properties><string name="Name">Layers</string><ProtectedString name="Source"><![CDATA[--!strict
-- Layers: the overlay surface for tooltips, popovers, context menus, drag ghosts, modals and toasts.
-- A host (the gallery stage, or a game's ScreenGui) mounts one overlay frame; components ask Layers
-- for it. Coordinates are converted from screen pixels to the overlay's local units, so overlays stay
-- correct inside a UIScale (the capture stage renders at 2x).
local Create = require(script.Parent.Create)

local Layers = {}

local overlay: Frame? = nil
local probe: Frame? = nil

function Layers.mount(parent: GuiObject | LayerCollector, zindex: number?): Frame
	if overlay then
		overlay:Destroy()
	end
	local o = Create.box({
		Name = "VellumOverlay",
		Size = UDim2.fromScale(1, 1),
		ZIndex = zindex or 1000,
		Parent = parent,
	})
	probe = Create.box({ Name = "ScaleProbe", Size = UDim2.fromOffset(100, 100), Visible = true, Parent = o })
	overlay = o
	return o
end

function Layers.get(): Frame
	assert(overlay, "Vellum.Layers: no overlay mounted (call Layers.mount)")
	return overlay :: Frame
end

function Layers.scale(): number
	local p = probe
	if not p or p.AbsoluteSize.X == 0 then
		return 1
	end
	return p.AbsoluteSize.X / 100
end

-- screen pixels → overlay offset units
function Layers.toLocal(screen: Vector2): Vector2
	local o = Layers.get()
	return (screen - o.AbsolutePosition) / Layers.scale()
end

function Layers.size(): Vector2
	return Layers.get().AbsoluteSize / Layers.scale()
end

-- local rect of a gui object inside the overlay: position, size
function Layers.rectOf(gui: GuiObject): (Vector2, Vector2)
	return Layers.toLocal(gui.AbsolutePosition), gui.AbsoluteSize / Layers.scale()
end

-- Place a popover of `size` next to an anchor rect, preferring `side`, flipping and clamping so it
-- always stays inside the overlay. Returns the top-left in local units and the side used.
function Layers.place(anchorPos: Vector2, anchorSize: Vector2, size: Vector2, side: ("right" | "left" | "below" | "above")?, gap: number?): (Vector2, string)
	local area = Layers.size()
	local g = gap or 10
	local order = {
		right = { "right", "left", "below", "above" },
		left = { "left", "right", "below", "above" },
		below = { "below", "above", "right", "left" },
		above = { "above", "below", "right", "left" },
	}
	local function at(s: string): Vector2
		if s == "right" then
			return Vector2.new(anchorPos.X + anchorSize.X + g, anchorPos.Y)
		elseif s == "left" then
			return Vector2.new(anchorPos.X - size.X - g, anchorPos.Y)
		elseif s == "below" then
			return Vector2.new(anchorPos.X, anchorPos.Y + anchorSize.Y + g)
		end
		return Vector2.new(anchorPos.X, anchorPos.Y - size.Y - g)
	end
	local function fits(p: Vector2)
		return p.X >= 4 and p.Y >= 4 and p.X + size.X <= area.X - 4 and p.Y + size.Y <= area.Y - 4
	end
	local chosen, pos = side or "right", at(side or "right")
	for _, s in order[side or "right"] do
		local p = at(s)
		if fits(p) then
			chosen, pos = s, p
			break
		end
	end
	pos = Vector2.new(math.clamp(pos.X, 4, math.max(4, area.X - size.X - 4)), math.clamp(pos.Y, 4, math.max(4, area.Y - size.Y - 4)))
	return pos, chosen
end

return Layers
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX15"><Properties><string name="Name">Motion</string><ProtectedString name="Source"><![CDATA[--!strict
-- Motion: tween helpers. One running tween per (instance, channel): starting a new one cancels the old,
-- so rapid hover/press never stacks tweens. Honours a global reduced-motion switch.
local TweenService = game:GetService("TweenService")
local Theme = require(script.Parent.Parent.Theme)

local Motion = {}
Motion.reduced = false
-- Paused: per-frame animations (pulses, rays, spinners, timers) hold still. Used by tiled captures so
-- every tile shows the same instant.
Motion.paused = false

local running: { [Instance]: { [string]: Tween } } = setmetatable({}, { __mode = "k" }) :: any

function Motion.tween(inst: Instance, props: { [string]: any }, duration: number?, style: Enum.EasingStyle?, dir: Enum.EasingDirection?, channel: string?): Tween
	local ch = channel or "default"
	local byInst = running[inst]
	if not byInst then
		byInst = {}
		running[inst] = byInst
	end
	local old = byInst[ch]
	if old then
		old:Cancel()
	end
	local d = if Motion.reduced then 0 else (duration or Theme.motion.base)
	local tw = TweenService:Create(inst, TweenInfo.new(d, style or Theme.motion.ease, dir or Enum.EasingDirection.Out), props)
	byInst[ch] = tw
	tw.Completed:Once(function()
		if byInst[ch] == tw then
			byInst[ch] = nil
		end
		tw:Destroy()
	end)
	tw:Play()
	return tw
end

-- Animate a number from a to b, calling fn(value) every frame. Returns a cancel function.
function Motion.number(from: number, to: number, duration: number, fn: (number) -> (), style: Enum.EasingStyle?): () -> ()
	local holder = Instance.new("NumberValue")
	holder.Value = from
	local conn = holder.Changed:Connect(fn)
	fn(from)
	local tw = Motion.tween(holder, { Value = to }, duration, style)
	local done = false
	local function cancel()
		if done then
			return
		end
		done = true
		conn:Disconnect()
		tw:Cancel()
		holder:Destroy()
	end
	tw.Completed:Once(function()
		fn(to)
		cancel()
	end)
	return cancel
end

-- Short punch: scale up then settle (needs a UIScale child).
function Motion.pop(scale: UIScale, amount: number?)
	scale.Scale = 1 + (amount or 0.08)
	Motion.tween(scale, { Scale = 1 }, Theme.motion.slow, Enum.EasingStyle.Back)
end

-- Horizontal shake used for refusals (insufficient gold, locked node...).
function Motion.shake(gui: GuiObject)
	if Motion.reduced then
		return
	end
	local base = gui.Position
	task.spawn(function()
		for _, dx in { 7, -6, 4, -3, 1, 0 } do
			gui.Position = base + UDim2.fromOffset(dx, 0)
			task.wait(0.035)
		end
		gui.Position = base
	end)
end

return Motion
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX16"><Properties><string name="Name">Scope</string><ProtectedString name="Source"><![CDATA[--!strict
-- Scope: owns everything a component creates (connections, instances, tweens, threads, child scopes)
-- and releases it all with one :Destroy(). Every component gets one; the gallery destroys the
-- specimen's scope when it switches, so nothing leaks between specimens.

export type Scope = {
	add: <T>(self: Scope, item: T) -> T,
	connect: (self: Scope, signal: RBXScriptSignal, fn: (...any) -> ()) -> RBXScriptConnection,
	child: (self: Scope) -> Scope,
	defer: (self: Scope, fn: () -> ()) -> (),
	delay: (self: Scope, t: number, fn: () -> ()) -> thread,
	Destroy: (self: Scope) -> (),
	alive: boolean,
}

local Scope = {}
Scope.__index = Scope

local live = 0 -- diagnostic: number of scopes alive (read by the gallery's leak check)

function Scope.new(): Scope
	live += 1
	return setmetatable({ _items = {}, alive = true }, Scope) :: any
end

function Scope.liveCount(): number
	return live
end

local function release(item: any)
	local t = typeof(item)
	if t == "RBXScriptConnection" then
		item:Disconnect()
	elseif t == "Instance" then
		if item:IsA("Tween") then
			item:Cancel()
		end
		item:Destroy()
	elseif t == "thread" then
		if coroutine.status(item) ~= "dead" then
			pcall(task.cancel, item)
		end
	elseif t == "function" then
		item()
	elseif t == "table" then
		local d = item.Destroy or item.destroy or item.Disconnect
		if d then
			d(item)
		end
	end
end

function Scope:add(item)
	if not self.alive then
		release(item)
		return item
	end
	table.insert(self._items, item)
	return item
end

function Scope:connect(signal, fn)
	return self:add(signal:Connect(fn))
end

function Scope:child()
	local c = Scope.new()
	self:add(c)
	return c
end

function Scope:defer(fn)
	self:add(fn)
end

function Scope:delay(t, fn)
	return self:add(task.delay(t, fn))
end

function Scope:Destroy()
	if not self.alive then
		return
	end
	self.alive = false
	live -= 1
	local items = self._items
	self._items = {}
	for i = #items, 1, -1 do
		release(items[i])
	end
end

return Scope
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX17"><Properties><string name="Name">Signal</string><ProtectedString name="Source"><![CDATA[--!strict
-- Minimal synchronous signal for component events (onChanged, onSelect, ...).
export type Connection = { Disconnect: (self: Connection) -> (), connected: boolean }
export type Signal<T...> = {
	Connect: (self: Signal<T...>, fn: (T...) -> ()) -> Connection,
	Fire: (self: Signal<T...>, T...) -> (),
	Destroy: (self: Signal<T...>) -> (),
}

local Signal = {}
Signal.__index = Signal

local live = 0
function Signal.listenerCount(): number
	return live
end

function Signal.new<T...>(): Signal<T...>
	return setmetatable({ _fns = {} }, Signal) :: any
end

function Signal:Connect(fn)
	local conn
	conn = {
		connected = true,
		Disconnect = function(c)
			if c.connected then
				c.connected = false
				live -= 1
				local i = table.find(self._fns, fn)
				if i then
					table.remove(self._fns, i)
				end
			end
		end,
	}
	live += 1
	table.insert(self._fns, fn)
	return conn
end

function Signal:Fire(...)
	for _, fn in table.clone(self._fns) do
		fn(...)
	end
end

function Signal:Destroy()
	live -= #self._fns
	table.clear(self._fns)
end

return Signal
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX18"><Properties><string name="Name">Store</string><ProtectedString name="Source"><![CDATA[--!strict
-- Store: predictable local state for a widget. One table, immutable-style updates, subscribers called
-- after each commit with (state, previous). Widgets render from state; user input only calls actions.
local Signal = require(script.Parent.Signal)

export type Store<S> = {
	get: (self: Store<S>) -> S,
	set: (self: Store<S>, patch: { [string]: any }) -> (),
	update: (self: Store<S>, fn: (S) -> S) -> (),
	subscribe: (self: Store<S>, fn: (S, S) -> ()) -> { Disconnect: (any) -> () },
	reset: (self: Store<S>) -> (),
	Destroy: (self: Store<S>) -> (),
}

local Store = {}
Store.__index = Store

-- A patch value meaning "remove this key": nil cannot be expressed in a patch table.
Store.NONE = table.freeze({})

local function deepCopy(v: any): any
	if type(v) ~= "table" then
		return v
	end
	local t = {}
	for k, x in v do
		t[k] = deepCopy(x)
	end
	return t
end
Store.copy = deepCopy

function Store.new<S>(initial: S): Store<S>
	local self = setmetatable({
		_initial = deepCopy(initial),
		_state = deepCopy(initial),
		_changed = Signal.new(),
	}, Store)
	return self :: any
end

function Store:get()
	return self._state
end

function Store:_commit(nextState)
	local prev = self._state
	self._state = nextState
	self._changed:Fire(nextState, prev)
end

function Store:set(patch)
	local nextState = table.clone(self._state)
	for k, v in patch do
		if v == Store.NONE then
			nextState[k] = nil
		else
			nextState[k] = v
		end
	end
	self:_commit(nextState)
end

function Store:update(fn)
	self:_commit(fn(table.clone(self._state)))
end

function Store:subscribe(fn)
	return self._changed:Connect(fn)
end

function Store:reset()
	self:_commit(deepCopy(self._initial))
end

function Store:Destroy()
	self._changed:Destroy()
end

return Store
]]></ProtectedString></Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="RBX25"><Properties><string name="Name">Data</string></Properties>
      <Item class="ModuleScript" referent="RBX20"><Properties><string name="Name">Character</string><ProtectedString name="Source"><![CDATA[--!strict
-- Example character for the equipment / character components. The derived numbers are display sums
-- (base + attributes + gear) so the panels have something consistent to show; there is no combat model.
local Items = require(script.Parent.Items)

local Character = {}

function Character.example()
	return {
		name = "Elowen Vey",
		title = "Warden of the Ashen Gate",
		class = "Warden",
		crest = "ward",
		level = 23,
		xp = 7420,
		xpNext = 9800,
		points = 3,
		attributes = { might = 14, finesse = 11, arcana = 8, vigor = 16 },
		equipped = {
			head = "iron_helm",
			chest = "sunforged_plate",
			back = "dusk_cloak",
			hands = "traveler_gloves",
			feet = "striders",
			waist = "guild_belt",
			ring = "ring_embers",
			mainhand = "dawnsteel_blade",
			offhand = "oakheart_shield",
		},
		-- items in the bag that can be equipped (by slot)
		stash = { "emberfang", "galeheart_bow", "warden_mace", "woodcutter_axe", "staff_tides", "ashwood_wand", "amulet_stars" },
	}
end

Character.attributeInfo = {
	{ id = "might", name = "Might", glyph = "sword_small", text = "+2 Power and +5 Health per point." },
	{ id = "finesse", name = "Finesse", glyph = "bolt", text = "+0.4% Critical and +2 Stamina per point." },
	{ id = "arcana", name = "Arcana", glyph = "sparkle", text = "+8 Mana and +0.3% Haste per point." },
	{ id = "vigor", name = "Vigor", glyph = "heart", text = "+15 Health and +1 Armor per point." },
}

-- Derived display stats.
function Character.derive(ch): { [string]: number }
	local a = table.clone(ch.attributes)
	local gear = { power = 0, armor = 0, crit = 0, haste = 0 }
	for _, id in ch.equipped do
		local it = Items.get(id)
		for k, v in it.stats or {} do
			if a[k] ~= nil then
				a[k] += v
			elseif gear[k] ~= nil then
				gear[k] += v
			end
		end
	end
	return {
		might = a.might,
		finesse = a.finesse,
		arcana = a.arcana,
		vigor = a.vigor,
		power = gear.power + a.might * 2,
		armor = gear.armor + a.vigor,
		crit = math.floor((5 + gear.crit + a.finesse * 0.4) * 10 + 0.5) / 10,
		haste = math.floor((gear.haste + a.arcana * 0.3) * 10 + 0.5) / 10,
		health = 400 + a.might * 5 + a.vigor * 15,
		mana = 200 + a.arcana * 8,
		stamina = 100 + a.finesse * 2,
	}
end

Character.derivedOrder = {
	{ id = "health", name = "Health", glyph = "heart" },
	{ id = "mana", name = "Mana", glyph = "drop" },
	{ id = "stamina", name = "Stamina", glyph = "bolt" },
	{ id = "power", name = "Power", glyph = "sword_small" },
	{ id = "armor", name = "Armor", glyph = "shield_small" },
	{ id = "crit", name = "Critical", glyph = "star", pct = true },
	{ id = "haste", name = "Haste", glyph = "hourglass", pct = true },
}

Character.effects = {
	{ id = "blessed", name = "Blessing of Dawn", icon = "smite", kind = "buff", duration = 120, text = "+10% healing received." },
	{ id = "haste", name = "Quickened", icon = "haste", kind = "buff", duration = 18, text = "+15% movement speed." },
	{ id = "regen", name = "Regeneration", icon = "regen", kind = "buff", duration = 30, stacks = 3, text = "Restores 12 health per second per stack." },
	{ id = "ward", name = "Arcane Ward", icon = "ward", kind = "buff", duration = 45, text = "Absorbs the next 220 damage." },
	{ id = "burning", name = "Burning", icon = "fireball", kind = "debuff", duration = 8, stacks = 2, text = "Takes fire damage every second." },
	{ id = "poison", name = "Witherbloom Poison", icon = "poison", kind = "debuff", duration = 14, text = "−25% healing received." },
	{ id = "chilled", name = "Chilled", icon = "frost_shard", kind = "debuff", duration = 6, text = "−20% attack speed." },
}

return Character
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX21"><Properties><string name="Name">Items</string><ProtectedString name="Source"><![CDATA[--!strict
-- Example item catalogue for the demos. Local data only: no inventory service, no persistence.
-- stats: might, finesse, arcana, vigor (attributes); armor, power, crit (%), haste (%)

export type Item = {
	id: string,
	name: string,
	icon: string,
	rarity: string,
	kind: "weapon" | "armor" | "trinket" | "consumable" | "material" | "quest",
	slot: string?,
	type: string, -- display type ("One-handed sword")
	level: number,
	stats: { [string]: number }?,
	effect: string?,
	lore: string?,
	value: number, -- gold
	weight: number,
	stack: number?, -- max stack size
}

local Items = {}

Items.statNames = {
	power = "Power",
	armor = "Armor",
	might = "Might",
	finesse = "Finesse",
	arcana = "Arcana",
	vigor = "Vigor",
	crit = "Critical",
	haste = "Haste",
}
Items.statOrder = { "power", "armor", "might", "finesse", "arcana", "vigor", "crit", "haste" }
Items.percentStats = { crit = true, haste = true }

Items.slots = {
	{ id = "head", name = "Head", glyph = "user" },
	{ id = "neck", name = "Neck", glyph = "gem" },
	{ id = "back", name = "Back", glyph = "shield_small" },
	{ id = "chest", name = "Chest", glyph = "shield_small" },
	{ id = "hands", name = "Hands", glyph = "hammer" },
	{ id = "waist", name = "Waist", glyph = "bag" },
	{ id = "feet", name = "Feet", glyph = "compass" },
	{ id = "ring", name = "Ring", glyph = "gem" },
	{ id = "mainhand", name = "Main hand", glyph = "sword_small" },
	{ id = "offhand", name = "Off hand", glyph = "shield_small" },
}

local list: { Item } = {
	-- weapons
	{ id = "dawnsteel_blade", name = "Dawnsteel Blade", icon = "sword", rarity = "rare", kind = "weapon", slot = "mainhand", type = "One-handed sword", level = 18, stats = { power = 42, might = 6, crit = 4 }, lore = "Forged at first light; it remembers the sun.", value = 340, weight = 3.2 },
	{ id = "emberfang", name = "Emberfang", icon = "dagger", rarity = "epic", kind = "weapon", slot = "mainhand", type = "Dagger", level = 20, stats = { power = 38, finesse = 11, crit = 9 }, effect = "Hits ignite the target for 3s.", lore = "Still warm, a century after the dragon died.", value = 780, weight = 1.1 },
	{ id = "woodcutter_axe", name = "Woodcutter's Axe", icon = "axe", rarity = "common", kind = "weapon", slot = "mainhand", type = "One-handed axe", level = 4, stats = { power = 14, might = 2 }, value = 22, weight = 3.8 },
	{ id = "warden_mace", name = "Warden's Mace", icon = "mace", rarity = "uncommon", kind = "weapon", slot = "mainhand", type = "Mace", level = 12, stats = { power = 30, might = 5, vigor = 3 }, value = 120, weight = 4.6 },
	{ id = "galeheart_bow", name = "Galeheart Bow", icon = "bow", rarity = "legendary", kind = "weapon", slot = "mainhand", type = "Longbow", level = 24, stats = { power = 58, finesse = 16, haste = 8, crit = 6 }, effect = "Every fifth arrow splits in three.", lore = "Strung with a hair from the north wind.", value = 2400, weight = 2.4 },
	{ id = "staff_tides", name = "Staff of Low Tides", icon = "staff", rarity = "epic", kind = "weapon", slot = "mainhand", type = "Staff", level = 21, stats = { power = 34, arcana = 18, haste = 5 }, effect = "Spells cost 10% less mana.", value = 860, weight = 3.0 },
	{ id = "ashwood_wand", name = "Ashwood Wand", icon = "wand", rarity = "uncommon", kind = "weapon", slot = "offhand", type = "Wand", level = 10, stats = { arcana = 7, crit = 2 }, value = 96, weight = 0.6 },
	{ id = "oakheart_shield", name = "Oakheart Shield", icon = "shield", rarity = "rare", kind = "armor", slot = "offhand", type = "Shield", level = 16, stats = { armor = 46, vigor = 7 }, lore = "Cut from the oak that sheltered the first keep.", value = 290, weight = 6.5 },
	-- armour
	{ id = "iron_helm", name = "Ironbound Helm", icon = "helm", rarity = "uncommon", kind = "armor", slot = "head", type = "Plate helm", level = 14, stats = { armor = 22, vigor = 4 }, value = 110, weight = 4.0 },
	{ id = "sunforged_plate", name = "Sunforged Plate", icon = "chestplate", rarity = "epic", kind = "armor", slot = "chest", type = "Plate armour", level = 22, stats = { armor = 74, might = 9, vigor = 12 }, effect = "+15% healing received.", value = 1350, weight = 14.0 },
	{ id = "traveler_gloves", name = "Traveller's Gloves", icon = "gloves", rarity = "common", kind = "armor", slot = "hands", type = "Leather gloves", level = 6, stats = { armor = 6, finesse = 2 }, value = 18, weight = 0.8 },
	{ id = "striders", name = "Mistwalker Striders", icon = "boots", rarity = "rare", kind = "armor", slot = "feet", type = "Leather boots", level = 17, stats = { armor = 18, finesse = 6, haste = 4 }, value = 260, weight = 1.6 },
	{ id = "dusk_cloak", name = "Duskweave Cloak", icon = "cloak", rarity = "rare", kind = "armor", slot = "back", type = "Cloak", level = 18, stats = { armor = 12, finesse = 5, arcana = 5 }, value = 240, weight = 1.2 },
	{ id = "guild_belt", name = "Guildmaster's Belt", icon = "belt", rarity = "uncommon", kind = "armor", slot = "waist", type = "Belt", level = 11, stats = { armor = 8, vigor = 5 }, value = 84, weight = 0.9 },
	-- trinkets
	{ id = "ring_embers", name = "Ring of Embers", icon = "ring", rarity = "epic", kind = "trinket", slot = "ring", type = "Ring", level = 19, stats = { arcana = 9, crit = 5 }, effect = "Fire spells chain to one extra foe.", value = 920, weight = 0.1 },
	{ id = "amulet_stars", name = "Amulet of the Seventh Star", icon = "amulet", rarity = "mythic", kind = "trinket", slot = "neck", type = "Amulet", level = 25, stats = { arcana = 20, vigor = 10, haste = 10, crit = 7 }, effect = "Once per hour, cheat death.", lore = "The seventh star fell. This is where it landed.", value = 9999, weight = 0.2 },
	-- consumables
	{ id = "potion_health", name = "Healing Draught", icon = "potion_health", rarity = "common", kind = "consumable", type = "Potion", level = 1, effect = "Restores 250 health over 5s.", value = 12, weight = 0.3, stack = 20 },
	{ id = "potion_mana", name = "Mana Tonic", icon = "potion_mana", rarity = "common", kind = "consumable", type = "Potion", level = 1, effect = "Restores 180 mana over 5s.", value = 14, weight = 0.3, stack = 20 },
	{ id = "potion_stamina", name = "Stamina Brew", icon = "potion_stamina", rarity = "uncommon", kind = "consumable", type = "Potion", level = 5, effect = "Stamina regenerates 50% faster for 30s.", value = 30, weight = 0.3, stack = 20 },
	{ id = "elixir_valor", name = "Elixir of Valour", icon = "elixir", rarity = "rare", kind = "consumable", type = "Elixir", level = 15, effect = "+8 to all attributes for 10 minutes.", value = 150, weight = 0.4, stack = 5 },
	{ id = "scroll_recall", name = "Scroll of Recall", icon = "scroll", rarity = "uncommon", kind = "consumable", type = "Scroll", level = 1, effect = "Returns you to the last waystone.", value = 40, weight = 0.1, stack = 10 },
	{ id = "travel_bread", name = "Traveller's Bread", icon = "bread", rarity = "common", kind = "consumable", type = "Food", level = 1, effect = "Restores 60 stamina.", value = 3, weight = 0.2, stack = 40 },
	-- materials
	{ id = "iron_ore", name = "Iron Ore", icon = "ore", rarity = "common", kind = "material", type = "Crafting material", level = 1, value = 4, weight = 1.0, stack = 99 },
	{ id = "steel_ingot", name = "Steel Ingot", icon = "ingot", rarity = "uncommon", kind = "material", type = "Crafting material", level = 1, value = 18, weight = 1.0, stack = 99 },
	{ id = "moonpetal", name = "Moonpetal", icon = "herb", rarity = "uncommon", kind = "material", type = "Herb", level = 1, lore = "Only opens under a full moon.", value = 9, weight = 0.1, stack = 99 },
	{ id = "glowcap", name = "Glowcap", icon = "mushroom", rarity = "common", kind = "material", type = "Fungus", level = 1, value = 5, weight = 0.1, stack = 99 },
	{ id = "emberstone", name = "Emberstone", icon = "gem_ruby", rarity = "rare", kind = "material", type = "Gem", level = 1, value = 85, weight = 0.2, stack = 50 },
	{ id = "tidestone", name = "Tidestone", icon = "gem_sapphire", rarity = "rare", kind = "material", type = "Gem", level = 1, value = 85, weight = 0.2, stack = 50 },
	{ id = "aether_crystal", name = "Aether Crystal", icon = "crystal", rarity = "epic", kind = "material", type = "Reagent", level = 1, value = 260, weight = 0.3, stack = 25 },
	{ id = "tanned_leather", name = "Tanned Leather", icon = "leather", rarity = "common", kind = "material", type = "Crafting material", level = 1, value = 6, weight = 0.5, stack = 99 },
	{ id = "silk_thread", name = "Silk Thread", icon = "thread", rarity = "common", kind = "material", type = "Crafting material", level = 1, value = 4, weight = 0.1, stack = 99 },
	{ id = "ironwood", name = "Ironwood Plank", icon = "wood", rarity = "common", kind = "material", type = "Crafting material", level = 1, value = 5, weight = 1.5, stack = 99 },
	{ id = "griffon_feather", name = "Griffon Feather", icon = "feather", rarity = "rare", kind = "material", type = "Crafting material", level = 1, value = 60, weight = 0.1, stack = 50 },
	-- quest
	{ id = "vault_key", name = "Sunken Vault Key", icon = "key", rarity = "legendary", kind = "quest", type = "Quest item", level = 1, lore = "The lock it opens is under forty fathoms of water.", value = 0, weight = 0.2 },
	{ id = "old_map", name = "Cartographer's Map", icon = "map", rarity = "uncommon", kind = "quest", type = "Quest item", level = 1, lore = "Someone circled a spot in red ink.", value = 0, weight = 0.1 },
	{ id = "tome_ash", name = "Tome of Ash", icon = "tome", rarity = "epic", kind = "quest", type = "Quest item", level = 1, value = 0, weight = 1.4 },
}

local byId: { [string]: Item } = {}
for _, it in list do
	byId[it.id] = it
end
Items.list = list

function Items.get(id: string): Item
	local it = byId[id]
	assert(it, "unknown item " .. id)
	return it
end

function Items.formatStat(key: string, v: number): string
	local sign = if v >= 0 then "+" else "−"
	return `{sign}{math.abs(v)}{if Items.percentStats[key] then "%" else ""} {Items.statNames[key] or key}`
end

-- Rough item score used by sorting and the comparison arrows.
function Items.score(it: Item): number
	local s = 0
	for _, v in it.stats or {} do
		s += v
	end
	return s
end

return Items
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX22"><Properties><string name="Name">Quests</string><ProtectedString name="Source"><![CDATA[--!strict
-- Example quests and achievements for the progression components (local data; no quest engine).
local Quests = {}

Quests.types = {
	main = { name = "Main story", color = Color3.fromHex("F2A93B"), glyph = "crown" },
	side = { name = "Side quest", color = Color3.fromHex("6FB3EE"), glyph = "scroll_small" },
	daily = { name = "Daily", color = Color3.fromHex("57D1C4"), glyph = "hourglass" },
	guild = { name = "Guild contract", color = Color3.fromHex("B472EE"), glyph = "shield_small" },
}

Quests.list = {
	{
		id = "ashen_gate",
		title = "The Ashen Gate",
		type = "main",
		level = 23,
		region = "Cindervale",
		tracked = true,
		status = "active",
		text = "The gate that held the cinder-wyrms for a century is failing. Gather what the old wardens left behind and find out who broke the seals.",
		objectives = {
			{ text = "Recover the warden's journals", current = 3, target = 4 },
			{ text = "Inspect the broken seals", current = 2, target = 2 },
			{ text = "Report to the gatekeeper", current = 0, target = 1 },
		},
		rewards = { xp = 2400, gold = 350, items = { { id = "emberfang", count = 1 }, { id = "potion_health", count = 5 } } },
	},
	{
		id = "moonpetal",
		title = "Moonpetal Harvest",
		type = "side",
		level = 19,
		region = "Silverfen",
		tracked = true,
		status = "active",
		text = "The apothecary needs moonpetals for a fever draught. They only open at night.",
		objectives = {
			{ text = "Gather moonpetals", current = 7, target = 10 },
			{ text = "Avoid waking the fen-lurkers", current = 1, target = 1, optional = true },
		},
		rewards = { xp = 900, gold = 120, items = { { id = "elixir_valor", count = 2 } } },
	},
	{
		id = "bounty",
		title = "Bounty: The Hollow Stag",
		type = "guild",
		level = 22,
		region = "Duskwood",
		tracked = false,
		status = "ready",
		text = "A stag that walks without a heartbeat haunts the old road. The guild pays well for proof.",
		objectives = {
			{ text = "Find the Hollow Stag's trail", current = 1, target = 1 },
			{ text = "Bring back an antler", current = 1, target = 1 },
		},
		rewards = { xp = 1600, gold = 500, items = { { id = "griffon_feather", count = 3 } } },
	},
	{
		id = "daily_forge",
		title = "Stoke the Forge",
		type = "daily",
		level = 10,
		region = "Ironhold",
		tracked = false,
		status = "active",
		text = "The forge-master needs fuel and ore before dawn.",
		objectives = {
			{ text = "Deliver iron ore", current = 14, target = 20 },
			{ text = "Deliver ironwood planks", current = 5, target = 5 },
		},
		rewards = { xp = 400, gold = 60, items = { { id = "steel_ingot", count = 4 } } },
	},
	{
		id = "lighthouse",
		title = "Light at Sorrow's End",
		type = "side",
		level = 15,
		region = "Saltmere",
		tracked = false,
		status = "complete",
		text = "The keeper's lamp is lit again; ships no longer break on the rocks.",
		objectives = {
			{ text = "Repair the lens", current = 1, target = 1 },
			{ text = "Light the lamp", current = 1, target = 1 },
		},
		rewards = { xp = 700, gold = 90, items = {} },
	},
	{
		id = "drowned_vault",
		title = "The Drowned Vault",
		type = "main",
		level = 26,
		region = "Saltmere",
		tracked = false,
		status = "locked",
		text = "Requires level 26 and completion of “The Ashen Gate”.",
		objectives = {},
		rewards = { xp = 3200, gold = 600, items = { { id = "vault_key", count = 1 } } },
	},
}

function Quests.get(id: string)
	for _, q in Quests.list do
		if q.id == id then
			return q
		end
	end
	error("unknown quest " .. id)
end

Quests.achievements = {
	{ id = "first_blood", title = "First Steps", text = "Complete your first quest.", icon = "scroll", points = 10, unlocked = true, date = "Day 1", rarity = 92 },
	{ id = "hoarder", title = "Dragon's Hoard", text = "Hold 10,000 gold at once.", icon = "coin_pouch", points = 25, current = 1840, target = 10000, rarity = 11 },
	{ id = "cartographer", title = "Cartographer", text = "Discover every region of the Vale.", icon = "map", points = 25, current = 9, target = 12, rarity = 23 },
	{ id = "untouchable", title = "Untouchable", text = "Defeat a warden-captain without taking damage.", icon = "ward", points = 50, unlocked = true, date = "Day 14", rarity = 4 },
	{ id = "mythsmith", title = "Mythsmith", text = "Craft an item of mythic rarity.", icon = "ingot", points = 100, locked = true, hidden = false, rarity = 1 },
	{ id = "secret", title = "???", text = "A hidden achievement. Keep exploring.", icon = "key", points = 50, locked = true, hidden = true, rarity = 2 },
}

return Quests
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX23"><Properties><string name="Name">Recipes</string><ProtectedString name="Source"><![CDATA[--!strict
-- Example recipes, material stock and a vendor list for the crafting and commerce components.
local Recipes = {}

Recipes.categories = { "Smithing", "Alchemy", "Tailoring" }

Recipes.list = {
	{ id = "r_dawnsteel", category = "Smithing", result = "dawnsteel_blade", count = 1, time = 2.4, level = 18, materials = { { id = "steel_ingot", need = 6 }, { id = "emberstone", need = 1 }, { id = "tanned_leather", need = 2 } } },
	{ id = "r_helm", category = "Smithing", result = "iron_helm", count = 1, time = 1.8, level = 14, materials = { { id = "steel_ingot", need = 4 }, { id = "tanned_leather", need = 1 } } },
	{ id = "r_shield", category = "Smithing", result = "oakheart_shield", count = 1, time = 2.0, level = 16, materials = { { id = "ironwood", need = 5 }, { id = "steel_ingot", need = 2 } } },
