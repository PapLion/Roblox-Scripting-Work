    </Item>
    <Item class="ModuleScript" referent="RBX37"><Properties><string name="Name">Registry</string><ProtectedString name="Source"><![CDATA[--!strict
-- Registry: every specimen in the gallery, grouped by family. A specimen is a standalone component (or a
-- small family of states) with its natural canvas size, a build function, optional actions to drive its
-- states and a reset (rebuilding from the example data).
export type Action = { label: string, run: () -> () }
export type Built = { actions: { Action }?, onReset: (() -> ())? }
export type Specimen = {
	id: string,
	family: string,
	title: string,
	blurb: string,
	size: Vector2, -- natural canvas size in px (before stage scaling)
	build: (scope: any, parent: Frame, ctx: { [string]: any }) -> Built?,
}

local Registry = {}

Registry.families = {
	{ id = "controls", title = "Buttons & Controls" },
	{ id = "inventory", title = "Inventory" },
	{ id = "character", title = "Character & Equipment" },
	{ id = "skills", title = "Skills & Abilities" },
	{ id = "quests", title = "Quests & Progression" },
	{ id = "commerce", title = "Crafting & Commerce" },
	{ id = "feedback", title = "Feedback & Overlays" },
}

local list: { Specimen } = {}
local byId: { [string]: Specimen } = {}

for _, m in script.Parent.Specimens:GetChildren() do
	if m:IsA("ModuleScript") then
		for _, s in require(m) :: { Specimen } do
			assert(not byId[s.id], "duplicate specimen " .. s.id)
			byId[s.id] = s
			table.insert(list, s);
			(s :: any).order = #list
		end
	end
end

local famIndex = {}
for i, f in Registry.families do
	famIndex[f.id] = i
end
table.sort(list, function(a, b)
	local fa, fb = famIndex[a.family] or 99, famIndex[b.family] or 99
	if fa ~= fb then
		return fa < fb
	end
	return (a :: any).order < (b :: any).order
end)

Registry.list = list
function Registry.get(id: string): Specimen?
	return byId[id]
end
function Registry.inFamily(fid: string): { Specimen }
	local out = {}
	for _, s in list do
		if s.family == fid then
			table.insert(out, s)
		end
	end
	return out
end

return Registry
]]></ProtectedString></Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX38"><Properties><string name="Name">Stage</string><ProtectedString name="Source"><![CDATA[--!strict
-- Stage: renders one specimen in isolation. The specimen sits on a neutral canvas (its natural size plus
-- a margin) centred in the viewport and scaled to fit with a UIScale, so it is rendered sharply at the
-- largest size the window allows. The overlay layer (tooltips, menus, modals, toasts) lives inside the
-- canvas, so popovers belong to the capture too.
--
-- Capture mode paints the surroundings with a magenta matte; tools/boardcap.py finds the canvas edge on
-- that matte and crops the PrintWindow capture to exactly the canvas.
local Lib = require(script.Parent.Lib)
local Theme = require(Lib.Theme)
local Create = require(Lib.Core.Create)
local Scope = require(Lib.Core.Scope)
local Layers = require(Lib.Core.Layers)
local Registry = require(script.Parent.Registry)

local Stage = {}

Stage.MATTE = Color3.fromRGB(255, 0, 255)
Stage.CANVAS = Color3.fromHex("16130F") -- warm neutral charcoal
Stage.MARGIN = 36

export type Mounted = {
	scope: any,
	canvas: Frame,
	content: Frame,
	scale: UIScale,
	specimen: any,
	built: any,
	fit: () -> (),
}

-- Mount a specimen into `host` (a full-size frame). opts: capture (matte), maxScale, insets {l,t,r,b}
function Stage.mount(host: GuiObject | LayerCollector, specimen: any, opts: { [string]: any }?): Mounted
	local o = opts or {}
	local scope = Scope.new()
	local margin = o.margin or Stage.MARGIN
	local natural = specimen.size + Vector2.new(margin * 2, margin * 2)

	local area = Create.box({ Name = "StageArea", Size = UDim2.fromScale(1, 1), Parent = host })
	scope:add(area)
	if o.capture then
		area.BackgroundTransparency = 0
		area.BackgroundColor3 = Stage.MATTE
	end
	local ins = o.insets or { 0, 0, 0, 0 }
	local slot = Create.box({
		Name = "Slot",
		Position = UDim2.fromOffset(ins[1], ins[2]),
		Size = UDim2.new(1, -(ins[1] + ins[3]), 1, -(ins[2] + ins[4])),
		Parent = area,
	})

	-- Tiled capture: the slot becomes a clipped window filled with the canvas colour; the canvas is
	-- pinned top-left at a fixed scale and moved by setTile(), so a specimen larger than the viewport is
	-- rendered in pieces that tools/capture/tiles.py stitches back together.
	if o.tiled then
		slot.BackgroundTransparency = 0
		slot.BackgroundColor3 = Stage.CANVAS
		-- No ClipsDescendants here: the engine culls large clipped 9-slice / gradient frames that cross the
		-- clip edge. Matte masks around the window hide the overflow instead.
		for _, r in {
			{ UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 0, ins[2]) },
			{ UDim2.new(0, 0, 1, -ins[4]), UDim2.new(1, 0, 0, ins[4] + 2000) },
			{ UDim2.new(0, 0, 0, 0), UDim2.new(0, ins[1], 1, 2000) },
			{ UDim2.new(1, -ins[3], 0, 0), UDim2.new(0, ins[3] + 2000, 1, 2000) },
		} do
			Create("Frame", { Name = "Mask", BorderSizePixel = 0, BackgroundColor3 = Stage.MATTE, Position = r[1], Size = r[2], ZIndex = 20000, Parent = area })
		end
	end
	local canvas = Create("Frame", {
		Name = "Canvas",
		AnchorPoint = if o.tiled then Vector2.zero else Vector2.new(0.5, 0.5),
		Position = if o.tiled then UDim2.new() else UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(natural.X, natural.Y),
		BackgroundColor3 = Stage.CANVAS,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = slot,
	})
	if not o.capture then
		Create.corner(10).Parent = canvas
		Create.stroke(Color3.fromHex("2A231C"), 1, 0).Parent = canvas
	end
	-- soft vignette keeps the neutral ground from looking flat
	Create("Frame", {
		Name = "Vignette",
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 0,
		Parent = canvas,
	}, {
		Create("UIGradient", {
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(0.5, 1), NumberSequenceKeypoint.new(1, 0.55) }),
			Rotation = 90,
		}),
	})
	local scale = Create.scale(1)
	scale.Parent = canvas

	local content = Create.box({
		Name = "Specimen",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(specimen.size.X, specimen.size.Y),
		Parent = canvas,
	})
	Layers.mount(canvas, 1000)

	local function fit()
		local avail = slot.AbsoluteSize
		if o.tiled then
			scale.Scale = o.fixedScale or 2
			return
		end
		if avail.X <= 0 then
			return
		end
		local s = math.min(avail.X / natural.X, avail.Y / natural.Y, o.maxScale or 2)
		scale.Scale = s
	end
	scope:connect(slot:GetPropertyChangedSignal("AbsoluteSize"), fit)
	fit()

	local ctx = { capture = o.capture == true, stageScope = scope }
	local built = specimen.build(scope, content, ctx) or {}

	-- six marker squares above the window's top-right corner encode the tile index (63 = done)
	-- row 1 (lower) = tile index, row 2 (upper) = batch job index
	local markers, jobMarkers = {}, {}
	if o.tiled then
		for i = 1, 6 do
			for row, list in { markers, jobMarkers } do
				list[i] = Create("Frame", {
					Name = "Marker" .. row .. "_" .. i,
					BorderSizePixel = 0,
					AnchorPoint = Vector2.new(1, 1),
					Position = UDim2.new(1, -(16 + (i - 1) * 24) - ins[3], 0, ins[2] - 16 - (row - 1) * 24),
					Size = UDim2.fromOffset(16, 16),
					BackgroundColor3 = Color3.new(0, 0, 0),
					ZIndex = 20001,
					Parent = area,
				})
			end
		end
	end
	if o.capture then
		-- input shield: the real pointer must not hover anything while a capture is being taken
		Create("TextButton", { Name = "CaptureShield", Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 10000, Parent = area })
	end
	local function setTile(tx: number, ty: number)
		canvas.Position = UDim2.fromOffset(-tx, -ty)
	end
	local function marker(index: number, job: number?)
		for i = 1, 6 do
			markers[i].BackgroundColor3 = if bit32.extract(index, i - 1) == 1 then Color3.new(1, 1, 1) else Color3.new(0, 0, 0)
			jobMarkers[i].BackgroundColor3 = if bit32.extract(job or 0, i - 1) == 1 then Color3.new(1, 1, 1) else Color3.new(0, 0, 0)
		end
	end

	return {
		setTile = setTile,
		marker = marker,
		slot = slot,
		scope = scope,
		canvas = canvas,
		content = content,
		scale = scale,
		specimen = specimen,
		built = built,
		fit = fit,
	} :: any
end

-- Edit-mode preview used by tools/preview.luau
function Stage.preview(gui: ScreenGui, opts: { [string]: any }): (any, string)
	local id = opts.id or Registry.list[1].id
	local specimen = Registry.get(id)
	assert(specimen, "unknown specimen " .. tostring(id))
	local host = Create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromHex("0C0A08"), BorderSizePixel = 0, Parent = gui })
	local m = Stage.mount(host, specimen, { capture = opts.capture, maxScale = opts.maxScale or 1.6 })
	if opts.action and m.built.actions then
		for _, a in m.built.actions do
			if a.label == opts.action then
				a.run()
			end
		end
	end
	return m.scope, `{id} {specimen.size.X}x{specimen.size.Y} scale {string.format("%.2f", m.scale.Scale)}`
end

return Stage
]]></ProtectedString></Properties>
    </Item>
    <Item class="Folder" referent="RBX46"><Properties><string name="Name">Specimens</string></Properties>
      <Item class="ModuleScript" referent="RBX39"><Properties><string name="Name">Character</string><ProtectedString name="Source"><![CDATA[--!strict
-- Character & Equipment specimens.
local Lib = require(script.Parent.Parent.Lib)
local Create = require(Lib.Core.Create)
local Character = require(Lib.Widgets.Character)
local Feedback = require(Lib.Components.Feedback)

return {
	{
		id = "character-card",
		family = "character",
		title = "Character card & vitals",
		blurb = "Crest portrait with an experience ring, class and points tags, health, mana and stamina bars with damage trails, and experience.",
		size = Vector2.new(400, 380),
		build = function(scope, parent)
			local card = Character.card(scope, { width = 400 })
			card.Instance.Parent = parent
			local v = card.vitals
			return {
				onReset = function()
					v.reset()
				end,
				actions = {
					{ label = "Take 180 damage", run = function()
						v:damage(180)
					end },
					{ label = "Heal 120", run = function()
						v:heal(120)
					end },
					{ label = "Cast (−60 mana)", run = function()
						v:cast(60)
					end },
					{ label = "Sprint (−35%)", run = function()
						v:sprint(35)
					end },
					{ label = "Gain 900 XP", run = function()
						v:gainXp(900)
					end },
					{ label = "Gain 3000 XP (level up)", run = function()
						v:gainXp(3000)
					end },
					{ label = "Restore", run = function()
						v:restore()
					end },
				},
			}
		end,
	},
	{
		id = "status-effects",
		family = "character",
		title = "Status effects",
		blurb = "Blessings and afflictions with live radial timers, stacks and tooltips; refreshed effects add a stack.",
		size = Vector2.new(470, 100),
		build = function(scope, parent)
			local holder = Create.box({ Size = UDim2.fromScale(1, 1), Parent = parent }, { Create.list("y", 14) })
			local eff = Character.effects(scope, { effects = { "blessed", "haste", "regen", "ward", "burning", "poison", "chilled" }, layoutOrder = 1 })
			eff.Instance.Parent = holder
			return {
				onReset = function()
					eff:clear()
					for _, id in { "blessed", "haste", "regen", "ward", "burning", "poison", "chilled" } do
						eff:add(id)
					end
				end,
				actions = {
					{ label = "Stack Burning", run = function()
						eff:add("burning")
					end },
					{ label = "Freeze timers", run = function()
						eff:freeze(true)
					end },
					{ label = "Resume timers", run = function()
						eff:freeze(false)
					end },
				},
			}
		end,
	},
	{
		id = "equipment",
		family = "character",
		title = "Equipment & attributes",
		blurb = "Paperdoll slots with an item chooser, attribute point allocation with commit and undo, and derived stats that update as gear changes.",
		size = Vector2.new(880, 620),
		build = function(scope, parent)
			local eq = Character.equipment(scope)
			eq.Instance.Parent = parent
			return {
				onReset = eq.reset,
				actions = {
					{ label = "Equip Galeheart Bow", run = function()
						eq:equip("mainhand", "galeheart_bow")
					end },
					{ label = "Select neck slot", run = function()
						eq.store:set({ selected = "neck" })
					end },
					{ label = "Equip amulet", run = function()
						eq:equip("neck", "amulet_stars")
					end },
					{ label = "Assign 2 Might", run = function()
						eq.store:set({ pending = { might = 2, finesse = 0, arcana = 0, vigor = 0 } })
					end },
				},
			}
		end,
	},
}
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX40"><Properties><string name="Name">Commerce</string><ProtectedString name="Source"><![CDATA[--!strict
-- Crafting & Commerce specimens.
local Lib = require(script.Parent.Parent.Lib)
local Commerce = require(Lib.Widgets.Commerce)

return {
	{
		id = "crafting",
		family = "commerce",
		title = "Crafting station",
		blurb = "Recipe list with craftable counts, material requirements (have / need), quantity, timed crafting with cancel, and the missing-materials state.",
		size = Vector2.new(900, 580),
		build = function(scope, parent)
			local c = Commerce.crafting(scope)
			c.Instance.Parent = parent
			return {
				onReset = c.reset,
				actions = {
					{ label = "Select Sunforged Plate (missing)", run = function()
						c:select("r_plate")
					end },
					{ label = "Craft 1 Dawnsteel", run = function()
						c:select("r_dawnsteel")
						c.craft()
					end },
					{ label = "Steel ingots ×3", run = function()
						c:select("r_ingot", 3)
						c.craft()
					end },
				},
			}
		end,
	},
	{
		id = "vendor",
		family = "commerce",
		title = "Vendor",
		blurb = "Buy and sell modes, wallet, rarity-framed item cards with stock, discounts, sold-out and unaffordable prices.",
		size = Vector2.new(820, 500),
		build = function(scope, parent)
			local v = Commerce.vendor(scope)
			v.Instance.Parent = parent
			return {
				onReset = v.reset,
				actions = {
					{ label = "Buy Healing Draught", run = function()
						v:buy("potion_health")
					end },
					{ label = "Try Galeheart Bow", run = function()
						v:buy("galeheart_bow")
					end },
					{ label = "Sell mode", run = function()
						v.store:set({ mode = 2 })
					end },
				},
			}
		end,
	},
	{
		id = "purchase-dialog",
		family = "commerce",
		title = "Purchase confirmation",
		blurb = "Quantity slider, balance, total and the balance after purchase; the confirm button refuses when gold runs short.",
		size = Vector2.new(560, 470),
		build = function(scope, parent)
			-- the dialog over a real vendor, isolated: the vendor sits behind the dim
			local v = Commerce.vendor(scope)
			v.Instance.Visible = false
			v.Instance.Parent = parent
			task.defer(function()
				v:buy("potion_mana")
			end)
			return {
				onReset = function()
					v:buy("potion_mana")
				end,
				actions = {
					{ label = "Unaffordable item", run = function()
						v:buy("galeheart_bow")
					end },
				},
			}
		end,
	},
}
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX41"><Properties><string name="Name">Controls</string><ProtectedString name="Source"><![CDATA[--!strict
-- Buttons & Controls specimens.
local Lib = require(script.Parent.Parent.Lib)
local Theme = require(Lib.Theme)
local Create = require(Lib.Core.Create)
local Button = require(Lib.Components.Button)
local Controls = require(Lib.Components.Controls)
local Surface = require(Lib.Components.Surface)

local C = Theme.color

local function row(parent: Instance, order: number, h: number?, gap: number?): Frame
	return Create.box({ Size = UDim2.new(1, 0, 0, h or 40), LayoutOrder = order, Parent = parent }, { Create.list("x", gap or 14, nil, Enum.VerticalAlignment.Center) })
end

local STATES = {
	{ "Default", nil },
	{ "Hover", { hover = true } },
	{ "Pressed", { pressed = true, hover = true } },
	{ "Focused", { focused = true } },
	{ "Selected", { selected = true } },
	{ "Disabled", { disabled = true } },
	{ "Loading", { loading = true } },
}

return {
	{
		id = "buttons",
		family = "controls",
		title = "Button variants × states",
		blurb = "Gilded primary, leather secondary, ghost, danger and arcane buttons in every interaction state.",
		size = Vector2.new(1180, 400),
		build = function(scope, parent)
			local grid = Create.box({ Size = UDim2.fromScale(1, 1), Parent = parent }, { Create.list("y", 14) })
			-- column header
			local head = row(grid, 0, 18, 14)
			Create.box({ Size = UDim2.fromOffset(104, 18), LayoutOrder = 0, Parent = head })
			for i, st in STATES do
				Surface.text({ role = "caps", text = st[1], color = C.textFaint, Size = UDim2.fromOffset(140, 18), TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = i, Parent = head })
			end
			local handles = {}
			for r, variant in { "primary", "secondary", "ghost", "danger", "arcane" } do
				local line = row(grid, r, 52, 14)
				Surface.text({ role = "caps", text = variant, color = C.gold, Size = UDim2.fromOffset(104, 40), LayoutOrder = 0, Parent = line })
				for i, st in STATES do
					local cell = Create.box({ Size = UDim2.fromOffset(140, 52), LayoutOrder = i, Parent = line })
					local label = if variant == "danger" then "Abandon" elseif variant == "arcane" then "Enchant" elseif variant == "ghost" then "Details" elseif variant == "secondary" then "Inspect" else "Embark"
					local b = Button.new(scope, {
						text = label,
						variant = variant :: any,
						width = 132,
						icon = if variant == "primary" then "sword_small" elseif variant == "arcane" then "sparkle" elseif variant == "danger" then "trash" else nil,
						parent = cell,
					})
					b.Instance.AnchorPoint = Vector2.new(0.5, 0.5)
					b.Instance.Position = UDim2.fromScale(0.5, 0.5)
					if st[2] then
						b:force(st[2])
					end
					table.insert(handles, b)
				end
			end
			-- sizes + key hint row
			local sizes = row(grid, 9, 56, 18)
			Surface.text({ role = "caps", text = "sizes", color = C.gold, Size = UDim2.fromOffset(104, 40), LayoutOrder = 0, Parent = sizes })
			Button.new(scope, { text = "Small", size = "small", variant = "secondary", parent = sizes, layoutOrder = 1 })
			Button.new(scope, { text = "Medium", size = "medium", variant = "secondary", parent = sizes, layoutOrder = 2 })
			Button.new(scope, { text = "Large action", size = "large", variant = "primary", icon = "crown", parent = sizes, layoutOrder = 3 })
			Button.new(scope, { text = "Confirm", variant = "primary", keyHint = "Enter", parent = sizes, layoutOrder = 4 })
			Button.new(scope, { text = "Back", variant = "ghost", keyHint = "Bksp", parent = sizes, layoutOrder = 5 })
			return {
				actions = {
					{ label = "Live input", run = function()
						for _, h in handles do
							h:force(nil)
						end
					end },
				},
			}
		end,
	},
	{
		id = "controls",
		family = "controls",
		title = "Controls",
		blurb = "Icon buttons, toggles, checkboxes, radios, segmented control, slider, dropdown and search, with their states.",
		size = Vector2.new(980, 430),
		build = function(scope, parent)
			local cols = Create.box({ Size = UDim2.fromScale(1, 1), Parent = parent }, { Create.list("x", 28) })
			local function column(order: number, w: number, title: string): Frame
				local _, content = Surface.panel({ title = title, size = UDim2.fromOffset(w, 430), parent = cols, padding = 16 })
				content.Parent.LayoutOrder = order
				Create.list("y", 12).Parent = content
				return content
			end
			-- column 1: icon buttons + selection controls
			local a = column(1, 300, "Selection")
			Surface.caption("Icon buttons", { LayoutOrder = 1, Parent = a })
			local ib = row(a, 2, 50, 10)
			Controls.iconButton(scope, { icon = "bag", badge = 3, layoutOrder = 1 }).Instance.Parent = ib
			local h = Controls.iconButton(scope, { icon = "scroll_small", layoutOrder = 2 })
			h.Instance.Parent = ib
			h:force({ hover = true })
			Controls.iconButton(scope, { icon = "gear", selected = true, layoutOrder = 3 }).Instance.Parent = ib
			Controls.iconButton(scope, { icon = "lock", disabled = true, layoutOrder = 4 }).Instance.Parent = ib
			Surface.caption("Toggles", { LayoutOrder = 3, Parent = a })
			Controls.toggle(scope, { label = "Show damage numbers", value = true, layoutOrder = 4 }).Instance.Parent = a
			Controls.toggle(scope, { label = "Auto-loot", value = false, layoutOrder = 5 }).Instance.Parent = a
			Controls.toggle(scope, { label = "Hardcore (locked)", value = false, disabled = true, layoutOrder = 6 }).Instance.Parent = a
			Surface.caption("Checks & radios", { LayoutOrder = 7, Parent = a })
			Controls.checkbox(scope, { label = "Track quest", value = true, layoutOrder = 8 }).Instance.Parent = a
			local grp = {}
			local rr = row(a, 9, 28, 18)
			Controls.checkbox(scope, { label = "Melee", radio = true, value = true, group = grp, layoutOrder = 1 }).Instance.Parent = rr
			Controls.checkbox(scope, { label = "Ranged", radio = true, group = grp, layoutOrder = 2 }).Instance.Parent = rr

			-- column 2: value controls
			local b = column(2, 300, "Values")
			Surface.caption("Segmented", { LayoutOrder = 1, Parent = b })
			Controls.segmented(scope, { options = { "Easy", "Normal", "Heroic" }, index = 2, width = 268, layoutOrder = 2 }).Instance.Parent = b
			Surface.caption("Sliders", { LayoutOrder = 3, Parent = b })
			Controls.slider(scope, { label = "Music", value = 70, format = function(v)
				return v .. "%"
			end, layoutOrder = 4 }).Instance.Parent = b
			local sf = Controls.slider(scope, { label = "Field of view", min = 60, max = 110, step = 5, value = 85, format = function(v)
				return v .. "°"
			end, layoutOrder = 5 })
			sf.Instance.Parent = b
			sf.controller:force({ focused = true })
			Controls.slider(scope, { label = "Locked", value = 30, disabled = true, layoutOrder = 6 }).Instance.Parent = b

			-- column 3: dropdown + search
			local c = column(3, 324, "Choices")
			Surface.caption("Dropdown", { LayoutOrder = 1, Parent = c })
			local dd = Controls.dropdown(scope, { width = 290, index = 2, options = { { text = "Common", icon = "star_outline" }, { text = "Rare and above", icon = "star" }, { text = "Legendary only", icon = "crown" } }, layoutOrder = 2 })
			dd.Instance.Parent = c
			Controls.dropdown(scope, { width = 290, label = "Choose a class…", options = { "Warden", "Arcanist", "Ranger" }, layoutOrder = 3 }).Instance.Parent = c
			Controls.dropdown(scope, { width = 290, label = "Region (locked)", options = { "—" }, disabled = true, layoutOrder = 4 }).Instance.Parent = c
			Surface.caption("Search", { LayoutOrder = 5, Parent = c })
			Controls.search(scope, { placeholder = "Search the satchel…", layoutOrder = 6 }).Instance.Parent = c
			local s2 = Controls.search(scope, { layoutOrder = 7 })
			s2.Instance.Parent = c
			s2:set("moonpetal")
			return {
				actions = {
					{ label = "Open dropdown", run = function()
						dd.open()
					end },
				},
			}
		end,
	},
}
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX42"><Properties><string name="Name">Feedback</string><ProtectedString name="Source"><![CDATA[--!strict
-- Feedback & Overlays specimens.
local Lib = require(script.Parent.Parent.Lib)
local Theme = require(Lib.Theme)
local Create = require(Lib.Core.Create)
local Layers = require(Lib.Core.Layers)
local Surface = require(Lib.Components.Surface)
local Feedback = require(Lib.Components.Feedback)
local Button = require(Lib.Components.Button)
local Progression = require(Lib.Widgets.Progression)

local C = Theme.color

return {
	{
		id = "toasts",
		family = "feedback",
		title = "Toast notifications",
		blurb = "Reward, quest, success, info, warning and error toasts with item badges and a draining timer; live toasts stack and expire.",
		size = Vector2.new(360, 456),
		build = function(scope, parent)
			local col = Create.box({ Size = UDim2.fromScale(1, 1), Parent = parent }, { Create.list("y", 12) })
			local defs = {
				{ tone = "reward", title = "Legendary drop", text = "<b>Galeheart Bow</b> added to your satchel.", icon = "bow" },
				{ tone = "quest", title = "Quest updated", text = "The Ashen Gate · journals 4/4" },
				{ tone = "success", title = "Attributes committed", text = "3 points spent." },
				{ tone = "info", title = "New recipe learned", text = "Elixir of Valour", icon = "elixir" },
				{ tone = "warning", title = "Satchel almost full", text = "38 of 40 slots used." },
				{ tone = "error", title = "Not enough mana", text = "Falling Star needs 90 mana." },
			}
			for i, d in defs do
				local t = Feedback.toastCard({ tone = d.tone, title = d.title, text = d.text, icon = d.icon, width = 360 })
				t.LayoutOrder = i
				t.Parent = col
				scope:add(t)
			end
			local n = 0
			return {
				actions = {
					{ label = "Push live toast", run = function()
						n += 1
						local d = defs[(n - 1) % #defs + 1]
						Feedback.toast(scope, { tone = d.tone, title = d.title, text = d.text, icon = d.icon, duration = 3.5, width = 340 })
					end },
				},
			}
		end,
	},
	{
		id = "dialogs",
		family = "feedback",
		title = "Modal dialog",
		blurb = "A destructive confirmation: dimmed backdrop, item medallion, focus starting on the safe choice, Escape to cancel.",
		size = Vector2.new(540, 300),
		build = function(scope, _parent)
			local function open()
				return Feedback.modal(scope, {
					title = "Discard item",
					icon = "amulet",
					glow = Theme.rarity.mythic.color,
					tone = "danger",
					body = "Discard <b>Amulet of the Seventh Star</b>? Mythic items can't be recovered once they're gone.",
					confirm = { text = "Discard", variant = "danger" },
					cancel = { text = "Keep it" },
				})
			end
			local m = open()
			task.defer(function()
				m.cancel:force({ focused = true })
			end)
			return {
				onReset = function()
					local mm = open()
					task.defer(function()
						mm.cancel:force({ focused = true })
					end)
				end,
				actions = {
					{ label = "Open again", run = open },
				},
			}
		end,
	},
	{
		id = "loot-reveal",
		family = "feedback",
		title = "Reward popup",
		blurb = "Loot reveal: turning rays, the coffer, and rewards popping in by rarity with tooltips.",
		size = Vector2.new(540, 360),
		build = function(scope, parent)
			local l = Progression.lootReveal(scope, {
				{ id = "galeheart_bow", count = 1 },
				{ id = "aether_crystal", count = 2 },
				{ id = "potion_health", count = 5 },
				{ id = "griffon_feather", count = 3 },
				{ id = "emberstone", count = 2 },
			}, { width = 540 })
			l.Instance.Parent = parent
			task.defer(l.play)
			return { onReset = l.play, actions = { { label = "Replay", run = l.play } } }
		end,
	},
	{
		id = "feedback-kit",
		family = "feedback",
		title = "Indicators & overlays",
		blurb = "Progress rings, loading runes, rarity and status tags, currency counters, a tooltip and a context menu.",
		size = Vector2.new(940, 360),
		build = function(scope, parent)
			local root = Create.box({ Size = UDim2.fromScale(1, 1), Parent = parent })
			-- rings
			local rings = Create.box({ Size = UDim2.fromOffset(420, 120), Parent = root }, { Create.list("x", 22, nil, Enum.VerticalAlignment.Center) })
			local r1 = Feedback.ring(scope, { size = 86, value = 0.72, color = C.xp, caption = "XP", layoutOrder = 1 })
			r1.Instance.Parent = rings
			local r2 = Feedback.ring(scope, { size = 86, value = 0.35, color = C.arcane, caption = "Crafting", layoutOrder = 2 })
			r2.Instance.Parent = rings
			local r3 = Feedback.ring(scope, { size = 86, value = 1, color = C.goldBright, caption = "Done", layoutOrder = 3 })
			r3.Instance.Parent = rings
			Feedback.spinner(scope, { size = 56, text = "Loading…", layoutOrder = 4 }).Instance.Parent = rings
			-- tags
			Surface.caption("Rarity & status tags", { Position = UDim2.fromOffset(0, 140), Size = UDim2.fromOffset(420, 18), Parent = root })
			local tagRows = Create.box({ Position = UDim2.fromOffset(0, 168), Size = UDim2.fromOffset(420, 64), Parent = root }, { Create.list("y", 10) })
			local tr1 = Create.box({ Size = UDim2.new(1, 0, 0, 24), Parent = tagRows }, { Create.list("x", 6) })
			for i, r in Theme.rarityOrder do
				Feedback.tag({ text = Theme.rarity[r].name, color = Theme.rarity[r].color, layoutOrder = i, parent = tr1 })
			end
			local tr2 = Create.box({ Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 2, Parent = tagRows }, { Create.list("x", 6) })
			Feedback.tag({ text = "New", color = C.arcane, solid = true, layoutOrder = 1, parent = tr2 })
			Feedback.tag({ text = "Equipped", color = C.goldBright, glyph = "check", layoutOrder = 2, parent = tr2 })
			Feedback.tag({ text = "Bound", color = C.textSoft, glyph = "lock", layoutOrder = 3, parent = tr2 })
			Feedback.tag({ text = "−20%", color = C.good, solid = true, layoutOrder = 4, parent = tr2 })
			Feedback.tag({ text = "Cursed", color = C.bad, glyph = "skull", layoutOrder = 5, parent = tr2 })
			-- currency
			Surface.caption("Currency", { Position = UDim2.fromOffset(0, 256), Size = UDim2.fromOffset(420, 18), Parent = root })
			local cur = Create.box({ Position = UDim2.fromOffset(0, 284), Size = UDim2.fromOffset(420, 30), Parent = root }, { Create.list("x", 26, nil, Enum.VerticalAlignment.Center) })
			local g = Feedback.currency(scope, { amount = 12480, kind = "gold", size = 18, layoutOrder = 1 })
			g.Instance.Parent = cur
			Feedback.currency(scope, { amount = 36, kind = "gem", size = 18, layoutOrder = 2 }).Instance.Parent = cur
			Feedback.currency(scope, { amount = 215, kind = "shard", size = 18, layoutOrder = 3 }).Instance.Parent = cur
			local poor = Feedback.currency(scope, { amount = 40, kind = "gold", size = 18, layoutOrder = 4 })
			poor.Instance.Parent = cur
			poor:setInsufficient(true)
			-- bars
			local bars = Create.box({ Position = UDim2.fromOffset(0, 330), Size = UDim2.fromOffset(420, 64), Parent = root }, { Create.list("y", 8) })
			Feedback.bar(scope, { label = "Reputation · Wardens' Guild", glyph = "shield_small", color = C.good, max = 3000, value = 2140, height = 12, layoutOrder = 1 }).Instance.Parent = bars
			-- tooltip + context menu (right half)
			local tip = Feedback.tooltipCard({ title = "Arcane Ward", body = "Absorbs the next <b>220</b> damage. Breaks on a critical hit.", hint = "Right-click to dismiss", width = 240 })
			tip.Position = UDim2.fromOffset(470, 0)
			tip.Parent = root
			scope:add(tip)
			local anchor = Button.new(scope, { text = "Right-click me", variant = "secondary", size = "small" })
			anchor.Instance.Position = UDim2.fromOffset(740, 0)
			anchor.Instance.Parent = root
			local function menu()
				local pos = Layers.toLocal(anchor.Instance.AbsolutePosition + Vector2.new(0, anchor.Instance.AbsoluteSize.Y + 6))
				return Feedback.contextMenu(scope, pos, {
					{ text = "Use", icon = "heart", hint = "E" },
					{ text = "Equip", icon = "shield_small" },
					{ text = "Split stack", icon = "swap" },
					{ text = "Link in chat", icon = "scroll_small", disabled = true },
					"-",
					{ text = "Discard…", icon = "trash", danger = true },
				}, "Mana Tonic")
			end
			scope:connect(anchor.Instance.MouseButton2Click, menu)
			task.delay(0.1, menu)
			return {
				actions = {
					{ label = "Animate rings", run = function()
						r1:set(0)
						r1:animate(0.72, 1.2)
						r2:set(0)
						r2:animate(0.35, 1.2)
					end },
					{ label = "Gold +2,500", run = function()
						g:set(g:get() + 2500)
					end },
					{ label = "Open menu", run = menu },
				},
			}
		end,
	},
}
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX43"><Properties><string name="Name">Inventory</string><ProtectedString name="Source"><![CDATA[--!strict
-- Inventory specimens: satchel, item tooltips, slot states.
local Lib = require(script.Parent.Parent.Lib)
local Theme = require(Lib.Theme)
local Create = require(Lib.Core.Create)
local Store = require(Lib.Core.Store)
local Surface = require(Lib.Components.Surface)
local Slot = require(Lib.Components.Slot)
local ItemCard = require(Lib.Components.ItemCard)
local Inventory = require(Lib.Widgets.Inventory)
local Items = require(Lib.Data.Items)

local C = Theme.color

return {
	{
		id = "inventory",
		family = "inventory",
		title = "Satchel inventory",
		blurb = "Drag-and-drop slots with stack merging, category filters, search, sorting, comparison tooltips and a context menu.",
		size = Vector2.new(586, 540),
		build = function(scope, parent)
			local inv = Inventory.new(scope)
			inv.Instance.AnchorPoint = Vector2.new(0.5, 0)
			inv.Instance.Position = UDim2.fromScale(0.5, 0)
			inv.Instance.Parent = parent
			local function patch(fn)
				local st = Store.copy(inv.store:get())
				fn(st)
				inv.store:set(st)
			end
			return {
				onReset = inv.reset,
				actions = {
					{ label = "Filter: weapons", run = function()
						inv.store:set({ filter = "weapon" })
					end },
					{ label = "Search “potion”", run = function()
						inv.search:set("potion")
					end },
					{ label = "Sort by rarity", run = function()
						patch(function(st)
							Inventory.sort(st, "Rarity")
							st.sortIndex = 1
						end)
					end },
					{ label = "Drag slot 1 → 3", run = function()
						inv.drag:dropOn({ from = 1 }, inv.cells[3].slot.Instance)
					end },
					{ label = "Merge potions", run = function()
						patch(function(st)
							st.slots[3] = { id = "potion_health", count = 6 }
						end)
						task.wait(0.4)
						inv.drag:dropOn({ from = 3 }, inv.cells[4].slot.Instance)
					end },
					{ label = "Pick up slot 2", run = function()
						inv.store:set({ picked = 2 })
					end },
					{ label = "Context menu", run = function()
						inv.openMenu(4)
					end },
					{ label = "Inspect Galeheart Bow", run = function()
						inv.cells[10].tip.show()
					end },
				},
			}
		end,
	},
	{
		id = "item-tooltips",
		family = "inventory",
		title = "Item tooltips & comparison",
		blurb = "Item cards by rarity: stat comparison against the equipped item, effects, lore, stack value and weight.",
		size = Vector2.new(1070, 356),
		build = function(scope, parent)
			local row = Create.box({ Size = UDim2.fromScale(1, 1), Parent = parent }, { Create.list("x", 24, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center) })
			local function add(card: Frame, order: number)
				card.LayoutOrder = order
				card.Parent = row
				scope:add(card)
			end
			-- comparison pair
			local pair = Create.box({ Size = UDim2.fromOffset(0, 0), AutomaticSize = Enum.AutomaticSize.XY, LayoutOrder = 1, Parent = row }, { Create.list("x", 10) })
			local bow = Items.get("galeheart_bow")
			local mace = Items.get("warden_mace")
			local a = ItemCard.new(bow, { compare = mace })
			a.LayoutOrder = 1
			a.Parent = pair
			local b = ItemCard.new(mace, { equipped = true, width = 250 })
			b.LayoutOrder = 2
			b.Parent = pair
			add(ItemCard.new(Items.get("amulet_stars"), { width = 250 }), 2)
			local col = Create.box({ Size = UDim2.fromOffset(220, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = row }, { Create.list("y", 14) })
			local p = ItemCard.new(Items.get("potion_health"), { count = 12, width = 220 })
			p.Parent = col
			local q = ItemCard.new(Items.get("vault_key"), { width = 220 })
			q.LayoutOrder = 2
			q.Parent = col
			return nil
		end,
	},
	{
		id = "slots",
		family = "inventory",
		title = "Item slots",
		blurb = "Six rarities and every slot state: empty, hover, picked up, keyboard focus, locked, drop targets, filtered out and equipped.",
		size = Vector2.new(724, 262),
		build = function(scope, parent)
			local grid = Create.box({ Size = UDim2.fromScale(1, 1), Parent = parent }, { Create.list("y", 16) })
			local function row(order: number, title: string)
				local r = Create.box({ Size = UDim2.new(1, 0, 0, 98), LayoutOrder = order, Parent = grid }, { Create.list("x", 14) })
				Surface.caption(title, { LayoutOrder = 0, Size = UDim2.new(1, 0, 0, 16), Parent = grid }).LayoutOrder = order - 1
				return r
			end
			local function cell(parent: Instance, order: number, label: string, build: (Frame) -> ())
				local c = Create.box({ Size = UDim2.fromOffset(78, 98), LayoutOrder = order, Parent = parent })
				local holder = Create.box({ Size = UDim2.fromOffset(68, 68), Position = UDim2.fromOffset(5, 0), Parent = c })
				build(holder)
				Surface.text({ role = "caps", text = label, color = C.textFaint, size = 9, Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 76), TextXAlignment = Enum.TextXAlignment.Center, Parent = c })
			end
			local rar = row(2, "Rarity")
			local samples = { common = "woodcutter_axe", uncommon = "warden_mace", rare = "dawnsteel_blade", epic = "emberfang", legendary = "galeheart_bow", mythic = "amulet_stars" }
			for i, r in Theme.rarityOrder do
				cell(rar, i, Theme.rarity[r].name, function(h)
					local s = Slot.new(scope, { size = 68, item = Items.get(samples[r]) })
					s.Instance.Parent = h
				end)
			end
			local states = row(4, "States")
			local defs = {
				{ "Empty", nil, nil },
				{ "Stack", "potion_mana", function(s)
					s:setItem(Items.get("potion_mana"), 7)
				end },
				{ "Hover", "emberstone", function(s)
					s:force({ hover = true })
				end },
				{ "Picked", "sunforged_plate", function(s)
					s:set({ selected = true })
				end },
				{ "Focus", "ring_embers", function(s)
					s:force({ focused = true })
				end },
				{ "Drop ok", nil, function(s)
					s:set({ drop = "valid" })
				end },
				{ "Locked", nil, function(s)
					s:set({ locked = true })
				end },
				{ "Filtered", "glowcap", function(s)
					s:set({ dim = true })
				end },
			}
			for i, d in defs do
				cell(states, i, d[1], function(h)
					local s = Slot.new(scope, { size = 68, item = d[2] and Items.get(d[2]) or nil })
					s.Instance.Parent = h
					if d[3] then
						d[3](s)
					end
				end)
			end
			return nil
		end,
	},
}
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX44"><Properties><string name="Name">Quests</string><ProtectedString name="Source"><![CDATA[--!strict
-- Quests & Progression specimens.
local Lib = require(script.Parent.Parent.Lib)
local Create = require(Lib.Core.Create)
local Store = require(Lib.Core.Store)
local Progression = require(Lib.Widgets.Progression)
local Quests = require(Lib.Data.Quests)

return {
	{
		id = "quest-log",
		family = "quests",
		title = "Quest journal",
		blurb = "Active and completed tabs, quest cards, a parchment detail page with objectives and rewards, tracking, abandon confirmation and turn-in.",
		size = Vector2.new(940, 620),
		build = function(scope, parent)
			local log = Progression.questLog(scope)
			log.Instance.Parent = parent
			return {
				onReset = log.reset,
				actions = {
					{ label = "Advance Ashen Gate", run = function()
						log:advance("ashen_gate")
					end },
					{ label = "Select bounty (ready)", run = function()
						log:select("bounty")
					end },
					{ label = "Turn in bounty", run = function()
						log:select("bounty")
						task.wait(0.2)
						log.showComplete(Quests.get("bounty"))
					end },
					{ label = "Completed tab", run = function()
						log.store:set({ tab = 2, selected = "lighthouse" })
					end },
				},
			}
		end,
	},
	{
		id = "quest-cards",
		family = "quests",
		title = "Quest cards",
		blurb = "One card in five states: tracked, in progress, ready to turn in, completed and locked, plus hover and selection.",
		size = Vector2.new(700, 300),
		build = function(scope, parent)
			local grid = Create.box({ Size = UDim2.fromScale(1, 1), Parent = parent }, {
				Create.new("UIGridLayout", { CellSize = UDim2.fromOffset(340, 88), CellPadding = UDim2.fromOffset(20, 18), SortOrder = Enum.SortOrder.LayoutOrder }),
			})
			local defs = {
				{ "ashen_gate", true, nil },
				{ "moonpetal", false, { hover = true } },
				{ "bounty", false, nil },
				{ "daily_forge", false, nil },
				{ "lighthouse", false, nil },
				{ "drowned_vault", false, nil },
			}
			for i, d in defs do
				local c = Progression.questCard(scope, { quest = Store.copy(Quests.get(d[1])), selected = d[2], width = 340, layoutOrder = i })
				c.Instance.Parent = grid
				if d[3] then
					c:force(d[3])
				end
			end
			return nil
		end,
	},
	{
		id = "quest-tracker",
		family = "quests",
		title = "Quest tracker",
		blurb = "A compact tracking widget: objectives tick off with an animated check and the quest flags itself ready to turn in.",
		size = Vector2.new(340, 330),
		build = function(scope, parent)
			local t = Progression.tracker(scope, { width = 340 })
			t.Instance.Parent = parent
			return {
				onReset = t.reset,
				actions = {
					{ label = "Advance Ashen Gate", run = function()
						t:advance(1)
					end },
					{ label = "Advance Moonpetal", run = function()
						t:advance(2)
					end },
					{ label = "Complete Moonpetal", run = function()
						for _ = 1, 4 do
							t:advance(2)
							task.wait(0.15)
						end
					end },
				},
			}
		end,
	},
	{
		id = "achievements",
		family = "quests",
		title = "Achievement cards",
		blurb = "Unlocked with a wax seal, in progress with a bar, locked and hidden, each with its point value.",
		size = Vector2.new(830, 330),
		build = function(scope, parent)
			local grid = Create.box({ Size = UDim2.fromScale(1, 1), Parent = parent }, {
				Create.new("UIGridLayout", { CellSize = UDim2.fromOffset(405, 96), CellPadding = UDim2.fromOffset(20, 18), SortOrder = Enum.SortOrder.LayoutOrder }),
			})
			for i, a in Quests.achievements do
				Progression.achievement(scope, a, { width = 405, layoutOrder = i }).Instance.Parent = grid
			end
			return nil
		end,
	},
	{
		id = "level-up",
		family = "quests",
		title = "Level-up presentation",
		blurb = "Rotating rays, the level counting up in its keystone frame, a ribbon banner and staggered gains.",
		size = Vector2.new(560, 380),
		build = function(scope, parent)
			local l = Progression.levelUp(scope)
			l.Instance.Parent = parent
			task.defer(l.play)
			return {
				onReset = l.play,
				actions = {
					{ label = "Replay", run = function()
						l.play()
					end },
				},
			}
		end,
	},
	{
		id = "quest-complete",
		family = "quests",
		title = "Quest complete notice",
		blurb = "A parchment notice: the wax seal stamps down and the rewards arrive one by one.",
		size = Vector2.new(470, 340),
		build = function(scope, parent)
			local n = Progression.completeNotice(scope, Quests.get("bounty"), { width = 470 })
			n.Instance.Parent = parent
			task.defer(n.play)
			return {
				onReset = n.play,
				actions = {
					{ label = "Replay", run = function()
						n.play()
					end },
				},
			}
		end,
	},
}
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX45"><Properties><string name="Name">Skills</string><ProtectedString name="Source"><![CDATA[--!strict
-- Skills & Abilities specimens.
local Lib = require(script.Parent.Parent.Lib)
local Create = require(Lib.Core.Create)
local SkillTree = require(Lib.Widgets.SkillTree)
local Abilities = require(Lib.Widgets.Abilities)
local Skills = require(Lib.Data.Skills)

local function ability(id: string)
	for _, a in Skills.abilities do
		if a.id == id then
			return a
		end
	end
	error(id)
end

return {
	{
		id = "skill-tree",
		family = "skills",
		title = "Skill tree",
		blurb = "Three branches with prerequisites, row gates, ranks and animated paths; inspect a node, learn or unlearn ranks, reset with confirmation.",
		size = Vector2.new(1090, 640),
		build = function(scope, parent)
			local tree = SkillTree.new(scope)
			tree.Instance.Parent = parent
			return {
				onReset = tree.reset,
				actions = {
					{ label = "Learn Falling Star", run = function()
						tree:learn("meteor")
					end },
					{ label = "Learn Rime ×2", run = function()
						tree:learn("rime")
						task.wait(0.3)
						tree:learn("rime")
					end },
					{ label = "Select locked keystone", run = function()
						tree:select("phoenix")
					end },
					{ label = "Select Kindle (has dependents)", run = function()
						tree:select("kindle")
					end },
				},
			}
		end,
	},
	{
		id = "ability-bar",
		family = "skills",
		title = "Ability bar",
		blurb = "Keybound abilities with cooldown sweeps and countdowns, global cooldown, mana costs, out-of-mana tint, a toggled ability and a locked slot.",
		size = Vector2.new(622, 150),
		build = function(scope, parent)
			local bar = Abilities.bar(scope)
			bar.Instance.Parent = parent
			return {
				onReset = bar.reset,
				actions = {
					{ label = "Cast 1", run = function()
						bar:trigger(1)
					end },
					{ label = "Cast 3", run = function()
						bar:trigger(3)
					end },
					{ label = "Toggle Fade (7)", run = function()
						bar:trigger(7)
					end },
					{ label = "Showcase states", run = function()
						bar:reset()
						bar:trigger(6)
						task.wait(1.0)
						bar:trigger(3)
						task.wait(1.0)
						bar:trigger(1)
						bar:trigger(7)
						bar:setMana(40)
					end },
					{ label = "Freeze", run = function()
						bar:freeze(true)
					end },
					{ label = "Unfreeze", run = function()
						bar:freeze(false)
					end },
				},
			}
		end,
	},
	{
		id = "ability-cards",
		family = "skills",
		title = "Ability cards",
		blurb = "Ability detail cards: school and ultimate tags, rank pips, cost, cooldown, cast time, range and a locked ability.",
		size = Vector2.new(960, 214),
		build = function(scope, parent)
			local row = Create.box({ Size = UDim2.fromScale(1, 1), Parent = parent }, { Create.list("x", 30, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center) })
			for i, id in { "kindle", "meteor", "wolf" } do
				local c = Abilities.card(ability(id), { width = 300 })
				c.LayoutOrder = i
				c.Parent = row
				scope:add(c)
			end
			return nil
		end,
	},
}
]]></ProtectedString></Properties>
      </Item>
    </Item>
  </Item>
</Item>
<Item class="StarterPlayer" referent="RBX55"><Properties><string name="Name">StarterPlayer</string></Properties>
  <Item class="StarterPlayerScripts" referent="RBX54"><Properties><string name="Name">StarterPlayerScripts</string></Properties>
    <Item class="Folder" referent="RBX53"><Properties><string name="Name">VellumGallery</string></Properties>
      <Item class="LocalScript" referent="RBX52"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--!strict
-- Vellum gallery client: opens straight into the component gallery. No character, no world.
-- In Studio it also exposes PlayerGui.VellumBridge (BindableFunction) for automated checks and captures.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local Gallery = ReplicatedStorage:WaitForChild("VellumGallery")
local App = require(Gallery:WaitForChild("App"))
local Lib = require(Gallery:WaitForChild("Lib"))
local Scope = require(Lib.Core.Scope)
local Signal = require(Lib.Core.Signal)
local Motion = require(Lib.Core.Motion)
local Registry = require(Gallery:WaitForChild("Registry"))

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false)
end)

local gui = Instance.new("ScreenGui")
gui.Name = "VellumGallery"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = playerGui

local app = App.start(gui)

if RunService:IsStudio() then
	local bridge = Instance.new("BindableFunction")
	bridge.Name = "VellumBridge"
	bridge.OnInvoke = function(cmd: string, a: any, _b: any)
		if cmd == "list" then
			local ids = {}
			for _, s in Registry.list do
				table.insert(ids, s.id)
			end
			return ids
		elseif cmd == "show" then
			return app.show(a)
		elseif cmd == "capture" then
			app.setCapture(a == true, _b)
			return true
		elseif cmd == "batch" then
			local jobs = a or require(Gallery:WaitForChild("Captures"))
			if type(a) == "string" then
				-- a single id from the standard list
				for _, j in require(Gallery:WaitForChild("Captures")) do
					if j.id == a then
						jobs = { j }
					end
				end
			end
			return game:GetService("HttpService"):JSONEncode(app.captureBatch(jobs))
		elseif cmd == "tiles" then
			local opts = _b or {}
			local g = app.captureTiles(a or 2, opts.prep, opts.wait)
			return game:GetService("HttpService"):JSONEncode(g)
		elseif cmd == "width" then
			app.setWidth(a)
			return true
		elseif cmd == "reset" then
			app.reset()
			return true
		elseif cmd == "remount" then
			app.remount()
			return true
		elseif cmd == "motion" then
			Motion.reduced = a == false
			return true
		elseif cmd == "action" then
			for _, act in app.mounted.built.actions or {} do
				if act.label == a then
					task.spawn(act.run)
					return true
				end
			end
			return false
		elseif cmd == "actions" then
			local out = {}
			for _, act in app.mounted.built.actions or {} do
				table.insert(out, act.label)
			end
			return out
		elseif cmd == "stats" then
			return {
				id = app.current and app.current.id,
				scopes = Scope.liveCount(),
				listeners = Signal.listenerCount(),
				instances = if app.mounted then #app.mounted.canvas:GetDescendants() else 0,
				guiDescendants = #gui:GetDescendants(),
			}
		elseif cmd == "canvas" then
			local c = app.mounted.canvas
			return { x = c.AbsolutePosition.X, y = c.AbsolutePosition.Y, w = c.AbsoluteSize.X, h = c.AbsoluteSize.Y, scale = app.mounted.scale.Scale }
		elseif cmd == "find" then
			-- full path of the first stage descendant with this Name (for scripted input)
			for _, d in app.mounted.canvas.Parent.Parent:GetDescendants() do
				if d.Name == a then
					return d:GetFullName()
				end
			end
			return nil
		end
		return nil
	end
	bridge.Parent = playerGui
end
]]></ProtectedString></Properties>
      </Item>
    </Item>
  </Item>
</Item>
