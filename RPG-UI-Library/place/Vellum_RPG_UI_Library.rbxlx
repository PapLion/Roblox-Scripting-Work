      <Item class="ModuleScript" referent="RBX24"><Properties><string name="Name">Skills</string><ProtectedString name="Source"><![CDATA[--!strict
-- Example skill tree and abilities. Descriptions only: nothing here is executed as a game ability.
-- Node: id, name, icon, branch, col (1-3), row (1-5), kind ("passive" | "active" | "keystone"),
-- max (ranks), requires {ids}, text (with {v} replaced by the per-rank value), values {per rank}
local Skills = {}

Skills.branches = {
	{ id = "ember", name = "Emberheart", color = Color3.fromHex("F2803C"), glyph = "flame" },
	{ id = "aegis", name = "Bastion", color = Color3.fromHex("D4A55A"), glyph = "shield_small" },
	{ id = "frost", name = "Wintermere", color = Color3.fromHex("6FC3F2"), glyph = "snow" },
}

-- points that must be spent in a branch before a row unlocks
Skills.rowGate = { 0, 1, 3, 5, 8 }

local function n(t)
	return t
end

Skills.nodes = {
	-- Emberheart
	n({ id = "kindle", name = "Kindle", icon = "fireball", branch = "ember", col = 2, row = 1, kind = "active", max = 1, requires = {}, text = "Hurl a mote of fire that deals {v} damage.", values = { 120 }, cost = 30, cooldown = 4 }),
	n({ id = "searing", name = "Searing Touch", icon = "rage", branch = "ember", col = 1, row = 2, kind = "passive", max = 3, requires = { "kindle" }, text = "Fire damage increased by {v}%.", values = { 4, 8, 12 } }),
	n({ id = "cinder", name = "Cinder Veins", icon = "potion_health", branch = "ember", col = 3, row = 2, kind = "passive", max = 2, requires = { "kindle" }, text = "Burning enemies heal you for {v}% of damage dealt.", values = { 2, 4 } }),
	n({ id = "meteor", name = "Falling Star", icon = "meteor", branch = "ember", col = 2, row = 3, kind = "active", max = 1, requires = { "searing" }, text = "Call down a meteor for {v} damage in an area.", values = { 480 }, cost = 90, cooldown = 18 }),
	n({ id = "pyre", name = "Pyre", icon = "fireball", branch = "ember", col = 1, row = 4, kind = "passive", max = 3, requires = { "meteor" }, text = "Critical hits ignite for {v}s.", values = { 2, 3, 4 } }),
	n({ id = "phoenix", name = "Heart of the Phoenix", icon = "smite", branch = "ember", col = 2, row = 5, kind = "keystone", max = 1, requires = { "pyre" }, text = "Once per battle, rise from death at {v}% health in a burst of flame.", values = { 40 } }),
	-- Aegis
	n({ id = "guard", name = "Steadfast", icon = "shield", branch = "aegis", col = 2, row = 1, kind = "passive", max = 3, requires = {}, text = "Armor increased by {v}.", values = { 10, 20, 30 } }),
	n({ id = "ward", name = "Arcane Ward", icon = "ward", branch = "aegis", col = 1, row = 2, kind = "active", max = 1, requires = { "guard" }, text = "Absorb the next {v} damage.", values = { 220 }, cost = 50, cooldown = 12 }),
	n({ id = "thorns", name = "Briar Mail", icon = "thorns", branch = "aegis", col = 3, row = 2, kind = "passive", max = 2, requires = { "guard" }, text = "Reflect {v}% of melee damage taken.", values = { 6, 12 } }),
	n({ id = "renew", name = "Renewal", icon = "regen", branch = "aegis", col = 2, row = 3, kind = "active", max = 1, requires = { "ward" }, text = "Restore {v} health over 6 seconds.", values = { 360 }, cost = 60, cooldown = 15 }),
	n({ id = "bulwark", name = "Bulwark", icon = "chestplate", branch = "aegis", col = 3, row = 4, kind = "passive", max = 3, requires = { "renew", "thorns" }, text = "Damage taken reduced by {v}%.", values = { 3, 6, 9 } }),
	n({ id = "dawnwall", name = "Dawnwall", icon = "heal", branch = "aegis", col = 2, row = 5, kind = "keystone", max = 1, requires = { "bulwark" }, text = "Allies behind you take {v}% less damage.", values = { 20 } }),
	-- Wintermere
	n({ id = "shard", name = "Frost Shard", icon = "frost_shard", branch = "frost", col = 2, row = 1, kind = "active", max = 1, requires = {}, text = "Launch a shard that chills for {v}s.", values = { 3 }, cost = 25, cooldown = 3 }),
	n({ id = "rime", name = "Rime", icon = "crystal", branch = "frost", col = 1, row = 2, kind = "passive", max = 3, requires = { "shard" }, text = "Chilled enemies take {v}% more damage.", values = { 5, 10, 15 } }),
	n({ id = "glide", name = "Iceglide", icon = "dash", branch = "frost", col = 3, row = 2, kind = "active", max = 1, requires = { "shard" }, text = "Dash {v} metres on a trail of ice.", values = { 8 }, cost = 20, cooldown = 8 }),
	n({ id = "blizzard", name = "Blizzard", icon = "blizzard", branch = "frost", col = 2, row = 3, kind = "active", max = 1, requires = { "rime" }, text = "A storm deals {v} damage per second for 6s.", values = { 90 }, cost = 80, cooldown = 20 }),
	n({ id = "stillness", name = "Stillness", icon = "stealth", branch = "frost", col = 1, row = 4, kind = "passive", max = 2, requires = { "blizzard" }, text = "Standing still grants {v}% haste.", values = { 8, 16 } }),
	n({ id = "winterheart", name = "Winter's Heart", icon = "spirit_wolf", branch = "frost", col = 2, row = 5, kind = "keystone", max = 1, requires = { "stillness" }, text = "Summon a frost wolf that fights for {v}s.", values = { 30 } }),
}

local byId = {}
for _, node in Skills.nodes do
	byId[node.id] = node
end
function Skills.get(id: string)
	return byId[id]
end

function Skills.describe(node, rank: number): string
	local v = node.values[math.max(1, math.min(rank, #node.values))]
	return (string.gsub(node.text, "{v}", tostring(v)))
end

-- Abilities for the action bar (independent of the tree; local demo values)
Skills.abilities = {
	{ id = "kindle", name = "Kindle", icon = "fireball", key = "1", cost = 30, cooldown = 4, cast = "Instant", range = "30 m", text = "Hurl a mote of fire that deals 120 damage and ignites the target.", rank = 3, maxRank = 5, school = "Fire" },
	{ id = "shard", name = "Frost Shard", icon = "frost_shard", key = "2", cost = 25, cooldown = 3, cast = "Instant", range = "35 m", text = "Launch a shard of ice that chills the target for 3 seconds.", rank = 2, maxRank = 5, school = "Frost" },
	{ id = "ward", name = "Arcane Ward", icon = "ward", key = "3", cost = 50, cooldown = 12, cast = "Instant", range = "Self", text = "Wrap yourself in a ward that absorbs the next 220 damage.", rank = 1, maxRank = 3, school = "Arcane" },
	{ id = "glide", name = "Iceglide", icon = "dash", key = "4", cost = 20, cooldown = 8, cast = "Instant", range = "8 m", text = "Dash forward on a trail of ice, leaving chilling frost behind.", rank = 1, maxRank = 3, school = "Frost" },
	{ id = "renew", name = "Renewal", icon = "regen", key = "5", cost = 60, cooldown = 15, cast = "1.5 s", range = "Self", text = "Restore 360 health over 6 seconds.", rank = 2, maxRank = 3, school = "Nature" },
	{ id = "meteor", name = "Falling Star", icon = "meteor", key = "6", cost = 90, cooldown = 18, cast = "2 s", range = "40 m", text = "Call down a meteor that deals 480 damage in an area.", rank = 1, maxRank = 3, school = "Fire", ultimate = true },
	{ id = "stealth", name = "Fade", icon = "stealth", key = "7", cost = 0, cooldown = 0, cast = "Toggle", range = "Self", text = "Toggle: move unseen. Drains 4 mana per second.", rank = 1, maxRank = 1, school = "Shadow", toggle = true },
	{ id = "wolf", name = "Winter's Heart", icon = "spirit_wolf", key = "8", cost = 120, cooldown = 60, cast = "Instant", range = "Self", text = "Summon a frost wolf. Learned at level 30.", rank = 0, maxRank = 1, school = "Frost", locked = true },
}

return Skills
]]></ProtectedString></Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="RBX32"><Properties><string name="Name">Widgets</string></Properties>
      <Item class="ModuleScript" referent="RBX26"><Properties><string name="Name">Abilities</string><ProtectedString name="Source"><![CDATA[--!strict
-- Abilities: an action bar (keybinds 1–8, cooldown sweeps with countdown, global cooldown, mana cost and
-- out-of-mana state, toggled abilities, locked slot, ready flash) and ability cards. Activating an ability
-- only drives the UI: it spends local mana and starts the cooldown display. No ability is executed.
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local Theme = require(script.Parent.Parent.Theme)
local Atlas = require(script.Parent.Parent.Atlas)
local Create = require(script.Parent.Parent.Core.Create)
local Motion = require(script.Parent.Parent.Core.Motion)
local Interact = require(script.Parent.Parent.Core.Interact)
local Surface = require(script.Parent.Parent.Components.Surface)
local Feedback = require(script.Parent.Parent.Components.Feedback)
local Skills = require(script.Parent.Parent.Data.Skills)

local C = Theme.color
local M = Theme.motion
local Abilities = {}

local KEYS = {
	[Enum.KeyCode.One] = 1, [Enum.KeyCode.Two] = 2, [Enum.KeyCode.Three] = 3, [Enum.KeyCode.Four] = 4,
	[Enum.KeyCode.Five] = 5, [Enum.KeyCode.Six] = 6, [Enum.KeyCode.Seven] = 7, [Enum.KeyCode.Eight] = 8,
}
local GCD = 0.9

---------------------------------------------------------------- Ability card
function Abilities.card(ab: any, opts: { [string]: any }?): Frame
	local o = opts or {}
	local panel, content = Surface.panel({ size = UDim2.fromOffset(o.width or 300, 0), autoSize = Enum.AutomaticSize.Y, padding = 14, frameScale = 0.5 })
	Create.list("y", 10).Parent = content
	local head = Create.box({ Size = UDim2.new(1, 0, 0, 72), LayoutOrder = 1, Parent = content })
	local medal = Create.box({ Size = UDim2.fromOffset(72, 72), Parent = head })
	Atlas.image("chrome", "glow", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1.5, 1.5), ImageColor3 = if ab.ultimate then C.warn else C.arcane, ImageTransparency = if ab.locked then 1 else 0.65, Parent = medal })
	Atlas.image("chrome", "diamond", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.86, 0.86), ImageColor3 = C.leather0, ZIndex = 2, Parent = medal })
	Atlas.image("icon", ab.icon, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.56, 0.56), ImageColor3 = if ab.locked then Color3.fromRGB(110, 100, 92) else Color3.new(1, 1, 1), ZIndex = 3, Parent = medal })
	Atlas.image("chrome", "node_diamond", { Size = UDim2.fromScale(1, 1), ZIndex = 4, Parent = medal })
	if ab.locked then
		Atlas.image("glyph", "lock", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.3, 0.3), ImageColor3 = C.textSoft, ZIndex = 5, Parent = medal })
	end
	local names = Create.box({ Position = UDim2.fromOffset(84, 0), Size = UDim2.new(1, -84, 1, 0), Parent = head }, { Create.list("y", 4, nil, Enum.VerticalAlignment.Center) })
	Surface.text({ role = "heading", text = ab.name, size = 20, color = if ab.locked then C.textFaint else C.goldBright, LayoutOrder = 1, Parent = names })
	local tags = Create.box({ Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 2, Parent = names }, { Create.list("x", 5, nil, Enum.VerticalAlignment.Center) })
	Feedback.tag({ text = ab.school, color = C.info, height = 18, textSize = 9, layoutOrder = 1, parent = tags })
	if ab.ultimate then
		Feedback.tag({ text = "Ultimate", color = C.warn, glyph = "crown", height = 18, textSize = 9, layoutOrder = 2, parent = tags })
	end
	if ab.toggle then
		Feedback.tag({ text = "Toggle", color = C.arcane, height = 18, textSize = 9, layoutOrder = 3, parent = tags })
	end
	local pips = Create.box({ Size = UDim2.new(1, 0, 0, 12), LayoutOrder = 3, Parent = names }, { Create.list("x", 4, nil, Enum.VerticalAlignment.Center) })
	for i = 1, ab.maxRank do
		Atlas.image("chrome", "pip", { Size = UDim2.fromOffset(11, 11), ImageColor3 = if i <= ab.rank then Color3.new(1, 1, 1) else Color3.fromRGB(70, 60, 50), LayoutOrder = i, Parent = pips })
	end
	-- meta grid
	local meta = Create.box({ Size = UDim2.new(1, 0, 0, 46), LayoutOrder = 2, Parent = content }, {
		Create.new("UIGridLayout", { CellSize = UDim2.new(0.25, -4, 1, 0), CellPadding = UDim2.fromOffset(5, 0) }),
	})
	for i, m in { { "drop", "Cost", if ab.cost > 0 then `{ab.cost}` else "—" }, { "hourglass", "Cooldown", if ab.cooldown > 0 then `{ab.cooldown}s` else "—" }, { "bolt", "Cast", ab.cast }, { "compass", "Range", ab.range } } do
		local cell = Create("Frame", { BackgroundColor3 = C.void, BackgroundTransparency = 0.5, LayoutOrder = i, Parent = meta }, { Create.corner(5) })
		Atlas.image("glyph", m[1], { Size = UDim2.fromOffset(12, 12), Position = UDim2.fromOffset(7, 7), ImageColor3 = C.gold, Parent = cell })
		Surface.text({ role = "caps", text = m[2], size = 8, color = C.textFaint, Position = UDim2.fromOffset(22, 6), Parent = cell })
		Surface.text({ role = "number", text = m[3], size = 13, color = C.text, Position = UDim2.fromOffset(7, 22), Parent = cell })
	end
	Surface.text({ role = "body", text = ab.text, size = 14, color = if ab.locked then C.textFaint else C.textSoft, wrap = true, LayoutOrder = 3, Parent = content })
	return panel
end

---------------------------------------------------------------- Action bar
-- props: abilities (list), mana, manaMax, slot
function Abilities.bar(scope: any, props: { [string]: any }?)
	local p = props or {}
	local list = p.abilities or Skills.abilities
	local slotSize = p.slot or 64
	local gap = 10
	local width = #list * slotSize + (#list - 1) * gap + 40
	local panel, content = Surface.panel({ size = UDim2.fromOffset(width, 0), autoSize = Enum.AutomaticSize.Y, padding = 12, tone = "deep", frameScale = 0.5 })
	scope:add(panel)
	Create.list("y", 10).Parent = content
	local manaMax = p.manaMax or 300
	local mana = p.mana or 260
	local manaBar = Feedback.bar(scope, { label = "Mana", glyph = "drop", color = C.mana, deep = C.manaDeep, max = manaMax, value = mana, height = 12, layoutOrder = 1 })
	manaBar.Instance.Parent = content
	local row = Create.box({ Name = "Slots", Size = UDim2.new(1, 0, 0, slotSize + 18), LayoutOrder = 2, Parent = content }, { Create.list("x", gap) })

	local slots = {}
	local gcdUntil = 0
	local handle = {} :: any

	local function trigger(i: number)
		local s = slots[i]
		if not s then
			return
		end
		local ab = s.ab
		if ab.locked then
			Motion.shake(s.root)
			return
		end
		local now = os.clock()
		if ab.toggle then
			s.toggled = not s.toggled
			Motion.pop(s.pop, 0.12)
			return
		end
		if now < s.readyAt or now < gcdUntil then
			Motion.shake(s.root)
			return
		end
		if mana < ab.cost then
			Motion.shake(s.root)
			Feedback.toast(scope, { tone = "error", title = "Not enough mana", text = `{ab.name} needs {ab.cost} mana.`, duration = 2.2 })
			return
		end
		mana -= ab.cost
		manaBar:set(mana)
		s.readyAt = now + ab.cooldown
		s.cdStart = now
		gcdUntil = now + GCD
		s.flash.ImageTransparency = 0.2
		Motion.tween(s.flash, { ImageTransparency = 1 }, 0.4)
		Motion.pop(s.pop, -0.08)
	end

	for i, ab in list do
		local cell = Create.box({ Name = "Ability_" .. ab.id, Size = UDim2.fromOffset(slotSize, slotSize + 18), LayoutOrder = i, Parent = row })
		local btn = Create("ImageButton", { BackgroundTransparency = 1, Image = "", Size = UDim2.fromOffset(slotSize, slotSize), Parent = cell })
		local well = Create("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), Position = UDim2.fromOffset(3, 3), Size = UDim2.new(1, -6, 1, -6), Parent = btn }, { Create.corner(7), Create.gradient({ C.leather1, C.void }, 90) })
		local _w = well
		local icon = Atlas.image("icon", ab.icon, { Size = UDim2.fromScale(0.82, 0.82), Position = UDim2.fromScale(0.09, 0.09), ZIndex = 2, Parent = btn })
		local cd = Feedback.radial(scope, { size = slotSize - 8, sprite = "disc", color = C.void, transparency = 0.3, track = false })
		cd.Instance.Position = UDim2.fromOffset(4, 4)
		for _, d in cd.Instance:GetDescendants() do
			if d:IsA("GuiObject") then
				d.ZIndex = 3
			end
		end
		cd.Instance.ZIndex = 3
		cd.Instance.Parent = btn
		local gcdShade = Create("Frame", { BackgroundColor3 = C.void, BackgroundTransparency = 1, Position = UDim2.fromOffset(4, 4), Size = UDim2.new(1, -8, 1, -8), ZIndex = 3, Parent = btn }, { Create.corner(6) })
		local frame = Atlas.image("chrome", "frame_slot", { Size = UDim2.fromScale(1, 1), SliceScale = 0.42, ImageColor3 = if ab.ultimate then C.warn else C.gold, ZIndex = 4, Parent = btn })
		local flash = Atlas.image("chrome", "glow", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1.5, 1.5), ImageColor3 = C.goldPale, ImageTransparency = 1, ZIndex = 6, Parent = btn })
		local cdText = Surface.text({ role = "number", text = "", size = 20, color = C.text, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = 7, Parent = btn })
		cdText.TextStrokeTransparency = 0.2
		local key = Create("Frame", { BackgroundColor3 = C.void, Position = UDim2.fromOffset(3, 3), Size = UDim2.fromOffset(18, 18), ZIndex = 7, Parent = btn }, { Create.corner(4), Create.stroke(C.goldDeep, 1, 0) })
		Surface.text({ role = "tiny", text = ab.key, size = 11, color = C.goldPale, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 8, Parent = key })
		local lock = Atlas.image("glyph", "lock", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.34, 0.34), ImageColor3 = C.textSoft, Visible = ab.locked == true, ZIndex = 7, Parent = btn })
		local _l = lock
		local toggleRing = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 4, 1, 4), Position = UDim2.fromOffset(-2, -2), Visible = false, ZIndex = 5, Parent = btn }, { Create.corner(9), Create.stroke(C.arcane, 2.5, 0) })
		local costText = Surface.text({ role = "number", text = if ab.cost > 0 then tostring(ab.cost) else "", size = 11, color = Color3.fromHex("8FB8F2"), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, slotSize + 2), Parent = cell })
		local pop = Create.scale(1)
		pop.Parent = btn
		local s = { ab = ab, root = cell, btn = btn, icon = icon, cd = cd, gcd = gcdShade, frame = frame, flash = flash, cdText = cdText, toggleRing = toggleRing, costText = costText, pop = pop, readyAt = 0, cdStart = 0, toggled = false, wasCooling = false, hover = false }
		slots[i] = s
		Interact.attach(btn, scope, function(st)
			s.hover = st.hover or st.focused
			Motion.tween(pop, { Scale = if st.pressed then 0.93 elseif st.hover then 1.04 else 1 }, M.fast, nil, nil, "press")
		end, function()
			trigger(i)
		end)
		Feedback.tooltip(scope, btn, function()
			return Abilities.card(ab, { width = 300 })
		end, { side = "above" })
	end

	scope:connect(UserInputService.InputBegan, function(input, processed)
		if processed then
			return
		end
		local i = KEYS[input.KeyCode]
		if i then
			trigger(i)
		end
	end)

	-- per-frame visuals; mana regenerates slowly so the out-of-mana state is recoverable
	scope:connect(RunService.Heartbeat, function(dt)
		if Motion.paused then
			return
		end
		if handle.frozen then
			return
		end
		local now = os.clock()
		for _, s in slots do
			if s.ab.toggle and s.toggled then
				mana = math.max(0, mana - 4 * dt)
				if mana <= 0 then
					s.toggled = false
				end
			end
		end
		mana = math.min(manaMax, mana + 6 * dt)
		manaBar:set(mana, true)
		local gcdLeft = math.max(0, gcdUntil - now)
		for _, s in slots do
			local ab = s.ab
			local left = s.readyAt - now
			local cooling = left > 0
			if cooling then
				s.cd:set(1 - left / ab.cooldown)
				s.cdText.Text = if left >= 1 then tostring(math.ceil(left)) else string.format("%.1f", left)
			else
				s.cd:set(0)
				s.cdText.Text = ""
				if s.wasCooling then
					-- ready flash
					s.flash.ImageColor3 = C.arcane
					s.flash.ImageTransparency = 0.25
					Motion.tween(s.flash, { ImageTransparency = 1 }, 0.5)
				end
			end
			s.wasCooling = cooling
			s.gcd.BackgroundTransparency = if not cooling and gcdLeft > 0 and not ab.toggle and not ab.locked then 0.55 else 1
			local short = ab.cost > mana and not ab.locked
			s.icon.ImageColor3 = if ab.locked then Color3.fromRGB(90, 84, 78) elseif short then Color3.fromRGB(120, 140, 200) else Color3.new(1, 1, 1)
			s.costText.TextColor3 = if short then C.bad else Color3.fromHex("8FB8F2")
			s.toggleRing.Visible = s.toggled
			s.frame.ImageColor3 = if s.toggled then C.arcane elseif ab.locked then C.seam elseif ab.ultimate then C.warn else C.gold
		end
	end)

	handle.Instance = panel
	handle.trigger = function(_, i: number)
		trigger(i)
	end
	handle.setMana = function(_, v: number)
		mana = v
		manaBar:set(v, true)
	end
	handle.reset = function()
		mana = p.mana or 260
		gcdUntil = 0
		for _, s in slots do
			s.readyAt = 0
			s.toggled = false
		end
		manaBar:set(mana, true)
	end
	-- show a frozen cooldown at a given fraction (for state boards)
	handle.freezeAt = function(_, i: number, remaining: number)
		local s = slots[i]
		s.readyAt = os.clock() + remaining
	end
	handle.freeze = function(_, v: boolean)
		handle.frozen = v
	end
	return handle
end

return Abilities
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX27"><Properties><string name="Name">Character</string><ProtectedString name="Source"><![CDATA[--!strict
-- Character components: Vitals, StatusEffects, CharacterCard and the Equipment panel (paperdoll,
-- attribute allocation, derived stats). Local example state only.
local RunService = game:GetService("RunService")

local Theme = require(script.Parent.Parent.Theme)
local Atlas = require(script.Parent.Parent.Atlas)
local Create = require(script.Parent.Parent.Core.Create)
local Store = require(script.Parent.Parent.Core.Store)
local Motion = require(script.Parent.Parent.Core.Motion)
local Surface = require(script.Parent.Parent.Components.Surface)
local Button = require(script.Parent.Parent.Components.Button)
local Controls = require(script.Parent.Parent.Components.Controls)
local Feedback = require(script.Parent.Parent.Components.Feedback)
local Slot = require(script.Parent.Parent.Components.Slot)
local ItemCard = require(script.Parent.Parent.Components.ItemCard)
local Items = require(script.Parent.Parent.Data.Items)
local CharData = require(script.Parent.Parent.Data.Character)

local C = Theme.color
local M = Theme.motion
local Character = {}

local function fmtNum(n: number): string
	return Feedback.formatNumber(n)
end

---------------------------------------------------------------- Vitals
-- props: width, health/mana/stamina {value, max}, level, xp, xpNext, onLevelUp(level)
function Character.vitals(scope: any, props: { [string]: any })
	local width = props.width or 340
	local root = scope:add(Create.box({ Name = "Vitals", Size = UDim2.fromOffset(width, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = props.layoutOrder or 0 }, { Create.list("y", 10) }))
	local hp = Feedback.bar(scope, { label = "Health", glyph = "heart", color = C.health, deep = C.healthDeep, max = props.health and props.health.max or 640, value = props.health and props.health.value or 640, height = 20, layoutOrder = 1 })
	hp.Instance.Parent = root
	local mp = Feedback.bar(scope, { label = "Mana", glyph = "drop", color = C.mana, deep = C.manaDeep, max = props.mana and props.mana.max or 264, value = props.mana and props.mana.value or 264, height = 16, layoutOrder = 2 })
	mp.Instance.Parent = root
	local st = Feedback.bar(scope, { label = "Stamina", glyph = "bolt", color = C.stamina, deep = C.staminaDeep, max = 100, value = 100, height = 12, segments = 5, format = function(v, m)
		return `{math.floor(v / m * 100 + 0.5)}%`
	end, layoutOrder = 3 })
	st.Instance.Parent = root
	-- experience
	local level = props.level or 23
	local xp, xpNext = props.xp or 7420, props.xpNext or 9800
	local xpRow = Create.box({ Size = UDim2.new(1, 0, 0, 34), LayoutOrder = 4, Parent = root })
	local badge = Create.box({ Size = UDim2.fromOffset(34, 34), Parent = xpRow })
	Atlas.image("chrome", "diamond", { Size = UDim2.fromScale(1, 1), ImageColor3 = C.xpDeep, Parent = badge })
	Atlas.image("chrome", "node_diamond", { Size = UDim2.fromScale(1, 1), ZIndex = 2, Parent = badge })
	local lvText = Surface.text({ role = "number", text = tostring(level), size = 13, color = C.goldPale, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = 3, Parent = badge })
	local badgePop = Create.scale(1)
	badgePop.Parent = badge
	local xpBar = Feedback.bar(scope, { color = C.xp, deep = C.xpDeep, max = xpNext, value = xp, height = 10 })
	xpBar.Instance.Position = UDim2.fromOffset(44, 18)
	xpBar.Instance.Size = UDim2.new(1, -44, 0, 10)
	xpBar.Instance.Parent = xpRow
	local xpText = Surface.text({ role = "caps", text = "", size = 10, color = C.textSoft, Position = UDim2.fromOffset(44, 0), Parent = xpRow })
	local function xpLabel()
		xpText.Text = `Level {level} · {fmtNum(xp)} / {fmtNum(xpNext)} XP`
	end
	xpLabel()

	local handle = {} :: any
	handle.Instance = root
	handle.bars = { health = hp, mana = mp, stamina = st }
	function handle.damage(_, n: number)
		hp:set(hp:get() - n)
	end
	function handle.heal(_, n: number)
		hp:set(hp:get() + n)
	end
	function handle.cast(_, n: number)
		mp:set(mp:get() - n)
	end
	function handle.restore()
		hp:set(640)
		mp:set(264)
		st:set(100)
	end
	function handle.sprint(_, n: number)
		st:set(st:get() - n)
	end
	function handle.gainXp(_, n: number)
		xp += n
		if xp >= xpNext then
			xpBar:set(xpNext)
			task.delay(0.45, function()
				xp -= xpNext
				level += 1
				xpNext = math.floor(xpNext * 1.12 / 10) * 10
				lvText.Text = tostring(level)
				Motion.pop(badgePop, 0.35)
				xpBar:setMax(xpNext)
				xpBar:set(0, true)
				xpBar:set(xp)
				xpLabel()
				if props.onLevelUp then
					props.onLevelUp(level)
				end
			end)
		else
			xpBar:set(xp)
		end
		xpLabel()
	end
	function handle.reset()
		level, xp, xpNext = props.level or 23, props.xp or 7420, props.xpNext or 9800
		lvText.Text = tostring(level)
		xpBar:setMax(xpNext)
		xpBar:set(xp, true)
		hp:set(640, true)
		mp:set(264, true)
		st:set(100, true)
		xpLabel()
	end
	return handle
end

---------------------------------------------------------------- StatusEffects
-- props: effects (ids from CharData.effects), size, perRow. Timers tick live; expired effects fade out.
function Character.effects(scope: any, props: { [string]: any })
	local size = props.size or 46
	local root = scope:add(Create.box({ Name = "StatusEffects", Size = UDim2.fromOffset(0, size + 22), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = props.layoutOrder or 0 }, { Create.list("x", 8) }))
	local byId = {}
	for _, e in CharData.effects do
		byId[e.id] = e
	end
	local live: { [string]: any } = {}
	local order = 0
	local function fmt(t: number)
		if t >= 60 then
			return `{math.ceil(t / 60)}m`
		end
		return `{math.ceil(t)}s`
	end
	local handle = {} :: any
	function handle.add(_, id: string, remaining: number?)
		local def = byId[id]
		if live[id] then
			live[id].left = def.duration
			live[id].stacks = math.min((live[id].stacks or 1) + 1, 9)
			live[id].stackText.Text = tostring(live[id].stacks)
			live[id].stackText.Visible = true
			Motion.pop(live[id].pop, 0.2)
			return
		end
		order += 1
		local es = scope:child()
		local cell = es:add(Create.box({ Name = "Effect_" .. id, Size = UDim2.fromOffset(size, size + 22), LayoutOrder = order, Parent = root }))
		local hit = Create("ImageButton", { BackgroundTransparency = 1, Image = "", Size = UDim2.fromOffset(size, size), Parent = cell })
		local color = if def.kind == "buff" then C.gold else C.bad
		Atlas.image("chrome", "disc", { Size = UDim2.fromScale(1, 1), ImageColor3 = C.void, Parent = hit })
		Atlas.image("icon", def.icon, { Size = UDim2.fromScale(0.84, 0.84), Position = UDim2.fromScale(0.08, 0.08), ZIndex = 2, Parent = hit })
		local shade = Feedback.radial(es, { size = size, sprite = "disc", color = C.void, transparency = 0.42, track = false })
		shade.Instance.ZIndex = 3
		for _, d in shade.Instance:GetDescendants() do
			if d:IsA("GuiObject") then
				d.ZIndex = 3
			end
		end
		shade.Instance.Parent = hit
		Atlas.image("chrome", "ring_thin", { Size = UDim2.fromScale(1, 1), ImageColor3 = color, ZIndex = 4, Parent = hit })
		local pop = Create.scale(0.6)
		pop.Parent = hit
		Motion.tween(pop, { Scale = 1 }, M.slow, M.spring)
		local stackText = Surface.text({ role = "number", text = tostring(def.stacks or 1), size = 12, color = C.goldPale, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, 2, 1, 2), Visible = (def.stacks or 1) > 1, ZIndex = 6, Parent = hit })
		stackText.TextStrokeTransparency = 0
		stackText.TextStrokeColor3 = C.void
		local timer = Surface.text({ role = "number", text = "", size = 11, color = if def.kind == "buff" then C.textSoft else C.bad, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, size + 4), Parent = cell })
		local entry = { def = def, left = remaining or def.duration, stacks = def.stacks or 1, shade = shade, timer = timer, stackText = stackText, pop = pop, scope = es, cell = cell }
		live[id] = entry
		Feedback.tooltip(es, hit, function()
			return Feedback.tooltipCard({
				title = def.name,
				accent = color,
				body = def.text .. (if entry.stacks > 1 then ` <font color="#F3D08A">×{entry.stacks}</font>` else ""),
				hint = `{if def.kind == "buff" then "Blessing" else "Affliction"} · {fmt(entry.left)} remaining`,
				width = 220,
			})
		end, { side = "below" })
	end
	function handle.clear()
		for id, e in live do
			e.scope:Destroy()
			live[id] = nil
		end
	end
	function handle.freeze(_, v: boolean)
		handle.frozen = v
	end
	scope:connect(RunService.Heartbeat, function(dt)
		if Motion.paused then
			return
		end
		for id, e in live do
			if not handle.frozen then
				e.left -= dt
			end
			e.shade:set(1 - math.max(0, e.left) / e.def.duration)
			e.timer.Text = fmt(math.max(0, e.left))
			if e.left <= 0 then
				live[id] = nil
				Motion.tween(e.pop, { Scale = 0 }, M.base)
				task.delay(M.base, function()
					e.scope:Destroy()
				end)
			end
		end
	end)
	for _, id in props.effects or {} do
		handle:add(id)
	end
	handle.Instance = root
	return handle
end

---------------------------------------------------------------- Crest (portrait medallion)
function Character.crest(scope: any, props: { [string]: any })
	local size = props.size or 112
	local root = scope:add(Create.box({ Name = "Crest", Size = UDim2.fromOffset(size, size), LayoutOrder = props.layoutOrder or 0 }))
	local ring = Feedback.radial(scope, { size = size, sprite = "ring", color = C.xp, trackColor = C.void, trackTransparency = 0.1, value = props.progress or 0.75 })
	ring.Instance.Parent = root
	Atlas.image("chrome", "disc", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.8, 0.8), ImageColor3 = C.leather0, ZIndex = 3, Parent = root })
	local crest = Atlas.image("chrome", "crest", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.52), Size = UDim2.fromScale(0.5, 0.56), ImageColor3 = props.color or Color3.fromHex("3B6EA8"), ZIndex = 4, Parent = root })
	Create.gradient({ Color3.new(1, 1, 1), Color3.fromRGB(150, 150, 150) }, 90).Parent = crest
	Atlas.image("icon", props.icon or "ward", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.36, 0.36), ZIndex = 5, Parent = root })
	Atlas.image("chrome", "medallion", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.86, 0.86), ZIndex = 6, Parent = root })
	-- level gem at the bottom
	local gem = Create.box({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.94), Size = UDim2.fromOffset(38, 38), ZIndex = 7, Parent = root })
	Atlas.image("chrome", "diamond", { Size = UDim2.fromScale(1, 1), ImageColor3 = C.xpDeep, ZIndex = 7, Parent = gem })
	Atlas.image("chrome", "node_diamond", { Size = UDim2.fromScale(1, 1), ZIndex = 8, Parent = gem })
	local lv = Surface.text({ role = "number", text = tostring(props.level or 1), size = 14, color = C.goldPale, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = 9, Parent = gem })
	return {
		Instance = root,
		ring = ring,
		setLevel = function(_, n: number)
			lv.Text = tostring(n)
		end,
	}
end

---------------------------------------------------------------- CharacterCard
function Character.card(scope: any, props: { [string]: any }?)
	local p = props or {}
	local ch = p.character or CharData.example()
	local panel, content = Surface.panel({ size = UDim2.fromOffset(p.width or 380, 0), autoSize = Enum.AutomaticSize.Y, padding = 16 })
	scope:add(panel)
	Create.list("y", 12).Parent = content
	local top = Create.box({ Size = UDim2.new(1, 0, 0, 118), LayoutOrder = 1, Parent = content })
	local crest = Character.crest(scope, { size = 112, level = ch.level, progress = ch.xp / ch.xpNext, icon = ch.crest })
	crest.Instance.Parent = top
	local names = Create.box({ Position = UDim2.fromOffset(128, 0), Size = UDim2.new(1, -128, 1, 0), Parent = top }, { Create.list("y", 4, nil, Enum.VerticalAlignment.Center) })
	Surface.text({ role = "title", text = ch.name, color = C.goldBright, size = 26, LayoutOrder = 1, Parent = names })
	Surface.text({ role = "lore", text = ch.title, color = C.textSoft, wrap = true, LayoutOrder = 2, Parent = names })
	local tags = Create.box({ Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 3, Parent = names }, { Create.list("x", 6, nil, Enum.VerticalAlignment.Center) })
	Feedback.tag({ text = ch.class, color = C.info, glyph = "shield_small", layoutOrder = 1, parent = tags })
	Feedback.tag({ text = `{ch.points} points`, color = C.goldBright, glyph = "plus", solid = true, layoutOrder = 2, parent = tags })
	local vit = Character.vitals(scope, { width = (p.width or 380) - 40, layoutOrder = 2, level = ch.level, xp = ch.xp, xpNext = ch.xpNext })
	vit.Instance.Parent = content
	return { Instance = panel, vitals = vit, crest = crest }
end

---------------------------------------------------------------- Equipment
local LEFT = { "head", "neck", "back", "chest", "hands" }
local RIGHT = { "waist", "feet", "ring", "mainhand", "offhand" }

function Character.equipment(scope: any, props: { [string]: any }?)
	local _ = props
	local store = Store.new({ ch = CharData.example(), selected = "mainhand", pending = { might = 0, finesse = 0, arcana = 0, vigor = 0 } })
	scope:add(store)
	local slotInfo = {}
	for _, s in Items.slots do
		slotInfo[s.id] = s
	end

	local panel, content = Surface.panel({ title = "Equipment", size = UDim2.fromOffset(880, 620), padding = 18 })
	scope:add(panel)
	-- left: paperdoll + chooser; right: attributes + stats
	local doll = Create.box({ Name = "Paperdoll", Size = UDim2.fromOffset(420, 400), Parent = content })
	local sil = Atlas.image("chrome", "silhouette", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.fromOffset(214, 374), ImageTransparency = 0.05, Parent = doll })
	Atlas.image("chrome", "glow", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), Size = UDim2.fromOffset(300, 300), ImageColor3 = C.gold, ImageTransparency = 0.88, ZIndex = 0, Parent = doll })
	local _s = sil
	local slots = {}
	local function place(list, x: number, anchorX: number)
		for i, sid in list do
			local info = slotInfo[sid]
			local holder = Create.box({ Name = "Slot_" .. sid, AnchorPoint = Vector2.new(anchorX, 0), Position = UDim2.new(x, 0, 0, (i - 1) * 76), Size = UDim2.fromOffset(66, 66), Parent = doll })
			local s = Slot.new(scope, { size = 66, emptyGlyph = info.glyph, label = info.name, onClick = function()
				store:set({ selected = sid })
			end })
			s.Instance.Parent = holder
			slots[sid] = s
			Feedback.tooltip(scope, s.Instance, function()
				local id = store:get().ch.equipped[sid]
				if id then
					return ItemCard.new(Items.get(id), { equipped = true, width = 260 })
				end
				return Feedback.tooltipCard({ title = info.name, body = "Empty slot. Choose an item below.", width = 200 })
			end, { side = if anchorX == 0 then "left" else "right" })
		end
	end
	place(LEFT, 0, 0)
	place(RIGHT, 1, 1)

	-- chooser strip under the paperdoll
	local chooser = Create.box({ Name = "Chooser", Position = UDim2.fromOffset(0, 412), Size = UDim2.fromOffset(420, 152), Parent = content })
	local well = Surface.well({ Size = UDim2.fromScale(1, 1), Parent = chooser })
	local _w = well
	local chooserTitle = Surface.text({ role = "caps", text = "", color = C.gold, Position = UDim2.fromOffset(14, 12), Parent = chooser })
	local candRow = Create.box({ Position = UDim2.fromOffset(14, 38), Size = UDim2.new(1, -28, 0, 60), Parent = chooser }, { Create.list("x", 8, nil, Enum.VerticalAlignment.Center) })
	local chooserHint = Surface.text({ role = "lore", text = "", color = C.textFaint, size = 12, Position = UDim2.fromOffset(14, 112), Size = UDim2.new(1, -150, 0, 28), wrap = false, Parent = chooser })
	local unequip = Button.new(scope, { text = "Unequip", variant = "ghost", size = "small", icon = "close", onClick = function()
		local st = store:get()
		local id = st.ch.equipped[st.selected]
		if not id then
			return
		end
		local ch = Store.copy(st.ch)
		ch.equipped[st.selected] = nil
		table.insert(ch.stash, 1, id)
		store:set({ ch = ch })
	end })
	unequip.Instance.AnchorPoint = Vector2.new(1, 0)
	unequip.Instance.Position = UDim2.new(1, -12, 0, 108)
	unequip.Instance.Parent = chooser
	local candScope: any = nil

	-- right column
	local right = Create.box({ Name = "Sheet", Position = UDim2.fromOffset(446, 0), Size = UDim2.new(1, -446, 1, 0), Parent = content }, { Create.list("y", 10) })
	local head = Create.box({ Size = UDim2.new(1, 0, 0, 58), LayoutOrder = 1, Parent = right })
	local ch0 = store:get().ch
	Surface.text({ role = "title", text = ch0.name, color = C.goldBright, size = 24, Parent = head })
	Surface.text({ role = "lore", text = `Level {ch0.level} {ch0.class} · {ch0.title}`, color = C.textSoft, Position = UDim2.fromOffset(0, 32), Parent = head })
	local attrCap = Surface.caption("Attributes", { LayoutOrder = 2, Parent = right })
	local _a = attrCap
	local pointsTag = Create.box({ Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 3, Parent = right })
	local pointsText = Surface.text({ role = "small", text = "", color = C.textSoft, rich = true, Position = UDim2.fromScale(0, 0.5), AnchorPoint = Vector2.new(0, 0.5), Parent = pointsTag })
	local attrRows = {}
	for i, a in CharData.attributeInfo do
		local row = Create.box({ Name = "Attr_" .. a.id, Size = UDim2.new(1, 0, 0, 36), LayoutOrder = 3 + i, Parent = right })
		Create("Frame", { BackgroundColor3 = C.void, BackgroundTransparency = 0.6, Size = UDim2.fromScale(1, 1), Parent = row }, { Create.corner(5) })
		Atlas.image("glyph", a.glyph, { Size = UDim2.fromOffset(18, 18), Position = UDim2.fromOffset(10, 9), ImageColor3 = C.gold, Parent = row })
		local name = Surface.text({ role = "label", text = a.name, size = 15, Position = UDim2.fromOffset(38, 0), Size = UDim2.new(0, 120, 1, 0), Parent = row })
		local val = Surface.text({ role = "number", text = "", size = 17, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -86, 0.5, 0), TextXAlignment = Enum.TextXAlignment.Right, Parent = row })
		local minus = Controls.iconButton(scope, { icon = "minus", size = 30, onClick = function()
			local st = store:get()
			if st.pending[a.id] > 0 then
				local pnd = table.clone(st.pending)
				pnd[a.id] -= 1
				store:set({ pending = pnd })
			end
		end })
		minus.Instance.AnchorPoint = Vector2.new(1, 0.5)
		minus.Instance.Position = UDim2.new(1, -42, 0.5, 0)
		minus.Instance.Parent = row
		local plus = Controls.iconButton(scope, { icon = "plus", size = 30, tone = "arcane", onClick = function()
			local st = store:get()
			local spent = 0
			for _, v in st.pending do
				spent += v
			end
			if spent < st.ch.points then
				local pnd = table.clone(st.pending)
				pnd[a.id] += 1
				store:set({ pending = pnd })
			else
				Motion.shake(row)
			end
		end })
		plus.Instance.AnchorPoint = Vector2.new(1, 0.5)
		plus.Instance.Position = UDim2.new(1, -6, 0.5, 0)
		plus.Instance.Parent = row
		Feedback.tooltip(scope, row, function()
			return Feedback.tooltipCard({ title = a.name, body = a.text, width = 220 })
		end, { side = "left" })
		attrRows[a.id] = { val = val, minus = minus, plus = plus, name = name }
	end
	local applyRow = Create.box({ Size = UDim2.new(1, 0, 0, 34), LayoutOrder = 9, Parent = right }, { Create.list("x", 10, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center) })
	local undo = Button.new(scope, { text = "Undo", variant = "ghost", size = "small", layoutOrder = 1, onClick = function()
		store:set({ pending = { might = 0, finesse = 0, arcana = 0, vigor = 0 } })
	end })
	undo.Instance.Parent = applyRow
	local apply = Button.new(scope, { text = "Commit points", variant = "primary", size = "small", icon = "check", layoutOrder = 2, onClick = function()
		local st = store:get()
		local ch = Store.copy(st.ch)
		local spent = 0
		for k, v in st.pending do
			ch.attributes[k] += v
			spent += v
		end
		ch.points -= spent
		store:set({ ch = ch, pending = { might = 0, finesse = 0, arcana = 0, vigor = 0 } })
		Feedback.toast(scope, { tone = "success", title = "Attributes committed", text = `{spent} point{if spent == 1 then "" else "s"} spent.`, duration = 3 })
	end })
	apply.Instance.Parent = applyRow

	Surface.caption("Derived", { LayoutOrder = 10, Parent = right })
	local statsGrid = Create.box({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 11, Parent = right }, {
		Create.new("UIGridLayout", { CellSize = UDim2.new(0.5, -6, 0, 30), CellPadding = UDim2.fromOffset(12, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local statRows = {}
	for i, d in CharData.derivedOrder do
		local row = Create.box({ Name = "Stat_" .. d.id, LayoutOrder = i, Parent = statsGrid })
		Atlas.image("glyph", d.glyph, { Size = UDim2.fromOffset(15, 15), Position = UDim2.fromOffset(0, 8), ImageColor3 = C.textFaint, Parent = row })
		Surface.text({ role = "small", text = d.name, color = C.textSoft, Position = UDim2.fromOffset(22, 0), Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, Parent = row })
		local v = Surface.text({ role = "number", text = "", size = 15, AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, Parent = row })
		Create("Frame", { BackgroundColor3 = C.seam, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 1), Parent = row })
		statRows[d.id] = { label = v, def = d, last = nil :: number? }
	end

	local function preview(st)
		local ch = Store.copy(st.ch)
		for k, v in st.pending do
			ch.attributes[k] += v
		end
		return ch
	end

	local function renderChooser(st)
		if candScope then
			candScope:Destroy()
		end
		candScope = scope:child()
		local sid = st.selected
		local info = slotInfo[sid]
		chooserTitle.Text = `{info.name} — choose an item`
		local current = st.ch.equipped[sid]
		local n = 0
		for _, id in st.ch.stash do
			local it = Items.get(id)
			if it.slot == sid then
				n += 1
				local s = Slot.new(candScope, { size = 56, item = it, layoutOrder = n, onClick = function()
					local s2 = store:get()
					local ch = Store.copy(s2.ch)
					local prev = ch.equipped[sid]
					ch.equipped[sid] = id
					local idx = table.find(ch.stash, id)
					if idx then
						table.remove(ch.stash, idx)
					end
					if prev then
						table.insert(ch.stash, 1, prev)
					end
					store:set({ ch = ch })
					slots[sid]:pop()
				end })
				s.Instance.Parent = candRow
				Feedback.tooltip(candScope, s.Instance, function()
					return ItemCard.new(it, { compare = current and Items.get(current) or nil, width = 270 })
				end, { side = "above" })
			end
		end
		chooserHint.Text = if n == 0 then "Nothing in the satchel fits this slot." else "Hover to compare · click to equip"
		unequip:setDisabled(current == nil)
	end

	local function render(st, prev)
		for sid, s in slots do
			local id = st.ch.equipped[sid]
			s:setItem(if id then Items.get(id) else nil)
			s:set({ selected = st.selected == sid })
		end
		if not prev or prev.selected ~= st.selected or prev.ch ~= st.ch then
			renderChooser(st)
		end
		local spent = 0
		for _, v in st.pending do
			spent += v
		end
		local left = st.ch.points - spent
		pointsText.Text = if left > 0 then `<font color="#57D1C4"><b>{left}</b></font> unspent point{if left == 1 then "" else "s"}` elseif st.ch.points > 0 then "All points assigned — commit to keep them" else "No unspent points"
		for k, r in attrRows do
			local base = st.ch.attributes[k]
			local p = st.pending[k]
			r.val.Text = if p > 0 then `{base} <font color="#57D1C4">+{p}</font>` else tostring(base)
			r.val.RichText = true
			r.minus.controller:set({ disabled = p == 0 })
			r.plus.controller:set({ disabled = left == 0 })
		end
		undo:setDisabled(spent == 0)
		apply:setDisabled(spent == 0)
		local d = CharData.derive(preview(st))
		for id, r in statRows do
			local v = d[id]
			local txt = function(x: number)
				r.label.Text = if r.def.pct then string.format("%.1f%%", x) else fmtNum(x)
			end
			if r.last ~= nil and r.last ~= v then
				local up = v > r.last
				r.label.TextColor3 = if up then C.good else C.bad
				Motion.number(r.last, v, 0.5, txt)
				task.delay(0.9, function()
					Motion.tween(r.label, { TextColor3 = C.text }, M.slow)
				end)
			else
				txt(v)
			end
			r.last = v
		end
	end
	scope:add(store:subscribe(render))
	render(store:get(), nil)

	return {
		Instance = panel,
		store = store,
		slots = slots,
		reset = function()
			store:reset()
		end,
		equip = function(_, sid: string, id: string)
			store:set({ selected = sid })
			local st = store:get()
			local ch = Store.copy(st.ch)
			local prev = ch.equipped[sid]
			ch.equipped[sid] = id
			local idx = table.find(ch.stash, id)
			if idx then
				table.remove(ch.stash, idx)
			end
			if prev then
				table.insert(ch.stash, 1, prev)
			end
			store:set({ ch = ch })
		end,
	}
end

return Character
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX28"><Properties><string name="Name">Commerce</string><ProtectedString name="Source"><![CDATA[--!strict
-- Crafting & commerce: the crafting station (recipes, material requirements, quantity, timed progress)
-- and a vendor (buy / sell, stock, discounts, purchase confirmation with balance preview). Gold, stock and
-- materials are local example state: no economy, no backend, no real purchases.
local RunService = game:GetService("RunService")

local Theme = require(script.Parent.Parent.Theme)
local Atlas = require(script.Parent.Parent.Atlas)
local Create = require(script.Parent.Parent.Core.Create)
local Store = require(script.Parent.Parent.Core.Store)
local Motion = require(script.Parent.Parent.Core.Motion)
local Interact = require(script.Parent.Parent.Core.Interact)
local Surface = require(script.Parent.Parent.Components.Surface)
local Button = require(script.Parent.Parent.Components.Button)
local Controls = require(script.Parent.Parent.Components.Controls)
local Feedback = require(script.Parent.Parent.Components.Feedback)
local Slot = require(script.Parent.Parent.Components.Slot)
local ItemCard = require(script.Parent.Parent.Components.ItemCard)
local Items = require(script.Parent.Parent.Data.Items)
local Recipes = require(script.Parent.Parent.Data.Recipes)

local C = Theme.color
local M = Theme.motion
local Commerce = {}
local fmt = Feedback.formatNumber

---------------------------------------------------------------- crafting rules (pure)
function Commerce.maxCraftable(stock, recipe): number
	local n = math.huge
	for _, m in recipe.materials do
		n = math.min(n, math.floor((stock[m.id] or 0) / m.need))
	end
	return if n == math.huge then 0 else n
end

function Commerce.missing(stock, recipe, qty: number)
	local out = {}
	for _, m in recipe.materials do
		local short = m.need * qty - (stock[m.id] or 0)
		if short > 0 then
			table.insert(out, { id = m.id, short = short })
		end
	end
	return out
end

---------------------------------------------------------------- Crafting station
function Commerce.crafting(scope: any, props: { [string]: any }?)
	local _ = props
	local store = Store.new({ stock = table.clone(Recipes.stock), category = 1, selected = "r_dawnsteel", qty = 1, crafting = nil :: any, crafted = {} })
	scope:add(store)
	local panel, content = Surface.panel({ title = "Forge & Workbench", size = UDim2.fromOffset(900, 580), padding = 18 })
	scope:add(panel)

	-- left: categories + recipe list
	local left = Create.box({ Size = UDim2.new(0, 330, 1, 0), Parent = content })
	local seg = Controls.segmented(scope, { options = Recipes.categories, index = 1, width = 330, changed = function(i)
		local first
		for _, r in Recipes.list do
			if r.category == Recipes.categories[i] then
				first = first or r.id
			end
		end
		store:set({ category = i, selected = first, qty = 1 })
	end })
	seg.Instance.Parent = left
	local list = Create("ScrollingFrame", {
		BackgroundColor3 = C.void,
		BackgroundTransparency = 0.5,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 48),
		Size = UDim2.new(1, 0, 1, -48),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = C.goldDeep,
		Parent = left,
	}, { Create.corner(6), Create.padding(8), Create.list("y", 6) })

	-- right: detail
	local right = Create.box({ Position = UDim2.fromOffset(348, 0), Size = UDim2.new(1, -348, 1, 0), Parent = content })
	local rScope: any = nil
	local listScope: any = nil

	local function recipe(id: string)
		for _, r in Recipes.list do
			if r.id == id then
				return r
			end
		end
		error(id)
	end

	local function renderList(st)
		if listScope then
			listScope:Destroy()
		end
		listScope = scope:child()
		local n = 0
		for _, r in Recipes.list do
			if r.category ~= Recipes.categories[st.category] then
				continue
			end
			n += 1
			local it = Items.get(r.result)
			local can = Commerce.maxCraftable(st.stock, r)
			local row = listScope:add(Create("TextButton", { Name = r.id, Text = "", BackgroundColor3 = C.leather2, Size = UDim2.new(1, 0, 0, 58), LayoutOrder = n, Parent = list }, { Create.corner(6) }))
			local stroke = Create.stroke(C.seam, 1.5, 0)
			stroke.Parent = row
			local s = Slot.new(listScope, { size = 46, item = it, count = r.count })
			s.Instance.Position = UDim2.fromOffset(6, 6)
			s.Instance.Parent = row
			s.Instance.Active = false
			s.Instance.Interactable = false
			Surface.text({ role = "label", text = it.name, size = 15, color = Theme.rarityOf(it.rarity).color:Lerp(Color3.new(1, 1, 1), 0.25), Position = UDim2.fromOffset(62, 9), Parent = row })
			Surface.text({ role = "small", text = if can > 0 then `Can craft {can}` else "Missing materials", size = 12, color = if can > 0 then C.good else C.bad, Position = UDim2.fromOffset(62, 32), Parent = row })
			Surface.text({ role = "caps", text = `Lv {r.level}`, size = 10, color = C.textFaint, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 10), Parent = row })
			Interact.attach(row, listScope, function(state)
				local sel = st.selected == r.id
				row.BackgroundColor3 = if sel then C.leather3 elseif state.hover then C.leather2:Lerp(C.leather3, 0.5) else C.leather2
				stroke.Color = if sel then C.gold elseif state.focused then C.arcane else C.seam
			end, function()
				if store:get().crafting then
					return
				end
				store:set({ selected = r.id, qty = 1 })
			end)
		end
	end

	local function renderDetail(st)
		if rScope then
			rScope:Destroy()
		end
		rScope = scope:child()
		local r = recipe(st.selected)
		local it = Items.get(r.result)
		local can = Commerce.maxCraftable(st.stock, r)
		local body = rScope:add(Create.box({ Size = UDim2.fromScale(1, 1), Parent = right }))
		-- preview: big slot + name + stats summary
		local head = Create.box({ Size = UDim2.new(1, 0, 0, 104), Parent = body })
		local big = Slot.new(rScope, { size = 96, item = it, count = r.count * st.qty })
		big.Instance.Parent = head
		Feedback.tooltip(rScope, big.Instance, function()
			return ItemCard.new(it, { count = r.count })
		end, { side = "below" })
		local names = Create.box({ Position = UDim2.fromOffset(112, 0), Size = UDim2.new(1, -112, 1, 0), Parent = head }, { Create.list("y", 4, nil, Enum.VerticalAlignment.Center) })
		local rar = Theme.rarityOf(it.rarity)
		Surface.text({ role = "title", text = it.name, size = 24, color = rar.color:Lerp(Color3.new(1, 1, 1), 0.2), LayoutOrder = 1, Parent = names })
		Surface.text({ role = "small", text = `{rar.name} {it.type} · {Recipes.categories[st.category]} · {r.time}s`, color = C.textSoft, LayoutOrder = 2, Parent = names })
		if it.stats then
			local parts = {}
			for _, k in Items.statOrder do
				if it.stats[k] then
					table.insert(parts, Items.formatStat(k, it.stats[k]))
				end
			end
			Surface.text({ role = "small", text = table.concat(parts, "  ·  "), color = C.text, size = 13, wrap = true, LayoutOrder = 3, Parent = names })
		elseif it.effect then
			Surface.text({ role = "small", text = it.effect, color = C.arcane, size = 13, wrap = true, LayoutOrder = 3, Parent = names })
		end
		Surface.caption("Materials", { Position = UDim2.fromOffset(0, 118), Parent = body })
		local mats = Create.box({ Position = UDim2.fromOffset(0, 144), Size = UDim2.new(1, 0, 0, 200), Parent = body }, { Create.list("y", 6) })
		for i, m in r.materials do
			local mi = Items.get(m.id)
			local have = st.stock[m.id] or 0
			local need = m.need * st.qty
			local ok = have >= need
			local row = Create("Frame", { BackgroundColor3 = C.void, BackgroundTransparency = 0.55, Size = UDim2.new(1, 0, 0, 52), LayoutOrder = i, Parent = mats }, { Create.corner(6) })
			if not ok then
				Create.stroke(C.bad, 1, 0.5).Parent = row
			end
			local s = Slot.new(rScope, { size = 44, item = mi })
			s.Instance.Position = UDim2.fromOffset(4, 4)
			s.Instance.Parent = row
			Feedback.tooltip(rScope, s.Instance, function()
				return ItemCard.new(mi, { count = have })
			end, { side = "left" })
			Surface.text({ role = "label", text = mi.name, size = 15, Position = UDim2.fromOffset(60, 7), Parent = row })
			Surface.text({ role = "small", text = if ok then "In your satchel" else `Missing {need - have}`, size = 12, color = if ok then C.textFaint else C.bad, Position = UDim2.fromOffset(60, 29), Parent = row })
			Surface.text({ role = "number", text = `{have} / {need}`, size = 17, color = if ok then C.good else C.bad, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -16, 0.5, 0), Parent = row })
		end
		-- footer: quantity + craft
		local foot = Create.box({ AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 96), Parent = body })
		local qtyRow = Create.box({ Size = UDim2.new(1, 0, 0, 40), Parent = foot }, { Create.list("x", 8, nil, Enum.VerticalAlignment.Center) })
		Surface.text({ role = "caps", text = "Quantity", size = 11, color = C.gold, LayoutOrder = 1, Parent = qtyRow })
		local minus = Controls.iconButton(rScope, { icon = "minus", size = 34, layoutOrder = 2, disabled = st.qty <= 1 or st.crafting ~= nil, onClick = function()
			store:set({ qty = math.max(1, store:get().qty - 1) })
		end })
		minus.Instance.Parent = qtyRow
		local qbox = Create("Frame", { BackgroundColor3 = C.void, Size = UDim2.fromOffset(52, 34), LayoutOrder = 3, Parent = qtyRow }, { Create.corner(5), Create.stroke(C.goldDeep, 1, 0) })
		Surface.text({ role = "number", text = tostring(st.qty), size = 17, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, Parent = qbox })
		local plus = Controls.iconButton(rScope, { icon = "plus", size = 34, layoutOrder = 4, disabled = st.qty >= math.max(1, can) or st.crafting ~= nil, onClick = function()
			store:set({ qty = store:get().qty + 1 })
		end })
		plus.Instance.Parent = qtyRow
		Surface.text({ role = "small", text = `max {can}`, size = 12, color = C.textFaint, LayoutOrder = 5, Parent = qtyRow })
		local missing = Commerce.missing(st.stock, r, st.qty)
		local progressHolder = Create.box({ Position = UDim2.fromOffset(0, 52), Size = UDim2.new(1, -196, 0, 44), Parent = foot })
		if st.crafting then
			local bar = Feedback.bar(rScope, { label = `Crafting {st.crafting.done + 1} of {st.qty}…`, glyph = "hammer", color = C.warn, max = 1, value = 0, height = 14, format = function(v)
				return `{math.floor(v * 100)}%`
			end })
			bar.Instance.Parent = progressHolder
			rScope:connect(RunService.Heartbeat, function()
				if Motion.paused then
					return
				end
				local cr = store:get().crafting
				if cr then
					bar:set(math.clamp((os.clock() - cr.started) / r.time, 0, 1), true)
				end
			end)
		elseif #missing > 0 then
			local parts = {}
			for _, mm in missing do
				table.insert(parts, `{mm.short} {Items.get(mm.id).name}`)
			end
			Surface.text({ role = "small", text = "Missing: " .. table.concat(parts, ", "), color = C.bad, wrap = true, Parent = progressHolder })
		else
			Surface.text({ role = "lore", text = `Uses {#r.materials} materials · takes {r.time * st.qty}s`, color = C.textFaint, Position = UDim2.fromOffset(0, 12), Parent = progressHolder })
		end
		local btn = Button.new(rScope, {
			text = if st.crafting then "Cancel" else "Craft",
			variant = if st.crafting then "secondary" else "primary",
			icon = if st.crafting then "close" else "hammer",
			width = 180,
			size = "large",
			disabled = st.crafting == nil and #missing > 0,
			onClick = function()
				local cur = store:get()
				if cur.crafting then
					store:set({ crafting = Store.NONE })
					Feedback.toast(scope, { tone = "warning", title = "Crafting cancelled", text = "Materials for unfinished items were kept.", duration = 2.5 })
				else
					store:set({ crafting = { started = os.clock(), done = 0, id = r.id } })
				end
			end,
		})
		btn.Instance.AnchorPoint = Vector2.new(1, 1)
		btn.Instance.Position = UDim2.fromScale(1, 1)
		btn.Instance.Parent = foot
	end

	local function render(st, prev)
		if not prev or prev.category ~= st.category or prev.stock ~= st.stock or prev.selected ~= st.selected then
			renderList(st)
		end
		renderDetail(st)
		seg:set(st.category)
	end
	scope:add(store:subscribe(render))
	render(store:get(), nil)

	-- crafting clock: one item per recipe.time, materials consumed per item
	scope:connect(RunService.Heartbeat, function()
		if Motion.paused then
			return
		end
		local st = store:get()
		local cr = st.crafting
		if not cr then
			return
		end
		local r = recipe(cr.id)
		if os.clock() - cr.started >= r.time then
			local stock = table.clone(st.stock)
			for _, m in r.materials do
				stock[m.id] -= m.need
			end
			local done = cr.done + 1
			local it = Items.get(r.result)
			local nextCr = if done < st.qty and Commerce.maxCraftable(stock, r) > 0 then { started = os.clock(), done = done, id = r.id } else nil
			store:set({ stock = stock, crafting = nextCr or Store.NONE, qty = if nextCr then st.qty else 1 })
			Feedback.toast(scope, { tone = "reward", title = `Crafted {it.name}`, text = `×{r.count} added to your satchel.`, icon = it.icon, duration = 2.6 })
		end
	end)

	return {
		Instance = panel,
		store = store,
		reset = function()
			store:reset()
		end,
		select = function(_, id: string, qty: number?)
			store:set({ selected = id, qty = qty or 1 })
		end,
		craft = function()
			local st = store:get()
			if not st.crafting and #Commerce.missing(st.stock, recipe(st.selected), st.qty) == 0 then
				store:set({ crafting = { started = os.clock(), done = 0, id = st.selected } })
			end
		end,
	}
end

---------------------------------------------------------------- Vendor item card
function Commerce.vendorCard(scope: any, entry, props: { [string]: any })
	local it = Items.get(entry.id)
	local rar = Theme.rarityOf(it.rarity)
	local price = if entry.discount then math.floor(entry.price * (100 - entry.discount) / 100) else entry.price
	local root = scope:add(Create("TextButton", { Name = "Vendor_" .. entry.id, Text = "", BackgroundColor3 = Color3.new(1, 1, 1), LayoutOrder = props.layoutOrder or 0 }, { Create.corner(7), Create.gradient({ C.leather2, C.leather1 }, 90) }))
	local stroke = Create.stroke(C.seam, 1.5, 0)
	stroke.Parent = root
	local s = Slot.new(scope, { size = 60, item = it })
	s.Instance.Position = UDim2.fromOffset(10, 10)
	s.Instance.Interactable = false
	s.Instance.Parent = root
	Surface.text({ role = "label", text = it.name, size = 14, color = rar.color:Lerp(Color3.new(1, 1, 1), 0.25), Position = UDim2.fromOffset(80, 12), Size = UDim2.new(1, -88, 0, 36), wrap = false, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Parent = root })
	Surface.text({ role = "caps", text = it.type, size = 9, color = C.textFaint, Position = UDim2.fromOffset(80, 50), Parent = root })
	local priceRow = Create.box({ Position = UDim2.new(0, 10, 1, -32), Size = UDim2.new(1, -20, 0, 24), Parent = root }, { Create.list("x", 5, nil, Enum.VerticalAlignment.Center) })
	Atlas.image("glyph", "coin", { Size = UDim2.fromOffset(15, 15), ImageColor3 = C.goldBright, LayoutOrder = 1, Parent = priceRow })
	local priceText = Surface.text({ role = "number", text = fmt(price), size = 15, color = C.goldBright, LayoutOrder = 2, Parent = priceRow })
	if entry.discount then
		local old = Surface.text({ role = "small", text = `<s>{fmt(entry.price)}</s>`, rich = true, size = 12, color = C.textFaint, LayoutOrder = 3, Parent = priceRow })
		local _o = old
	end
	local stockText = Surface.text({ role = "caps", text = "", size = 9, color = C.textFaint, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, if entry.discount then -64 else -10, 1, -20), Parent = root })
	local tag: Frame? = nil
	if entry.discount then
		tag = Feedback.tag({ text = `−{entry.discount}%`, color = C.good, solid = true, height = 18, textSize = 10, parent = root })
		tag.AnchorPoint = Vector2.new(1, 1)
		tag.Position = UDim2.new(1, -10, 1, -10)
		tag.ZIndex = 5
	end
	local veil = Create("Frame", { BackgroundColor3 = C.void, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 6, Parent = root }, { Create.corner(7) })
	local soldOut = Surface.text({ role = "heading", text = "Sold out", size = 18, color = C.textSoft, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Rotation = -8, Visible = false, ZIndex = 7, Parent = root })
	local press = Create.scale(1)
	press.Parent = root
	local gold = 0
	local stock = entry.stock
	local ctl
	local function paint(st)
		local out = stock == 0
		local poor = price > gold
		priceText.TextColor3 = if poor then C.bad else C.goldBright
		stroke.Color = if out then C.seam elseif st.hover or st.focused then C.gold else C.seam
		veil.BackgroundTransparency = if out then 0.35 else 1
		soldOut.Visible = out
		stockText.Text = if stock == nil then "" elseif out then "" else `{stock} left`
		Motion.tween(press, { Scale = if st.pressed and not out then 0.97 elseif st.hover and not out then 1.02 else 1 }, M.fast, nil, nil, "press")
	end
	ctl = Interact.attach(root, scope, paint, function()
		if stock ~= 0 and props.onClick then
			props.onClick(entry, price)
		end
	end)
	Feedback.tooltip(scope, root, function()
		return ItemCard.new(it, { price = price })
	end, { side = "right", delay = 0.35 })
	return {
		Instance = root,
		price = price,
		update = function(_, g: number, st: number?)
			gold = g
			stock = st
			paint(ctl.state)
		end,
		force = function(_, p)
			ctl:force(p)
		end,
	}
end

---------------------------------------------------------------- Vendor
function Commerce.vendor(scope: any, props: { [string]: any }?)
	local _ = props
	local function initial()
		local stock = {}
		for _, e in Recipes.vendor.items do
			stock[e.id] = e.stock
		end
		return {
			gold = 1840,
			mode = 1,
			stock = stock,
			bag = { { id = "woodcutter_axe", count = 1 }, { id = "traveler_gloves", count = 1 }, { id = "iron_ore", count = 40 }, { id = "glowcap", count = 14 }, { id = "warden_mace", count = 1 }, { id = "emberstone", count = 4 } },
		}
	end
	local store = Store.new(initial())
	scope:add(store)
	local panel, content = Surface.panel({ title = Recipes.vendor.name, size = UDim2.fromOffset(820, 500), padding = 18 })
	scope:add(panel)
	local top = Create.box({ Size = UDim2.new(1, 0, 0, 40), Parent = content })
	local seg = Controls.segmented(scope, { options = { "Buy", "Sell" }, index = 1, width = 220, changed = function(i)
		store:set({ mode = i })
	end })
	seg.Instance.Parent = top
	Surface.text({ role = "lore", text = Recipes.vendor.subtitle, color = C.textFaint, Position = UDim2.fromOffset(236, 10), Parent = top })
	local wallet = Create("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromOffset(190, 40), BackgroundColor3 = C.void, BackgroundTransparency = 0.4, Parent = top }, { Create.corner(8), Create.list("x", 16, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center) })
	local gold = Feedback.currency(scope, { amount = store:get().gold, kind = "gold", size = 17, layoutOrder = 1 })
	gold.Instance.Parent = wallet
	Feedback.currency(scope, { amount = 36, kind = "gem", size = 17, layoutOrder = 2 }).Instance.Parent = wallet

	local grid = Create("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 56),
		Size = UDim2.new(1, 0, 1, -56),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = C.goldDeep,
		Parent = content,
	}, {
		Create.padding(10, 6, 6, 6),
		Create.new("UIGridLayout", { CellSize = UDim2.fromOffset(240, 112), CellPadding = UDim2.fromOffset(14, 14), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local gScope: any = nil
	local cards = {}

	local function buy(entry, price)
		local st = store:get()
		local it = Items.get(entry.id)
		local maxQty = math.max(1, math.min(if entry.stock then st.stock[entry.id] else 20, math.max(1, math.floor(st.gold / price))))
		local qty = 1
		local after: TextLabel? = nil
		local totalText: TextLabel? = nil
		local m
		local function refresh()
			local total = price * qty
			local left = st.gold - total
			if totalText then
				totalText.Text = fmt(total)
			end
			if after then
				after.Text = fmt(left)
				after.TextColor3 = if left < 0 then C.bad else C.text
			end
			if m then
				m.confirm:setDisabled(left < 0)
				m.confirm:setText(if left < 0 then "Not enough gold" else `Buy for {fmt(total)}`)
			end
		end
		m = Feedback.modal(scope, {
			title = "Purchase",
			icon = it.icon,
			glow = Theme.rarityOf(it.rarity).color,
			body = `Buy <b>{it.name}</b> from {Recipes.vendor.name}?`,
			width = 440,
			confirm = { text = "Buy", variant = "primary" },
			extra = function(holder, s)
				Create.list("y", 8).Parent = holder
				if it.stack and maxQty > 1 then
					local sl = Controls.slider(s, { label = "Quantity", min = 1, max = maxQty, value = 1, layoutOrder = 1, changed = function(v)
						qty = v
						refresh()
					end })
					sl.Instance.Parent = holder
				end
				local function line(o: number, label: string, glyph: boolean): TextLabel
					local r = Create.box({ Size = UDim2.new(1, 0, 0, 24), LayoutOrder = o, Parent = holder })
					Surface.text({ role = "small", text = label, color = C.textSoft, Position = UDim2.fromOffset(0, 3), Parent = r })
					local right = Create.box({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromOffset(0, 24), AutomaticSize = Enum.AutomaticSize.X, Parent = r }, { Create.list("x", 5, nil, Enum.VerticalAlignment.Center) })
					if glyph then
						Atlas.image("glyph", "coin", { Size = UDim2.fromOffset(14, 14), ImageColor3 = C.goldBright, LayoutOrder = 1, Parent = right })
					end
					return Surface.text({ role = "number", text = "", size = 15, LayoutOrder = 2, Parent = right })
				end
				line(2, "Balance", true).Text = fmt(st.gold)
				totalText = line(3, "Total", true)
				Create("Frame", { BackgroundColor3 = C.seam, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 1), LayoutOrder = 4, Parent = holder })
				after = line(5, "After purchase", true)
			end,
			onConfirm = function()
				local cur = store:get()
				local total = price * qty
				if cur.gold < total then
					return
				end
				local stock = table.clone(cur.stock)
				if stock[entry.id] then
					stock[entry.id] -= qty
				end
				local bag = Store.copy(cur.bag)
				table.insert(bag, 1, { id = entry.id, count = qty })
				store:set({ gold = cur.gold - total, stock = stock, bag = bag })
				Feedback.toast(scope, { tone = "reward", title = "Purchased", text = `{it.name}{if qty > 1 then ` ×{qty}` else ""} for {fmt(total)} gold.`, icon = it.icon, duration = 3 })
			end,
		})
		refresh()
		return m
	end

	local function sell(index: number)
		local st = store:get()
		local e = st.bag[index]
		local it = Items.get(e.id)
		local value = math.max(1, math.floor(it.value * 0.5)) * e.count
		Feedback.modal(scope, {
			title = "Sell item",
			icon = it.icon,
			glow = Theme.rarityOf(it.rarity).color,
			body = `Sell <b>{it.name}</b>{if e.count > 1 then ` ×{e.count}` else ""} for <font color="#F3D08A"><b>{fmt(value)}</b></font> gold?`,
			confirm = { text = "Sell", variant = "primary" },
			onConfirm = function()
				local cur = store:get()
				local bag = Store.copy(cur.bag)
				table.remove(bag, index)
				store:set({ gold = cur.gold + value, bag = bag })
			end,
		})
	end

	local function render(st, prev)
		if prev and prev.gold ~= st.gold then
			gold:set(st.gold)
		end
		seg:set(st.mode)
		if prev and prev.mode == st.mode and prev.bag == st.bag then
			for id, c in cards do
				c:update(st.gold, st.stock[id])
			end
			return
		end
		if gScope then
			gScope:Destroy()
		end
		gScope = scope:child()
		table.clear(cards)
		if st.mode == 1 then
			for i, e in Recipes.vendor.items do
				local c = Commerce.vendorCard(gScope, e, { layoutOrder = i, onClick = buy })
				c.Instance.Parent = grid
				c:update(st.gold, st.stock[e.id])
				cards[e.id] = c
			end
		else
			for i, e in st.bag do
				local it = Items.get(e.id)
				local entry = { id = e.id, price = math.max(1, math.floor(it.value * 0.5)) * e.count }
				local c = Commerce.vendorCard(gScope, entry, { layoutOrder = i, onClick = function()
					sell(i)
				end })
				c.Instance.Parent = grid
				c:update(math.huge, nil)
			end
		end
	end
	scope:add(store:subscribe(render))
	render(store:get(), nil)

	return {
		Instance = panel,
		store = store,
		cards = cards,
		buy = function(_, id: string)
			for _, e in Recipes.vendor.items do
				if e.id == id then
					local price = if e.discount then math.floor(e.price * (100 - e.discount) / 100) else e.price
					return buy(e, price)
				end
			end
			return nil
		end,
		reset = function()
			local init = initial()
			store:set(init)
			gold:set(init.gold, true)
		end,
	}
end

return Commerce
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX29"><Properties><string name="Name">Inventory</string><ProtectedString name="Source"><![CDATA[--!strict
-- Inventory ("Satchel"): a slot grid driven by a local Store.
--   • drag an item onto another slot to move / swap it; same stackable item merges stacks
--   • click (or Enter) picks an item up, click another slot to place it — the keyboard path for moves
--   • category filter and search reduce the grid to matching items; sort rewrites the slot order
--   • hover / focus shows the item card compared against what is equipped
--   • right-click opens a context menu: use, equip, split stack, mark as junk, discard (with confirm)
-- Everything is local example state. Nothing is persisted.
local UserInputService = game:GetService("UserInputService")

local Theme = require(script.Parent.Parent.Theme)
local Atlas = require(script.Parent.Parent.Atlas)
local Create = require(script.Parent.Parent.Core.Create)
local Store = require(script.Parent.Parent.Core.Store)
local Layers = require(script.Parent.Parent.Core.Layers)
local DragDrop = require(script.Parent.Parent.Core.DragDrop)
local Surface = require(script.Parent.Parent.Components.Surface)
local Controls = require(script.Parent.Parent.Components.Controls)
local Feedback = require(script.Parent.Parent.Components.Feedback)
local Slot = require(script.Parent.Parent.Components.Slot)
local ItemCard = require(script.Parent.Parent.Components.ItemCard)
local Items = require(script.Parent.Parent.Data.Items)

local C = Theme.color
local Inventory = {}

Inventory.categories = {
	{ id = "all", name = "All items", glyph = "bag" },
	{ id = "weapon", name = "Weapons", glyph = "sword_small" },
	{ id = "armor", name = "Armour", glyph = "shield_small" },
	{ id = "trinket", name = "Trinkets", glyph = "gem" },
	{ id = "consumable", name = "Consumables", glyph = "drop" },
	{ id = "material", name = "Materials", glyph = "hammer" },
	{ id = "quest", name = "Quest items", glyph = "quest" },
}
Inventory.sorts = { "Rarity", "Type", "Name", "Value", "Weight" }

local KIND_ORDER = { weapon = 1, armor = 2, trinket = 3, consumable = 4, material = 5, quest = 6 }

-- Default example contents: 40 slots, some empty.
function Inventory.exampleState()
	local s: { any } = {
		{ id = "dawnsteel_blade", count = 1 }, { id = "emberfang", count = 1 }, false, { id = "potion_health", count = 12 },
		{ id = "potion_mana", count = 7 }, { id = "oakheart_shield", count = 1 }, { id = "moonpetal", count = 23 }, false,
		{ id = "iron_helm", count = 1 }, { id = "galeheart_bow", count = 1 }, { id = "scroll_recall", count = 3 }, { id = "iron_ore", count = 40 },
		false, { id = "ring_embers", count = 1 }, { id = "steel_ingot", count = 9 }, { id = "elixir_valor", count = 2 },
		{ id = "striders", count = 1 }, false, { id = "vault_key", count = 1 }, { id = "glowcap", count = 14 },
		{ id = "woodcutter_axe", count = 1 }, { id = "travel_bread", count = 18 }, { id = "aether_crystal", count = 2 }, false,
		{ id = "dusk_cloak", count = 1 }, { id = "emberstone", count = 4 }, { id = "old_map", count = 1 }, { id = "potion_stamina", count = 5 },
		false, false, { id = "staff_tides", count = 1 }, { id = "tanned_leather", count = 11 },
		false, false, false, false, false, false, false, false,
	}
	return {
		slots = s,
		filter = "all",
		query = "",
		sortIndex = nil :: number?,
		picked = nil :: number?,
		gold = 1840,
		junk = {},
		equipped = { mainhand = "warden_mace", head = "iron_helm", ring = "ring_embers", back = "dusk_cloak", feet = "striders" },
	}
end

local function matches(state, entry): boolean
	if not entry then
		return false
	end
	local it = Items.get(entry.id)
	if state.filter ~= "all" and it.kind ~= state.filter then
		return false
	end
	local q = string.lower(state.query)
	if q ~= "" then
		local hay = string.lower(it.name .. " " .. it.type .. " " .. Theme.rarityOf(it.rarity).name)
		if not string.find(hay, q, 1, true) then
			return false
		end
	end
	return true
end

local function filtered(state): boolean
	return state.filter ~= "all" or state.query ~= ""
end

-- Underlying slot indices shown, in order. Unfiltered: every slot. Filtered: only matching items.
function Inventory.view(state): { number }
	local out = {}
	for i, e in state.slots do
		if not filtered(state) or matches(state, e) then
			table.insert(out, i)
		end
	end
	return out
end

-- Pure state transitions (also used by tests and the gallery's scripted demo)
function Inventory.move(state, from: number, to: number)
	if from == to then
		return state
	end
	local slots = table.clone(state.slots)
	local a, b = slots[from], slots[to]
	if not a then
		return state
	end
	local it = Items.get(a.id)
	if b and b.id == a.id and it.stack then
		-- merge stacks up to the stack size; remainder stays at the source
		local room = it.stack - b.count
		local moved = math.min(room, a.count)
		slots[to] = { id = b.id, count = b.count + moved }
		slots[from] = if a.count - moved > 0 then { id = a.id, count = a.count - moved } else false
	else
		slots[from], slots[to] = b, a
	end
	state.slots = slots
	return state
end

function Inventory.sort(state, key: string)
	local items = {}
	for _, e in state.slots do
		if e then
			table.insert(items, e)
		end
	end
	local function v(e)
		return Items.get(e.id)
	end
	table.sort(items, function(x, y)
		local a, b = v(x), v(y)
		if key == "Rarity" then
			local ra, rb = Theme.rarityOf(a.rarity).rank, Theme.rarityOf(b.rarity).rank
			if ra ~= rb then
				return ra > rb
			end
		elseif key == "Type" then
			if KIND_ORDER[a.kind] ~= KIND_ORDER[b.kind] then
				return KIND_ORDER[a.kind] < KIND_ORDER[b.kind]
			end
		elseif key == "Value" then
			if a.value * x.count ~= b.value * y.count then
				return a.value * x.count > b.value * y.count
			end
		elseif key == "Weight" then
			if a.weight * x.count ~= b.weight * y.count then
				return a.weight * x.count > b.weight * y.count
			end
		end
		return a.name < b.name
	end)
	local slots = {}
	for i = 1, #state.slots do
		slots[i] = items[i] or false
	end
	state.slots = slots
	return state
end

local function firstEmpty(slots): number?
	for i, e in slots do
		if not e then
			return i
		end
	end
	return nil
end

-- props: columns, slotSize, width
function Inventory.new(scope: any, props: { [string]: any }?)
	local p = props or {}
	local cols = p.columns or 8
	local slotSize = p.slotSize or 62
	local gap = 6
	local store = Store.new(Inventory.exampleState())
	scope:add(store)
	local gridW = cols * slotSize + (cols - 1) * gap
	local width = gridW + 2 * 22 + 4

	local panel, content = Surface.panel({ title = "Satchel", size = UDim2.fromOffset(width, 0), autoSize = Enum.AutomaticSize.Y, padding = 18 })
	scope:add(panel)
	Create.list("y", 10, Enum.HorizontalAlignment.Center).Parent = content

	-- toolbar: categories + search
	local bar = Create.box({ Name = "Toolbar", Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 1, Parent = content }, { Create.list("x", 10, nil, Enum.VerticalAlignment.Center) })
	local cats = Create.box({ Name = "Categories", Size = UDim2.fromOffset(#Inventory.categories * 38 + (#Inventory.categories - 1) * 4, 40), LayoutOrder = 1, Parent = bar }, { Create.list("x", 4, nil, Enum.VerticalAlignment.Center) })
	local catButtons = {}
	for i, cat in Inventory.categories do
		local b = Controls.iconButton(scope, { icon = cat.glyph, size = 38, layoutOrder = i, onClick = function()
			store:set({ filter = cat.id, picked = Store.NONE })
		end })
		b.Instance.Parent = cats
		catButtons[cat.id] = b
		Feedback.tooltip(scope, b.Instance, function()
			return Feedback.tooltipCard({ title = cat.name, width = 150 })
		end, { side = "above" })
	end
	local search = Controls.search(scope, { placeholder = "Search…", layoutOrder = 2, changed = function(t)
		store:set({ query = t, picked = Store.NONE })
	end })
	search.Instance.Parent = bar
	Create.flex().Parent = search.Instance

	-- status line + sort
	local status = Create.box({ Name = "Status", Size = UDim2.new(1, 0, 0, Theme.size.control), LayoutOrder = 2, Parent = content })
	local statusText = Surface.text({ role = "small", text = "", color = C.textSoft, Position = UDim2.fromScale(0, 0.5), AnchorPoint = Vector2.new(0, 0.5), rich = true, Parent = status })
	local sortDrop = Controls.dropdown(scope, {
		width = 190,
		label = "Sort by…",
		options = {
			{ text = "Rarity", icon = "star" },
			{ text = "Type", icon = "filter" },
			{ text = "Name", icon = "sort" },
			{ text = "Value", icon = "coin" },
			{ text = "Weight", icon = "bag" },
		},
		changed = function(i)
			local st = Store.copy(store:get())
			Inventory.sort(st, Inventory.sorts[i])
			st.sortIndex = i
			st.picked = Store.NONE
			store:set(st)
		end,
	})
	sortDrop.Instance.AnchorPoint = Vector2.new(1, 0.5)
	sortDrop.Instance.Position = UDim2.fromScale(1, 0.5)
	sortDrop.Instance.Parent = status

	-- grid
	local gridHolder = Create.box({ Name = "Grid", Size = UDim2.fromOffset(gridW, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = content }, {
		Create.new("UIGridLayout", { CellSize = UDim2.fromOffset(slotSize, slotSize), CellPadding = UDim2.fromOffset(gap, gap), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local drag = DragDrop.new(scope)
	local cells = {}
	local capacity = #store:get().slots

	local function compareFor(it): any?
		if not it.slot then
			return nil
		end
		local eq = store:get().equipped[it.slot]
		if eq and eq ~= it.id then
			return Items.get(eq)
		end
		return nil
	end

	local function toast(tone, title, text, icon)
		Feedback.toast(scope, { tone = tone, title = title, text = text, icon = icon, duration = 3 })
	end

	local function openMenu(index: number)
		local st = store:get()
		local e = st.slots[index]
		if not e then
			return
		end
		local it = Items.get(e.id)
		local menuItems = {}
		if it.kind == "consumable" then
			table.insert(menuItems, { text = "Use", icon = "heart", hint = "E", run = function()
				local s2 = Store.copy(store:get())
				local cur = s2.slots[index]
				s2.slots[index] = if cur.count > 1 then { id = cur.id, count = cur.count - 1 } else false
				store:set({ slots = s2.slots })
				toast("success", `Used {it.name}`, it.effect, it.icon)
			end })
		end
		if it.slot then
			local isEq = st.equipped[it.slot] == it.id
			table.insert(menuItems, { text = if isEq then "Equipped" else "Equip", icon = "shield_small", disabled = isEq, run = function()
				local s2 = Store.copy(store:get())
				local prev = s2.equipped[it.slot]
				s2.equipped[it.slot] = it.id
				s2.slots[index] = if prev then { id = prev, count = 1 } else false
				store:set({ slots = s2.slots, equipped = s2.equipped })
				toast("info", `Equipped {it.name}`, if prev then `{Items.get(prev).name} moved to the satchel.` else nil, it.icon)
			end })
		end
		if e.count > 1 then
			table.insert(menuItems, { text = "Split stack", icon = "swap", disabled = firstEmpty(st.slots) == nil, run = function()
				local s2 = Store.copy(store:get())
				local to = firstEmpty(s2.slots)
				if not to then
					return
				end
				local half = math.floor(e.count / 2)
				s2.slots[index] = { id = e.id, count = e.count - half }
				s2.slots[to] = { id = e.id, count = half }
				store:set({ slots = s2.slots })
			end })
		end
		local junk = st.junk[index] == true
		table.insert(menuItems, { text = if junk then "Unmark junk" else "Mark as junk", icon = "coin", disabled = it.kind == "quest", run = function()
			local j = table.clone(store:get().junk)
			j[index] = not junk or nil
			store:set({ junk = j })
		end })
		table.insert(menuItems, "-")
		table.insert(menuItems, { text = "Discard…", icon = "trash", danger = true, disabled = it.kind == "quest", run = function()
			Feedback.modal(scope, {
				title = "Discard item",
				icon = it.icon,
				glow = Theme.rarityOf(it.rarity).color,
				tone = "danger",
				body = `Discard <b>{it.name}</b>{if e.count > 1 then ` ×{e.count}` else ""}? It will be gone for good.`,
				confirm = { text = "Discard", variant = "danger" },
				cancel = { text = "Keep" },
				onConfirm = function()
					local s2 = Store.copy(store:get())
					s2.slots[index] = false
					store:set({ slots = s2.slots })
					toast("warning", "Item discarded", it.name, it.icon)
				end,
			})
		end })
		local mouse = UserInputService:GetMouseLocation()
		local cell = cells[index]
		local at = if cell then Layers.toLocal(Vector2.new(mouse.X, mouse.Y)) else Vector2.new(20, 20)
		Feedback.contextMenu(scope, at, menuItems, it.name)
	end

	-- Each cell is bound to a display position; render() maps it to an underlying slot index.
	for c = 1, capacity do
		local cell: any = { index = nil :: number? }
		local slot = Slot.new(scope, { size = slotSize, layoutOrder = c, onClick = function()
			local st = store:get()
			local i = cell.index
			if not i then
				return
			end
			if st.picked == nil then
				if st.slots[i] then
					store:set({ picked = i })
				end
			elseif st.picked == i then
				store:set({ picked = Store.NONE })
			else
				local s2 = Store.copy(st)
				Inventory.move(s2, st.picked, i)
				s2.picked = Store.NONE
				store:set(s2)
				cell.slot:pop()
			end
		end })
		slot.Instance.Name = `Cell{c}`
		slot.Instance.Parent = gridHolder
		cell.slot = slot
		cells[c] = cell
		-- drag source
		drag:bindSource(scope, slot.Instance, function()
			local i = cell.index
			if i and store:get().slots[i] then
				return { from = i }
			end
			return nil
		end, function()
			local it = slot.getItem()
			local g = Create.box({ Size = UDim2.fromOffset(slotSize, slotSize) })
			Atlas.image("chrome", "glow", { Size = UDim2.fromScale(1.3, 1.3), Position = UDim2.fromScale(-0.15, -0.15), ImageColor3 = Theme.rarityOf(it.rarity).color, ImageTransparency = 0.35, Parent = g })
			Atlas.image("icon", it.icon, { Size = UDim2.fromScale(0.9, 0.9), Position = UDim2.fromScale(0.05, 0.05), Parent = g })
			return g
		end, {
			onStart = function()
				Feedback.hideTooltips()
				slot:set({ lifted = true })
				store:set({ picked = Store.NONE })
			end,
			onEnd = function()
				slot:set({ lifted = false })
			end,
		})
		-- drop target
		drag:addTarget({
			gui = slot.Instance,
			accepts = function(payload)
				return cell.index ~= nil and cell.index ~= payload.from
			end,
			highlight = function(state)
				-- false, not nil: nil keys vanish from the patch table
				slot:set({ drop = state or false })
			end,
			drop = function(payload)
				local s2 = Store.copy(store:get())
				Inventory.move(s2, payload.from, cell.index)
				store:set(s2)
				slot:pop()
			end,
		})
		-- tooltip with comparison
		cell.tip = Feedback.tooltip(scope, slot.Instance, function()
			local i = cell.index
			local e = i and store:get().slots[i]
			if not e or drag:isDragging() then
				return Create.box({ Size = UDim2.fromOffset(1, 1) })
			end
			local it = Items.get(e.id)
			return ItemCard.new(it, { compare = compareFor(it), count = e.count })
		end)
		scope:connect(slot.Instance.MouseButton2Click, function()
			if cell.index then
				openMenu(cell.index)
			end
		end)
	end

	-- footer: capacity, weight, gold
	local foot = Create.box({ Name = "Footer", Size = UDim2.new(1, 0, 0, 34), LayoutOrder = 4, Parent = content })
	local capBar = Feedback.bar(scope, { width = 170, height = 12, max = capacity, value = 0, color = C.gold })
	capBar.Instance.Position = UDim2.fromOffset(0, 11)
	capBar.Instance.Parent = foot
	local capText = Surface.text({ role = "number", text = "", size = 13, color = C.textSoft, Position = UDim2.fromOffset(180, 8), Parent = foot })
	local weightText = Surface.text({ role = "small", text = "", color = C.textFaint, Position = UDim2.fromOffset(270, 8), Parent = foot })
	local gold = Feedback.currency(scope, { amount = store:get().gold, size = 16 })
	gold.Instance.AnchorPoint = Vector2.new(1, 0)
	gold.Instance.Position = UDim2.new(1, 0, 0, 4)
	gold.Instance.Parent = foot

	local function render(st)
		for id, b in catButtons do
			b.controller:set({ selected = st.filter == id })
		end
		local view = Inventory.view(st)
		local isFiltered = filtered(st)
		for c, cell in cells do
			local i = view[c]
			cell.index = i
			local e = i and st.slots[i]
			if e then
				cell.slot:setItem(Items.get(e.id), e.count)
			else
				cell.slot:setItem(nil)
			end
			local it = if e then Items.get(e.id) else nil
			cell.slot:set({
				selected = i ~= nil and st.picked == i,
				dim = (isFiltered and i == nil) or (i ~= nil and st.junk[i] == true),
				equipped = it ~= nil and it.slot ~= nil and st.equipped[it.slot] == it.id,
			})
			cell.slot.Instance.Selectable = i ~= nil
		end
		local used, weight = 0, 0
		for _, e in st.slots do
			if e then
				used += 1
				weight += Items.get(e.id).weight * e.count
			end
		end
		capBar:set(used)
		capText.Text = `{used} / {capacity}`
		weightText.Text = string.format("%.1f lb", weight)
		if isFiltered then
			local n = 0
			for _, i in view do
				if st.slots[i] then
					n += 1
				end
			end
			local cat = "items"
			for _, cc in Inventory.categories do
				if cc.id == st.filter and cc.id ~= "all" then
					cat = string.lower(cc.name)
				end
			end
			statusText.Text = `<font color="#F3D08A"><b>{n}</b></font> {cat}{if st.query ~= "" then ` matching “{st.query}”` else ""}`
		else
			statusText.Text = if st.picked then `Moving <font color="#F3D08A">{Items.get(st.slots[st.picked].id).name}</font> — choose a slot` else `<b>{used}</b> items · drag to rearrange`
		end
		sortDrop:set(st.sortIndex)
	end
	scope:add(store:subscribe(function(st)
		render(st)
	end))
	render(store:get())
	scope:connect(UserInputService.InputBegan, function(input)
		if input.KeyCode == Enum.KeyCode.Escape and store:get().picked then
			store:set({ picked = Store.NONE })
		end
	end)

	return {
		Instance = panel,
		store = store,
		drag = drag,
		cells = cells,
		search = search,
		reset = function()
			search:set("")
			store:reset()
		end,
		openMenu = openMenu,
		gold = gold,
	}
end

return Inventory
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX30"><Properties><string name="Name">Progression</string><ProtectedString name="Source"><![CDATA[--!strict
-- Quests & progression: QuestCard, QuestLog, QuestTracker, AchievementCard, LevelUp and the
-- quest-complete notice. Quest state is a local Store; objectives advance only through UI actions.
local RunService = game:GetService("RunService")

local Theme = require(script.Parent.Parent.Theme)
local Atlas = require(script.Parent.Parent.Atlas)
local Create = require(script.Parent.Parent.Core.Create)
local Store = require(script.Parent.Parent.Core.Store)
local Motion = require(script.Parent.Parent.Core.Motion)
local Interact = require(script.Parent.Parent.Core.Interact)
local Layers = require(script.Parent.Parent.Core.Layers)
local Surface = require(script.Parent.Parent.Components.Surface)
local Button = require(script.Parent.Parent.Components.Button)
local Controls = require(script.Parent.Parent.Components.Controls)
local Feedback = require(script.Parent.Parent.Components.Feedback)
local Slot = require(script.Parent.Parent.Components.Slot)
local ItemCard = require(script.Parent.Parent.Components.ItemCard)
local Items = require(script.Parent.Parent.Data.Items)
local Quests = require(script.Parent.Parent.Data.Quests)

local C = Theme.color
local M = Theme.motion
local Progression = {}

local function progress(q): (number, number)
	local cur, tot = 0, 0
	for _, o in q.objectives do
		if not o.optional then
			cur += math.min(o.current, o.target)
			tot += o.target
		end
	end
	return cur, tot
end

local function isDone(q): boolean
	local cur, tot = progress(q)
	return tot > 0 and cur >= tot
end

---------------------------------------------------------------- QuestCard
-- props: quest, selected, width, onClick
function Progression.questCard(scope: any, props: { [string]: any })
	local q = props.quest
	local ty = Quests.types[q.type]
	local width = props.width or 340
	local root = scope:add(Create("TextButton", { Name = "Quest_" .. q.id, Text = "", BackgroundTransparency = 1, Size = UDim2.fromOffset(width, 88), LayoutOrder = props.layoutOrder or 0 }))
	local body = Create("Frame", { Name = "Body", BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.fromScale(1, 1), Parent = root }, { Create.corner(7), Create.gradient({ C.leather2, C.leather1 }, 90) })
	local stroke = Create.stroke(C.seam, 1.5, 0)
	stroke.Parent = body
	Create("Frame", { Name = "Stripe", BackgroundColor3 = ty.color, BorderSizePixel = 0, Position = UDim2.fromOffset(0, 0), Size = UDim2.new(0, 5, 1, 0), Parent = body }, { Create.corner(3) })
	local medal = Create.box({ Position = UDim2.fromOffset(16, 14), Size = UDim2.fromOffset(40, 40), Parent = body })
	Atlas.image("chrome", "disc", { Size = UDim2.fromScale(1, 1), ImageColor3 = C.void, Parent = medal })
	local glyph = Atlas.image("glyph", ty.glyph, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.5, 0.5), ImageColor3 = ty.color, ZIndex = 2, Parent = medal })
	Atlas.image("chrome", "ring_thin", { Size = UDim2.fromScale(1, 1), ImageColor3 = ty.color, ImageTransparency = 0.3, ZIndex = 3, Parent = medal })
	local title = Surface.text({ role = "heading", text = q.title, size = 17, color = C.text, Position = UDim2.fromOffset(68, 12), Size = UDim2.new(1, -110, 0, 22), TextTruncate = Enum.TextTruncate.AtEnd, Parent = body })
	local meta = Surface.text({ role = "caps", text = `{ty.name} · {q.region} · Lv {q.level}`, size = 10, color = C.textFaint, Position = UDim2.fromOffset(68, 36), Parent = body })
	local barHolder = Create.box({ Position = UDim2.fromOffset(68, 58), Size = UDim2.new(1, -130, 0, 10), Parent = body })
	local cur, tot = progress(q)
	local bar = Feedback.bar(scope, { color = ty.color, max = math.max(1, tot), value = cur, height = 10 })
	bar.Instance.Size = UDim2.fromScale(1, 1)
	bar.Instance.Parent = barHolder
	local count = Surface.text({ role = "number", text = `{cur}/{tot}`, size = 12, color = C.textSoft, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 54), Parent = body })
	-- right-top status mark
	local mark = Create.box({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 12), Size = UDim2.fromOffset(24, 24), Parent = body })
	local markIcon = Atlas.image("glyph", "pin", { Size = UDim2.fromScale(1, 1), ImageColor3 = C.arcane, Parent = mark })
	local readyGlow = Atlas.image("chrome", "glow", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(2.4, 2.4), ImageColor3 = C.goldBright, ImageTransparency = 1, Parent = mark })
	local lockVeil = Create("Frame", { BackgroundColor3 = C.void, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 5, Parent = body }, { Create.corner(7) })
	local press = Create.scale(1)
	press.Parent = root
	local selected = props.selected == true
	local ctl
	local handle = {} :: any
	local function paint(s)
		local status = q.status
		local ready = status == "ready" or (status == "active" and isDone(q))
		stroke.Color = if selected then C.gold elseif s.hover or s.focused then C.goldDeep else C.seam
		stroke.Thickness = if selected then 2 else 1.5
		body.BackgroundTransparency = 0
		markIcon.Visible = true
		if status == "locked" then
			Atlas.set(markIcon, "glyph", "lock")
			markIcon.ImageColor3 = C.textFaint
		elseif status == "complete" then
			Atlas.set(markIcon, "glyph", "check")
			markIcon.ImageColor3 = C.good
		elseif ready then
			Atlas.set(markIcon, "glyph", "quest")
			markIcon.ImageColor3 = C.goldBright
		elseif q.tracked then
			Atlas.set(markIcon, "glyph", "pin")
			markIcon.ImageColor3 = C.arcane
		else
			markIcon.Visible = false
		end
		readyGlow.ImageTransparency = if ready then 0.55 else 1
		title.TextColor3 = if status == "locked" then C.textFaint elseif status == "complete" then C.textSoft else C.text
		lockVeil.BackgroundTransparency = if status == "locked" then 0.45 elseif status == "complete" then 0.7 else 1
		glyph.ImageColor3 = if status == "locked" then C.textGhost else ty.color
		local c2, t2 = progress(q)
		count.Text = if status == "locked" then "—" elseif ready then "Turn in" else `{c2}/{t2}`
		count.TextColor3 = if ready then C.goldBright else C.textSoft
		meta.Text = `{ty.name} · {q.region} · Lv {q.level}`
		Motion.tween(press, { Scale = if s.pressed then 0.98 else 1 }, M.fast, nil, nil, "press")
	end
	ctl = Interact.attach(root, scope, paint, props.onClick)
	handle.Instance = root
	function handle.update(_, quest, sel: boolean?)
		q = quest
		selected = sel == true
		local c2, t2 = progress(q)
		bar:setMax(math.max(1, t2))
		bar:set(c2)
		paint(ctl.state)
	end
	function handle.force(_, p)
		ctl:force(p)
	end
	return handle
end

---------------------------------------------------------------- reward row (used by log and notices)
local function rewardRow(scope: any, parent: Instance, rewards, order: number, onParchment: boolean)
	local row = Create.box({ Name = "Rewards", Size = UDim2.new(1, 0, 0, 56), LayoutOrder = order, Parent = parent }, { Create.list("x", 10, nil, Enum.VerticalAlignment.Center) })
	local function chip(glyph: string, color: Color3, text: string, o: number)
		local f = Create("Frame", { BackgroundColor3 = if onParchment then C.ink else C.void, BackgroundTransparency = if onParchment then 0.88 else 0.4, Size = UDim2.fromOffset(0, 40), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = o, Parent = row }, { Create.corner(6), Create.padding(0, 12, 0, 10), Create.list("x", 6, nil, Enum.VerticalAlignment.Center) })
		Atlas.image("glyph", glyph, { Size = UDim2.fromOffset(18, 18), ImageColor3 = color, LayoutOrder = 1, Parent = f })
		Surface.text({ role = "number", text = text, size = 15, color = if onParchment then C.ink else C.text, LayoutOrder = 2, Parent = f })
		return f
	end
	chip("star", if onParchment then Color3.fromHex("7B4FB8") else C.xp, `{Feedback.formatNumber(rewards.xp)} XP`, 1)
	chip("coin", if onParchment then C.goldDeep else C.goldBright, Feedback.formatNumber(rewards.gold), 2)
	for i, it in rewards.items do
		local item = Items.get(it.id)
		local s = Slot.new(scope, { size = 48, item = item, count = it.count, layoutOrder = 2 + i })
		s.Instance.Parent = row
		Feedback.tooltip(scope, s.Instance, function()
			return ItemCard.new(item, { count = it.count })
		end, { side = "above" })
	end
	return row
end
Progression.rewardRow = rewardRow

---------------------------------------------------------------- Quest complete notice
-- A parchment notice: the wax seal stamps down, then rewards arrive one by one.
function Progression.completeNotice(scope: any, quest, opts: { [string]: any }?)
	local o = opts or {}
	local card, content = Surface.parchment({ size = UDim2.fromOffset(o.width or 460, 0), autoSize = Enum.AutomaticSize.Y, padding = 22 })
	scope:add(card)
	Create.list("y", 10, Enum.HorizontalAlignment.Center).Parent = content
	local sealBox = Create.box({ Size = UDim2.fromOffset(96, 96), LayoutOrder = 1, Parent = content })
	local seal = Atlas.image("chrome", "seal", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1), Parent = sealBox })
	Atlas.image("glyph", "check", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.4, 0.4), ImageColor3 = Color3.fromHex("F6C9C2"), ZIndex = 2, Parent = seal })
	local sealScale = Create.scale(1)
	sealScale.Parent = seal
	local head = Surface.text({ role = "hero", text = "Quest Complete", size = 40, color = C.ink, LayoutOrder = 2, Parent = content })
	local name = Surface.text({ role = "lore", text = quest.title, size = 16, color = C.inkSoft, LayoutOrder = 3, Parent = content })
	local div = Create.box({ Size = UDim2.new(1, 0, 0, 12), LayoutOrder = 4, Parent = content })
	Create("Frame", { BackgroundColor3 = C.inkFaint, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0.8, 0, 0, 1), Parent = div }, { Create("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1) }) }) })
	local rewards = rewardRow(scope, content, quest.rewards, 5, true)
	rewards:FindFirstChildOfClass("UIListLayout").HorizontalAlignment = Enum.HorizontalAlignment.Center
	local cont = Button.new(scope, { text = "Continue", variant = "primary", width = 180, layoutOrder = 6, onClick = o.onContinue })
	cont.Instance.Parent = content

	local handle = { Instance = card } :: any
	function handle.play()
		if Motion.reduced then
			return
		end
		sealScale.Scale = 2.4
		seal.Rotation = -25
		seal.ImageTransparency = 1
		Motion.tween(seal, { ImageTransparency = 0, Rotation = -8 }, 0.25)
		Motion.tween(sealScale, { Scale = 1 }, 0.35, Enum.EasingStyle.Bounce)
		head.TextTransparency = 1
		name.TextTransparency = 1
		task.delay(0.25, function()
			Motion.tween(head, { TextTransparency = 0 }, 0.4)
			Motion.tween(name, { TextTransparency = 0 }, 0.4)
		end)
		local kids = {}
		for _, ch in rewards:GetChildren() do
			if ch:IsA("GuiObject") then
				table.insert(kids, ch)
			end
		end
		table.sort(kids, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		for i, ch in kids do
			local sc = ch:FindFirstChild("RewardPop") or Create.scale(0)
			sc.Name = "RewardPop"
			sc.Parent = ch
			sc.Scale = 0
			task.delay(0.45 + i * 0.12, function()
				Motion.tween(sc, { Scale = 1 }, 0.3, Enum.EasingStyle.Back)
			end)
		end
	end
	return handle
end

---------------------------------------------------------------- QuestLog
function Progression.questLog(scope: any, props: { [string]: any }?)
	local _ = props
	local store = Store.new({ quests = Store.copy(Quests.list), tab = 1, selected = "ashen_gate" })
	scope:add(store)
	local panel, content = Surface.panel({ title = "Quest Journal", size = UDim2.fromOffset(940, 620), padding = 18 })
	scope:add(panel)

	local left = Create.box({ Name = "List", Size = UDim2.new(0, 356, 1, 0), Parent = content })
	local tabs = Controls.tabs(scope, { tabs = { { text = "Active", icon = "quest" }, { text = "Completed", icon = "check" } }, width = 150, changed = function(i)
		store:set({ tab = i })
	end })
	tabs.Instance.Parent = left
	local scroll = Create("ScrollingFrame", {
		Name = "Scroll",
		BackgroundColor3 = C.void,
		BackgroundTransparency = 0.5,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 46),
		Size = UDim2.new(1, 0, 1, -46),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = C.goldDeep,
		Parent = left,
	}, { Create.corner(6), Create.padding(8, 10, 8, 8), Create.list("y", 8) })

	-- right: parchment detail
	local detail, dc = Surface.parchment({ name = "Detail", position = UDim2.fromOffset(372, 0), size = UDim2.new(1, -372, 1, 0), padding = 20, parent = content })
	local _d = detail
	local dScope: any = nil
	local cards = {}
	local listScope: any = nil

	local function setQuest(id: string, fn: (any) -> ())
		local quests = Store.copy(store:get().quests)
		for _, q in quests do
			if q.id == id then
				fn(q)
			end
		end
		store:set({ quests = quests })
	end

	local function showComplete(q)
		local overlay = Layers.get()
		local s = scope:child()
		local dim = s:add(Create("TextButton", { Text = "", AutoButtonColor = false, BackgroundColor3 = C.void, BackgroundTransparency = 0.4, Size = UDim2.fromScale(1, 1), ZIndex = Theme.z.modal, Parent = overlay }))
		local _dm = dim
		local notice = Progression.completeNotice(s, q, { onContinue = function()
			s:Destroy()
		end })
		notice.Instance.AnchorPoint = Vector2.new(0.5, 0.5)
		notice.Instance.Position = UDim2.fromScale(0.5, 0.5)
		notice.Instance.Parent = overlay
		for _, d in notice.Instance:GetDescendants() do
			if d:IsA("GuiObject") then
				d.ZIndex += Theme.z.modal
			end
		end
		notice.Instance.ZIndex += Theme.z.modal
		notice.play()
	end

	local function renderDetail(q)
		if dScope then
			dScope:Destroy()
		end
		dScope = scope:child()
		local body = dScope:add(Create.box({ Size = UDim2.fromScale(1, 1), Parent = dc }, { Create.list("y", 10) }))
		local ty = Quests.types[q.type]
		local tagRow = Create.box({ Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 1, Parent = body }, { Create.list("x", 6, nil, Enum.VerticalAlignment.Center) })
		local tg = Feedback.tag({ text = ty.name, color = ty.color:Lerp(C.ink, 0.35), glyph = ty.glyph, layoutOrder = 1, parent = tagRow })
		tg.BackgroundColor3 = C.ink
		tg.BackgroundTransparency = 0.9
		Surface.text({ role = "caps", text = `{q.region} · recommended level {q.level}`, size = 10, color = C.inkFaint, LayoutOrder = 2, Parent = tagRow })
		Surface.text({ role = "title", text = q.title, size = 30, color = C.ink, LayoutOrder = 2, Parent = body })
		Surface.text({ role = "body", text = q.text, size = 15, color = C.inkSoft, wrap = true, LayoutOrder = 3, Parent = body }).LineHeight = 1.15
		if #q.objectives > 0 then
			local cap = Surface.text({ role = "caps", text = "Objectives", size = 11, color = Color3.fromHex("8A4A1E"), LayoutOrder = 4, Parent = body })
			Create.padding(10, 0, 0, 0).Parent = cap
			for i, o in q.objectives do
				local done = o.current >= o.target
				local row = Create.box({ Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 4 + i, Parent = body })
				local box = Create("Frame", { BackgroundColor3 = C.vellumDeep, Size = UDim2.fromOffset(18, 18), Position = UDim2.fromOffset(0, 3), Parent = row }, { Create.corner(3), Create.stroke(C.inkSoft, 1.5, 0) })
				if done then
					Atlas.image("glyph", "check", { Size = UDim2.fromScale(1.2, 1.2), Position = UDim2.fromScale(-0.05, -0.15), ImageColor3 = Color3.fromHex("2F6B2A"), Parent = box })
				end
				local t = Surface.text({ role = "body", text = o.text .. (if o.optional then " (optional)" else ""), size = 15, color = if done then C.inkFaint else C.ink, rich = true, Position = UDim2.fromOffset(28, 0), Size = UDim2.new(1, -90, 1, 0), Parent = row })
				if done then
					t.Text = `<s>{t.Text}</s>`
				end
				Surface.text({ role = "number", text = `{math.min(o.current, o.target)} / {o.target}`, size = 14, color = if done then Color3.fromHex("2F6B2A") else C.ink, AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, Parent = row })
			end
		end
		Create.padding(10, 0, 0, 0).Parent = Surface.text({ role = "caps", text = "Rewards", size = 11, color = Color3.fromHex("8A4A1E"), LayoutOrder = 10, Parent = body })
		rewardRow(dScope, body, q.rewards, 11, true)
		-- actions at the bottom
		local actions = dScope:add(Create.box({ AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, Theme.size.control), Parent = dc }, { Create.list("x", 10, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center) }))
		local ready = q.status == "ready" or (q.status == "active" and isDone(q))
		if q.status == "active" or q.status == "ready" then
			local track = Controls.toggle(dScope, { label = "Track", labelColor = C.ink, value = q.tracked, width = 130, layoutOrder = 1, changed = function(v)
				setQuest(q.id, function(x)
					x.tracked = v
				end)
			end })
			track.Instance.Parent = actions
			local spacer = Create.box({ Size = UDim2.fromOffset(0, 1), LayoutOrder = 2, Parent = actions })
			Create.flex().Parent = spacer
			local abandon = Button.new(dScope, { text = "Abandon", variant = "ink", icon = "trash", layoutOrder = 3, onClick = function()
				Feedback.modal(scope, {
					title = "Abandon quest",
					tone = "danger",
					icon = "scroll",
					body = `Abandon <b>{q.title}</b>? Progress on its objectives will be lost.`,
					confirm = { text = "Abandon", variant = "danger" },
					cancel = { text = "Keep quest" },
					onConfirm = function()
						local quests = Store.copy(store:get().quests)
						for i, x in quests do
							if x.id == q.id then
								table.remove(quests, i)
								break
							end
						end
						store:set({ quests = quests, selected = quests[1].id })
					end,
				})
			end })
			abandon.Instance.Parent = actions
			local turnIn = Button.new(dScope, { text = "Turn in", variant = "primary", icon = "check", disabled = not ready, layoutOrder = 4, onClick = function()
				setQuest(q.id, function(x)
					x.status = "complete"
					x.tracked = false
				end)
				showComplete(q)
			end })
			turnIn.Instance.Parent = actions
		elseif q.status == "locked" then
			Surface.text({ role = "lore", text = "This quest is not yet available.", color = C.inkFaint, LayoutOrder = 1, Parent = actions })
		else
			Surface.text({ role = "lore", text = "Completed. Rewards claimed.", color = Color3.fromHex("2F6B2A"), LayoutOrder = 1, Parent = actions })
		end
	end

	local function render(st, prev)
		if not prev or prev.quests ~= st.quests or prev.tab ~= st.tab then
			if listScope then
				listScope:Destroy()
			end
			listScope = scope:child()
			table.clear(cards)
			local n = 0
			for _, q in st.quests do
				local inTab = if st.tab == 1 then q.status ~= "complete" else q.status == "complete"
				if inTab then
					n += 1
					local card = Progression.questCard(listScope, { quest = q, width = 328, selected = q.id == st.selected, layoutOrder = n, onClick = function()
						store:set({ selected = q.id })
					end })
					card.Instance.Parent = scroll
					cards[q.id] = card
				end
			end
			if n == 0 then
				Surface.text({ role = "lore", text = "Nothing here yet.", color = C.textFaint, Parent = scroll }).Parent = scroll
			end
		end
		for id, card in cards do
			for _, q in st.quests do
				if q.id == id then
					card:update(q, id == st.selected)
				end
			end
		end
		for _, q in st.quests do
			if q.id == st.selected then
				renderDetail(q)
			end
		end
		tabs:set(st.tab)
	end
	scope:add(store:subscribe(render))
	render(store:get(), nil)

	return {
		Instance = panel,
		store = store,
		reset = function()
			store:reset()
		end,
		advance = function(_, id: string)
			setQuest(id, function(q)
				for _, o in q.objectives do
					if o.current < o.target then
						o.current += 1
						break
					end
				end
			end)
		end,
		select = function(_, id: string)
			store:set({ selected = id })
		end,
		showComplete = showComplete,
	}
end

---------------------------------------------------------------- QuestTracker (HUD widget)
function Progression.tracker(scope: any, props: { [string]: any }?)
	local p = props or {}
	local quests = Store.copy(p.quests or { Quests.get("ashen_gate"), Quests.get("moonpetal"), Quests.get("daily_forge") })
	local width = p.width or 330
	local root = scope:add(Create("Frame", { Name = "QuestTracker", BackgroundColor3 = C.void, BackgroundTransparency = 0.25, Size = UDim2.fromOffset(width, 0), AutomaticSize = Enum.AutomaticSize.Y }, {
		Create.corner(8),
		Create.stroke(C.seam, 1, 0.2),
		Create.padding(14, 16, 14, 16),
		Create.list("y", 12),
		Create("UIGradient", { Rotation = 0, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 0.35) }) }),
	}))
	local head = Create.box({ Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 0, Parent = root }, { Create.list("x", 8, nil, Enum.VerticalAlignment.Center) })
	Atlas.image("glyph", "quest", { Size = UDim2.fromOffset(16, 16), ImageColor3 = C.gold, LayoutOrder = 1, Parent = head })
	Surface.text({ role = "caps", text = "Tracked quests", size = 11, color = C.gold, LayoutOrder = 2, Parent = head })
	local blocks = {}
	local function build()
		for _, b in blocks do
			b.frame:Destroy()
		end
		table.clear(blocks)
		for i, q in quests do
			local ty = Quests.types[q.type]
			local f = Create.box({ Name = q.id, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = i, Parent = root }, { Create.list("y", 5) })
			local tr = Create.box({ Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 0, Parent = f })
			Create("Frame", { BackgroundColor3 = ty.color, BorderSizePixel = 0, Position = UDim2.fromOffset(0, 4), Size = UDim2.fromOffset(3, 14), Parent = tr })
			local title = Surface.text({ role = "label", text = q.title, size = 15, color = ty.color:Lerp(Color3.new(1, 1, 1), 0.35), Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -10, 1, 0), Parent = tr })
			local banner = Surface.text({ role = "caps", text = "Ready to turn in", size = 10, color = C.goldBright, Position = UDim2.fromOffset(10, 0), Visible = false, LayoutOrder = 99, Parent = f })
			local lines = {}
			for j, o in q.objectives do
				local line = Create.box({ Size = UDim2.new(1, 0, 0, 20), LayoutOrder = j, Parent = f })
				local mark = Create("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 4), Size = UDim2.fromOffset(12, 12), Parent = line }, { Create.corner(2), Create.stroke(C.textFaint, 1, 0) })
				local check = Atlas.image("glyph", "check", { Size = UDim2.fromOffset(16, 16), Position = UDim2.fromOffset(-2, -3), ImageColor3 = C.good, Visible = false, Parent = mark })
				local t = Surface.text({ role = "small", text = o.text, size = 13, color = C.textSoft, rich = true, Position = UDim2.fromOffset(30, 0), Size = UDim2.new(1, -78, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, Parent = line })
				local n = Surface.text({ role = "number", text = "", size = 12, color = C.text, AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, Parent = line })
				local pop = Create.scale(1)
				pop.Parent = check
				lines[j] = { mark = mark, check = check, text = t, n = n, o = o, pop = pop, done = false }
			end
			blocks[i] = { frame = f, q = q, lines = lines, banner = banner, title = title }
		end
	end
	local function paint(animate: boolean)
		for _, b in blocks do
			for _, l in b.lines do
				local done = l.o.current >= l.o.target
				l.n.Text = `{math.min(l.o.current, l.o.target)}/{l.o.target}`
				l.n.TextColor3 = if done then C.good else C.text
				l.check.Visible = done
				l.mark:FindFirstChildOfClass("UIStroke").Color = if done then C.good else C.textFaint
				l.text.Text = if done then `<s>{l.o.text}</s>` else l.o.text
				l.text.TextColor3 = if done then C.textFaint else C.textSoft
				if done and not l.done and animate then
					l.pop.Scale = 1.8
					Motion.tween(l.pop, { Scale = 1 }, 0.35, Enum.EasingStyle.Back)
				end
				l.done = done
			end
			local ready = isDone(b.q)
			b.banner.Visible = ready
		end
	end
	build()
	paint(false)
	local handle = { Instance = root } :: any
	function handle.advance(_, qi: number)
		local q = quests[qi]
		for _, o in q.objectives do
			if o.current < o.target then
				o.current += 1
				break
			end
		end
		paint(true)
		if isDone(q) then
			Feedback.toast(scope, { tone = "quest", title = "Objectives complete", text = q.title, duration = 3 })
		end
	end
	function handle.reset()
		quests = Store.copy(p.quests or { Quests.get("ashen_gate"), Quests.get("moonpetal"), Quests.get("daily_forge") })
		build()
		paint(false)
	end
	return handle
end

---------------------------------------------------------------- AchievementCard
function Progression.achievement(scope: any, a, props: { [string]: any }?)
	local p = props or {}
	local unlocked = a.unlocked == true
	local width = p.width or 400
	local root = scope:add(Create("Frame", { Name = "Achievement_" .. a.id, BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.fromOffset(width, 96), LayoutOrder = p.layoutOrder or 0 }, {
		Create.corner(8),
		Create.gradient(if unlocked then { C.leather3, C.leather1 } else { C.leather1, C.leather0 }, 90),
		Create.stroke(if unlocked then C.gold else C.seam, 1.5, 0),
	}))
	if unlocked then
		Atlas.image("chrome", "glow", { Position = UDim2.fromOffset(-30, -30), Size = UDim2.fromOffset(150, 150), ImageColor3 = C.goldBright, ImageTransparency = 0.82, Parent = root })
	end
	local medal = Create.box({ Position = UDim2.fromOffset(14, 12), Size = UDim2.fromOffset(72, 72), ZIndex = 2, Parent = root })
	if unlocked then
		Atlas.image("chrome", "seal", { Size = UDim2.fromScale(1, 1), ZIndex = 2, Parent = medal })
		Atlas.image("icon", a.icon, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.56, 0.56), ZIndex = 3, Parent = medal })
	else
		Atlas.image("chrome", "disc", { Size = UDim2.fromScale(0.86, 0.86), Position = UDim2.fromScale(0.07, 0.07), ImageColor3 = C.void, ZIndex = 2, Parent = medal })
		if a.hidden then
			Atlas.image("glyph", "info", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.36, 0.36), ImageColor3 = C.textGhost, ZIndex = 3, Parent = medal })
		else
			Atlas.image("icon", a.icon, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.56, 0.56), ImageColor3 = Color3.fromRGB(110, 100, 92), ImageTransparency = if a.locked then 0.4 else 0, ZIndex = 3, Parent = medal })
		end
		Atlas.image("chrome", "medallion", { Size = UDim2.fromScale(1, 1), ImageColor3 = Color3.fromRGB(150, 140, 130), ZIndex = 4, Parent = medal })
	end
	local x = 100
	Surface.text({ role = "heading", text = a.title, size = 18, color = if unlocked then C.goldBright elseif a.hidden then C.textFaint else C.text, Position = UDim2.fromOffset(x, 14), ZIndex = 2, Parent = root })
	Surface.text({ role = "small", text = a.text, size = 13, color = C.textSoft, Position = UDim2.fromOffset(x, 40), Size = UDim2.new(1, -x - 70, 0, 18), TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 2, Parent = root })
	if a.target and not unlocked then
		local b = Feedback.bar(scope, { color = C.arcane, max = a.target, value = a.current, height = 10 })
		b.Instance.Position = UDim2.fromOffset(x, 66)
		b.Instance.Size = UDim2.new(1, -x - 172, 0, 10)
		b.Instance.Parent = root
		Surface.text({ role = "number", text = `{Feedback.formatNumber(a.current)} / {Feedback.formatNumber(a.target)}`, size = 11, color = C.textSoft, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -66, 0, 62), ZIndex = 2, Parent = root })
	elseif unlocked then
		Surface.text({ role = "caps", text = `Unlocked · {a.date}`, size = 10, color = C.good, Position = UDim2.fromOffset(x, 66), ZIndex = 2, Parent = root })
	else
		Surface.text({ role = "caps", text = if a.hidden then "Hidden" else "Locked", size = 10, color = C.textGhost, Position = UDim2.fromOffset(x, 66), ZIndex = 2, Parent = root })
	end
	-- points shield
	local pts = Create.box({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(46, 52), ZIndex = 2, Parent = root })
	Atlas.image("chrome", "crest", { Size = UDim2.fromScale(1, 1), ImageColor3 = if unlocked then C.gold else C.leather3, ZIndex = 2, Parent = pts })
	Surface.text({ role = "number", text = tostring(a.points), size = 15, color = if unlocked then C.ink else C.textFaint, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), ZIndex = 3, Parent = pts })
	return { Instance = root }
end

---------------------------------------------------------------- Level up
-- A presentation card: rotating rays, ribbon banner, the new level counting up, and staggered gains.
function Progression.levelUp(scope: any, props: { [string]: any }?)
	local p = props or {}
	local from, to = p.from or 23, p.to or 24
	local root = scope:add(Create.box({ Name = "LevelUp", Size = UDim2.fromOffset(560, 380) }))
	local rays = Atlas.image("chrome", "rays", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.34), Size = UDim2.fromOffset(420, 420), ImageColor3 = C.goldBright, ImageTransparency = 0.55, Parent = root })
	local glow = Atlas.image("chrome", "glow", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.34), Size = UDim2.fromOffset(300, 300), ImageColor3 = C.goldBright, ImageTransparency = 0.35, ZIndex = 2, Parent = root })
	local medal = Create.box({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.3), Size = UDim2.fromOffset(150, 150), ZIndex = 3, Parent = root })
	Atlas.image("chrome", "diamond", { Size = UDim2.fromScale(1, 1), ImageColor3 = C.xpDeep, ZIndex = 3, Parent = medal })
	Atlas.image("chrome", "node_keystone", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1.12, 1.12), ZIndex = 4, Parent = medal })
	local num = Surface.text({ role = "hero", text = tostring(from), size = 64, color = C.goldPale, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.52), ZIndex = 5, Parent = medal })
	num.TextStrokeColor3 = C.void
	num.TextStrokeTransparency = 0.4
	local medalScale = Create.scale(1)
	medalScale.Parent = medal
	local ribbon = Atlas.image("chrome", "ribbon", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.58), Size = UDim2.fromOffset(360, 80), SliceScale = 1, ZIndex = 6, Parent = root })
	Surface.text({ role = "hero", text = "Level Up", size = 38, color = C.goldPale, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, -6), ZIndex = 7, Parent = ribbon })
	local ribbonScale = Create.scale(1)
	ribbonScale.Parent = ribbon
	local gains = Create.box({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.7, 4), Size = UDim2.fromOffset(460, 100), ZIndex = 6, Parent = root }, {
		Create.new("UIGridLayout", { CellSize = UDim2.fromOffset(225, 26), CellPadding = UDim2.fromOffset(10, 6), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center }),
	})
	local lines = {
		{ "plus", C.arcane, "+3 attribute points" },
		{ "star", C.xp, "+1 skill point" },
		{ "heart", C.health, "+45 maximum health" },
		{ "unlock", C.goldBright, "Unlocked: Falling Star II" },
	}
	local lineFrames = {}
	for i, l in lines do
		local f = Create("Frame", { BackgroundColor3 = C.void, BackgroundTransparency = 0.4, LayoutOrder = i, ZIndex = 6, Parent = gains }, { Create.corner(5), Create.padding(0, 10, 0, 10), Create.list("x", 8, nil, Enum.VerticalAlignment.Center) })
		Atlas.image("glyph", l[1], { Size = UDim2.fromOffset(14, 14), ImageColor3 = l[2], LayoutOrder = 1, ZIndex = 7, Parent = f })
		Surface.text({ role = "small", text = l[3], size = 13, color = C.text, LayoutOrder = 2, ZIndex = 7, Parent = f })
		lineFrames[i] = f
	end
	scope:connect(RunService.Heartbeat, function(dt)
		if Motion.paused then
			return
		end
		rays.Rotation = (rays.Rotation + dt * 9) % 360
	end)
	local handle = { Instance = root } :: any
	function handle.play()
		num.Text = tostring(from)
		medalScale.Scale = 0.4
		ribbonScale.Scale = 0
		rays.ImageTransparency = 1
		glow.ImageTransparency = 1
		for _, f in lineFrames do
			f.BackgroundTransparency = 1
			for _, d in f:GetDescendants() do
				if d:IsA("TextLabel") then
					d.TextTransparency = 1
				elseif d:IsA("ImageLabel") then
					d.ImageTransparency = 1
				end
			end
		end
		Motion.tween(glow, { ImageTransparency = 0.35 }, 0.5)
		Motion.tween(rays, { ImageTransparency = 0.55 }, 0.8)
		Motion.tween(medalScale, { Scale = 1 }, 0.5, Enum.EasingStyle.Back)
		task.delay(0.45, function()
			num.Text = tostring(to)
			medalScale.Scale = 1.18
			Motion.tween(medalScale, { Scale = 1 }, 0.35, Enum.EasingStyle.Back)
			Motion.tween(ribbonScale, { Scale = 1 }, 0.4, Enum.EasingStyle.Back)
		end)
		for i, f in lineFrames do
			task.delay(0.85 + i * 0.12, function()
				Motion.tween(f, { BackgroundTransparency = 0.4 }, 0.3)
				for _, d in f:GetDescendants() do
					if d:IsA("TextLabel") then
						Motion.tween(d, { TextTransparency = 0 }, 0.3)
					elseif d:IsA("ImageLabel") then
						Motion.tween(d, { ImageTransparency = 0 }, 0.3)
					end
				end
			end)
		end
	end
	num.Text = tostring(to)
	return handle
end

---------------------------------------------------------------- Loot reveal (reward popup)
-- items: { {id, count} }. Slots flip in one by one, rarest last with a bigger flare.
function Progression.lootReveal(scope: any, items: { any }, props: { [string]: any }?)
	local p = props or {}
	local panel, content = Surface.panel({ title = p.title or "Treasure Found", size = UDim2.fromOffset(p.width or 520, 0), autoSize = Enum.AutomaticSize.Y, padding = 20 })
	scope:add(panel)
	Create.list("y", 14, Enum.HorizontalAlignment.Center).Parent = content
	local stage = Create.box({ Size = UDim2.new(1, 0, 0, 120), LayoutOrder = 1, ClipsDescendants = false, Parent = content })
	local rays = Atlas.image("chrome", "rays", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(260, 260), ImageColor3 = C.goldBright, ImageTransparency = 0.7, Parent = stage })
	local chest = Create.box({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(110, 110), ZIndex = 2, Parent = stage })
	Atlas.image("chrome", "glow", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1.4, 1.4), ImageColor3 = C.goldBright, ImageTransparency = 0.45, ZIndex = 2, Parent = chest })
	Atlas.image("icon", "chest", { Size = UDim2.fromScale(1, 1), ZIndex = 3, Parent = chest })
	local chestScale = Create.scale(1)
	chestScale.Parent = chest
	Surface.text({ role = "lore", text = p.subtitle or "The sealed coffer gives up its contents.", color = C.textSoft, LayoutOrder = 2, Parent = content })
	local row = Create.box({ Size = UDim2.new(1, 0, 0, 92), LayoutOrder = 3, Parent = content }, { Create.list("x", 12, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Top) })
	local cells = {}
	for i, e in items do
		local it = Items.get(e.id)
		local cell = Create.box({ Size = UDim2.fromOffset(72, 92), LayoutOrder = i, Parent = row })
		local holder = Create.box({ Size = UDim2.fromOffset(72, 72), Parent = cell })
		local flare = Atlas.image("chrome", "glow", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1.8, 1.8), ImageColor3 = Theme.rarityOf(it.rarity).color, ImageTransparency = 0.55, Parent = holder })
		local s = Slot.new(scope, { size = 72, item = it, count = e.count })
		s.Instance.Parent = holder
		Feedback.tooltip(scope, s.Instance, function()
			return ItemCard.new(it, { count = e.count })
		end, { side = "below" })
		local sc = Create.scale(1)
		sc.Parent = holder
		local label = Surface.text({ role = "caps", text = Theme.rarityOf(it.rarity).name, size = 9, color = Theme.rarityOf(it.rarity).color, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 76), Parent = cell })
		cells[i] = { sc = sc, flare = flare, label = label, rank = Theme.rarityOf(it.rarity).rank }
	end
	local actions = Create.box({ Size = UDim2.new(1, 0, 0, Theme.size.control), LayoutOrder = 4, Parent = content }, { Create.list("x", 12, Enum.HorizontalAlignment.Center) })
	Button.new(scope, { text = "Leave", variant = "secondary", width = 140, layoutOrder = 1 }).Instance.Parent = actions
	local take = Button.new(scope, { text = "Take all", variant = "primary", icon = "bag", width = 170, keyHint = "E", layoutOrder = 2, onClick = function()
		Feedback.toast(scope, { tone = "reward", title = "Loot collected", text = `{#items} items added to your satchel.`, icon = "coin_pouch", duration = 2.5 })
	end })
	take.Instance.Parent = actions
	scope:connect(RunService.Heartbeat, function(dt)
		if Motion.paused then
			return
		end
		rays.Rotation = (rays.Rotation + dt * 12) % 360
	end)
	local handle = { Instance = panel } :: any
	function handle.play()
		chestScale.Scale = 0.6
		Motion.tween(chestScale, { Scale = 1 }, 0.4, Enum.EasingStyle.Back)
		for i, c in cells do
			c.sc.Scale = 0
			c.flare.ImageTransparency = 1
			c.label.TextTransparency = 1
			task.delay(0.3 + i * 0.16, function()
				Motion.tween(c.sc, { Scale = 1 }, 0.35, Enum.EasingStyle.Back)
				c.flare.ImageTransparency = if c.rank >= 4 then 0.1 else 0.35
				Motion.tween(c.flare, { ImageTransparency = 0.55 }, 0.8)
				Motion.tween(c.label, { TextTransparency = 0 }, 0.3)
			end)
		end
	end
	return handle
end

return Progression
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX31"><Properties><string name="Name">SkillTree</string><ProtectedString name="Source"><![CDATA[--!strict
-- Skill tree: three branches of nodes joined by paths. Select a node to inspect it; learn or unlearn ranks
-- with local points; reset the tree (with confirmation). Rules:
--   • a node needs every prerequisite at rank ≥ 1
--   • row gates: points spent in the branch's rows above the node's row must reach Skills.rowGate[row]
--   • a rank can be removed only if no learned node depends on it and no deeper row loses its gate
-- Purely a UI model: nothing is cast or applied.
local Theme = require(script.Parent.Parent.Theme)
local Atlas = require(script.Parent.Parent.Atlas)
local Create = require(script.Parent.Parent.Core.Create)
local Store = require(script.Parent.Parent.Core.Store)
local Motion = require(script.Parent.Parent.Core.Motion)
local Interact = require(script.Parent.Parent.Core.Interact)
local Surface = require(script.Parent.Parent.Components.Surface)
local Button = require(script.Parent.Parent.Components.Button)
local Feedback = require(script.Parent.Parent.Components.Feedback)
local Skills = require(script.Parent.Parent.Data.Skills)

local C = Theme.color
local M = Theme.motion
local SkillTree = {}

---------------------------------------------------------------- rules (pure)
function SkillTree.exampleState()
	return {
		ranks = { kindle = 1, searing = 2, guard = 3, ward = 1, shard = 1 },
		points = 6,
		selected = "meteor",
	}
end

local function rank(st, id: string): number
	return st.ranks[id] or 0
end

function SkillTree.spentAbove(st, branch: string, row: number): number
	local s = 0
	for _, node in Skills.nodes do
		if node.branch == branch and node.row < row then
			s += rank(st, node.id)
		end
	end
	return s
end

function SkillTree.branchSpent(st, branch: string): number
	return SkillTree.spentAbove(st, branch, 99)
end

-- returns ok, list of {text, met}
function SkillTree.requirements(st, node)
	local reqs = {}
	for _, rid in node.requires do
		local r = Skills.get(rid)
		table.insert(reqs, { text = `Learn {r.name}`, met = rank(st, rid) >= 1 })
	end
	local gate = Skills.rowGate[node.row]
	if gate > 0 then
		local bname = ""
		for _, b in Skills.branches do
			if b.id == node.branch then
				bname = b.name
			end
		end
		local have = SkillTree.spentAbove(st, node.branch, node.row)
		table.insert(reqs, { text = `{gate} points in {bname} rows above ({math.min(have, gate)}/{gate})`, met = have >= gate })
	end
	local ok = true
	for _, r in reqs do
		ok = ok and r.met
	end
	return ok, reqs
end

function SkillTree.canLearn(st, node): (boolean, string?)
	if rank(st, node.id) >= node.max then
		return false, "Mastered"
	end
	local ok = SkillTree.requirements(st, node)
	if not ok then
		return false, "Requirements not met"
	end
	if st.points <= 0 then
		return false, "No points left"
	end
	return true, nil
end

function SkillTree.canUnlearn(st, node): (boolean, string?)
	local r = rank(st, node.id)
	if r <= 0 then
		return false, "Not learned"
	end
	if r == 1 then
		for _, other in Skills.nodes do
			if rank(st, other.id) > 0 and table.find(other.requires, node.id) then
				return false, `{other.name} depends on it`
			end
		end
	end
	-- simulate removal and re-check gates of deeper learned nodes
	local sim = { ranks = table.clone(st.ranks), points = st.points }
	sim.ranks[node.id] = r - 1
	for _, other in Skills.nodes do
		if other.branch == node.branch and other.row > node.row and rank(sim, other.id) > 0 then
			if SkillTree.spentAbove(sim, other.branch, other.row) < Skills.rowGate[other.row] then
				return false, `{other.name} would lose its row requirement`
			end
		end
	end
	return true, nil
end

function SkillTree.learn(st, id: string)
	local node = Skills.get(id)
	local ok = SkillTree.canLearn(st, node)
	if not ok then
		return false
	end
	st.ranks = table.clone(st.ranks)
	st.ranks[id] = rank(st, id) + 1
	st.points -= 1
	return true
end

function SkillTree.unlearn(st, id: string)
	local node = Skills.get(id)
	local ok = SkillTree.canUnlearn(st, node)
	if not ok then
		return false
	end
	st.ranks = table.clone(st.ranks)
	st.ranks[id] = rank(st, id) - 1
	st.points += 1
	return true
end

---------------------------------------------------------------- UI
local LANE = 78
local ROW = 90
local BRANCH_W = LANE * 3
local GAP = 34
local NODE = 58

local function nodeCenter(node, bIndex: number): Vector2
	return Vector2.new((bIndex - 1) * (BRANCH_W + GAP) + (node.col - 0.5) * LANE, 56 + (node.row - 1) * ROW + NODE / 2)
end

function SkillTree.new(scope: any, props: { [string]: any }?)
	local _ = props
	local store = Store.new(SkillTree.exampleState())
	scope:add(store)
	local branchIndex = {}
	for i, b in Skills.branches do
		branchIndex[b.id] = i
	end

	local panel, content = Surface.panel({ title = "Skill Tree", size = UDim2.fromOffset(1090, 640), padding = 18 })
	scope:add(panel)

	-- header: unspent points + reset
	local header = Create.box({ Name = "Header", Size = UDim2.new(1, 0, 0, 40), Parent = content })
	local pointsBox = Create.box({ Size = UDim2.fromOffset(240, 40), Parent = header })
	local gem = Create.box({ Size = UDim2.fromOffset(40, 40), Parent = pointsBox })
	Atlas.image("chrome", "diamond", { Size = UDim2.fromScale(1, 1), ImageColor3 = C.arcaneDeep, Parent = gem })
	Atlas.image("chrome", "node_diamond", { Size = UDim2.fromScale(1, 1), ZIndex = 2, Parent = gem })
	local pointsNum = Surface.text({ role = "number", text = "", size = 17, color = C.goldPale, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = 3, Parent = gem })
	local gemPop = Create.scale(1)
	gemPop.Parent = gem
	Surface.text({ role = "heading", text = "Unspent points", size = 17, color = C.text, Position = UDim2.fromOffset(52, 2), Parent = pointsBox })
	local spentText = Surface.text({ role = "caps", text = "", size = 10, color = C.textFaint, Position = UDim2.fromOffset(52, 24), Parent = pointsBox })

	-- tree field
	local field = Create.box({ Name = "Field", Position = UDim2.fromOffset(0, 54), Size = UDim2.fromOffset(3 * BRANCH_W + 2 * GAP, 520), Parent = content })
	local branchHeads = {}
	for i, b in Skills.branches do
		local x = (i - 1) * (BRANCH_W + GAP)
		local col = Create("Frame", { Name = "Branch_" .. b.id, BackgroundColor3 = C.void, BackgroundTransparency = 0.55, Position = UDim2.fromOffset(x, 0), Size = UDim2.fromOffset(BRANCH_W, 520), Parent = field }, { Create.corner(8), Create.stroke(C.seam, 1, 0.3) })
		Create("Frame", { BackgroundColor3 = b.color, BackgroundTransparency = 0.88, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 40), Parent = col }, { Create.corner(8), Create("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(0, 1) }) })
		local h = Create.box({ Size = UDim2.new(1, 0, 0, 38), Parent = col }, { Create.list("x", 8, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center) })
		Atlas.image("glyph", b.glyph, { Size = UDim2.fromOffset(16, 16), ImageColor3 = b.color, LayoutOrder = 1, Parent = h })
		Surface.text({ role = "heading", text = b.name, size = 17, color = b.color:Lerp(Color3.new(1, 1, 1), 0.2), LayoutOrder = 2, Parent = h })
		local cnt = Surface.text({ role = "number", text = "0", size = 12, color = C.textFaint, LayoutOrder = 3, Parent = h })
		branchHeads[b.id] = cnt
		-- row gate markers
		for r = 2, 5 do
			local g = Skills.rowGate[r]
			local mark = Surface.text({ role = "caps", text = `{g}`, size = 9, color = C.textGhost, Position = UDim2.fromOffset(6, 56 + (r - 1) * ROW + NODE / 2 - 18), Parent = col })
			mark.Name = "Gate" .. r
		end
	end

	-- edges
	local edges = {}
	for _, node in Skills.nodes do
		local bi = branchIndex[node.branch]
		for _, rid in node.requires do
			local parentNode = Skills.get(rid)
			local a, b = nodeCenter(parentNode, bi), nodeCenter(node, bi)
			local d = b - a
			local len = d.Magnitude
			local edge = Create.box({
				Name = `Edge_{rid}_{node.id}`,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2),
				Size = UDim2.fromOffset(len, 8),
				Rotation = math.deg(math.atan2(d.Y, d.X)),
				ZIndex = 1,
				Parent = field,
			})
			Create("Frame", { BackgroundColor3 = C.void, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.new(1, 0, 0, 7), ZIndex = 1, Parent = edge }, { Create.corner(3) })
			Create("Frame", { BackgroundColor3 = C.seam, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.new(1, 0, 0, 3), ZIndex = 1, Parent = edge })
			local fill = Create("Frame", { Name = "Fill", BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.new(0, 0, 0, 3), ZIndex = 1, Parent = edge }, {
				Create.gradient({ C.goldBright, Skills.branches[bi].color }, 0),
			})
			table.insert(edges, { from = rid, to = node.id, fill = fill, lit = false })
		end
	end

	-- nodes
	local views = {}
	for _, node in Skills.nodes do
		local bi = branchIndex[node.branch]
		local c = nodeCenter(node, bi)
		local big = node.kind == "keystone"
		local size = if big then 72 else NODE
		local btn = Create("ImageButton", {
			Name = "Node_" .. node.id,
			BackgroundTransparency = 1,
			Image = "",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(c.X, c.Y),
			Size = UDim2.fromOffset(size, size),
			ZIndex = 3,
			Parent = field,
		})
		local pulse = Atlas.image("chrome", "glow", { Name = "Pulse", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1.9, 1.9), ImageColor3 = C.arcane, ImageTransparency = 1, ZIndex = 2, Parent = btn })
		local bgSprite = if node.kind == "active" then "diamond" else "disc"
		local bg = Atlas.image("chrome", bgSprite, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.84, 0.84), ImageColor3 = C.leather0, ZIndex = 3, Parent = btn })
		local icon = Atlas.image("icon", node.icon, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(if node.kind == "active" then 0.56 else 0.66, if node.kind == "active" then 0.56 else 0.66), ZIndex = 4, Parent = btn })
		local frameName = if node.kind == "active" then "node_diamond" elseif big then "node_keystone" else "node_round"
		local frame = Atlas.image("chrome", frameName, { Size = UDim2.fromScale(1, 1), ZIndex = 5, Parent = btn })
		local lock = Atlas.image("glyph", "lock", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.3, 0.3), ImageColor3 = C.textSoft, ZIndex = 6, Parent = btn })
		local badge = Create("Frame", { Name = "Rank", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 1, -2), Size = UDim2.fromOffset(34, 17), BackgroundColor3 = C.void, ZIndex = 7, Parent = btn }, { Create.corner(8), Create.stroke(C.goldDeep, 1, 0) })
		local rankText = Surface.text({ role = "number", text = "", size = 11, color = C.goldBright, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 8, Parent = badge })
		local ring = Create("Frame", { Name = "Selected", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1.22, 1.22), Visible = false, ZIndex = 2, Parent = btn }, {
			Create.corner(if node.kind == "active" then 8 else 99),
			Create.stroke(C.arcane, 2, 0),
		})
		if node.kind == "active" then
			ring.Rotation = 45
			ring.Size = UDim2.fromScale(0.95, 0.95)
		end
		local pop = Create.scale(1)
		pop.Parent = btn
		local v = { node = node, btn = btn, pulse = pulse, bg = bg, icon = icon, frame = frame, lock = lock, badge = badge, rankText = rankText, ring = ring, pop = pop, hover = false }
		views[node.id] = v
		v.ctl = Interact.attach(btn, scope, function(s)
			v.hover = s.hover or s.focused
			if v.paint then
				v.paint()
			end
		end, function()
			store:set({ selected = node.id })
		end)
		Feedback.tooltip(scope, btn, function()
			local st = store:get()
			local r = rank(st, node.id)
			local ok, why = SkillTree.canLearn(st, node)
			return Feedback.tooltipCard({
				title = node.name,
				body = Skills.describe(node, math.max(1, r)),
				hint = `Rank {r}/{node.max} · {if ok then "Can learn" else why}`,
				width = 230,
			})
		end, { side = "right" })
	end

	-- pulse animation for learnable nodes
	local t0 = os.clock()
	scope:connect(game:GetService("RunService").Heartbeat, function()
		if Motion.paused then
			return
		end
		local a = 0.55 + 0.25 * math.sin((os.clock() - t0) * 3.2)
		for _, v in views do
			if v.learnable then
				v.pulse.ImageTransparency = a
			end
		end
	end)

	-- detail pane
	local pane = Surface.well({ Name = "Detail", Position = UDim2.fromOffset(3 * BRANCH_W + 2 * GAP + 18, 54), Size = UDim2.new(1, -(3 * BRANCH_W + 2 * GAP + 18), 0, 520), Parent = content })
	local paneBody = Create.box({ Name = "Body", Size = UDim2.fromScale(1, 1), Parent = pane }, { Create.padding(16), Create.list("y", 10, Enum.HorizontalAlignment.Center) })
	local detailIcon = Create.box({ Size = UDim2.fromOffset(84, 84), LayoutOrder = 1, Parent = paneBody })
	local dGlow = Atlas.image("chrome", "glow", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1.6, 1.6), ImageTransparency = 0.6, Parent = detailIcon })
	local dBg = Atlas.image("chrome", "disc", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.84, 0.84), ImageColor3 = C.leather0, ZIndex = 2, Parent = detailIcon })
	local dIcon = Atlas.image("icon", "fireball", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.62, 0.62), ZIndex = 3, Parent = detailIcon })
	local dFrame = Atlas.image("chrome", "node_round", { Size = UDim2.fromScale(1, 1), ZIndex = 4, Parent = detailIcon })
	local dName = Surface.text({ role = "title", text = "", size = 22, color = C.goldBright, wrap = true, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 2, Parent = paneBody })
	local dKind = Surface.text({ role = "caps", text = "", size = 10, color = C.textFaint, LayoutOrder = 3, Parent = paneBody })
	local pips = Create.box({ Size = UDim2.new(1, 0, 0, 14), LayoutOrder = 4, Parent = paneBody }, { Create.list("x", 6, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center) })
	Surface.divider({ LayoutOrder = 5, Parent = paneBody })
	local dNow = Surface.text({ role = "body", text = "", size = 14, color = C.text, wrap = true, rich = true, LayoutOrder = 6, Parent = paneBody })
	local dNext = Surface.text({ role = "small", text = "", color = C.arcane, wrap = true, rich = true, LayoutOrder = 7, Parent = paneBody })
	local reqBox = Create.box({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 8, Parent = paneBody }, { Create.list("y", 5) })
	local actions = Create.box({ Name = "Actions", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 16, 1, -16), Size = UDim2.new(1, -32, 0, 88), Parent = pane }, { Create.list("y", 8) })
	local learnBtn = Button.new(scope, { text = "Learn", variant = "arcane", icon = "plus", fill = true, layoutOrder = 1, onClick = function()
		local st = Store.copy(store:get())
		local id = st.selected
		if SkillTree.learn(st, id) then
			store:set(st)
			Motion.pop(views[id].pop, 0.25)
			Motion.pop(gemPop, 0.2)
		end
	end })
	learnBtn.Instance.Name = "Learn"
	learnBtn.Instance.Parent = actions
	local row2 = Create.box({ Size = UDim2.new(1, 0, 0, 34), LayoutOrder = 2, Parent = actions }, { Create.list("x", 8) })
	local unlearnBtn = Button.new(scope, { text = "Unlearn", variant = "ghost", size = "small", icon = "minus", width = 110, layoutOrder = 1, onClick = function()
		local st = Store.copy(store:get())
		if SkillTree.unlearn(st, st.selected) then
			store:set(st)
		end
	end })
	unlearnBtn.Instance.Parent = row2
	local resetBtn = Button.new(scope, { text = "Reset tree", variant = "secondary", size = "small", icon = "refresh", width = 118, layoutOrder = 2, onClick = function()
		local st = store:get()
		local spent = 0
		for _, r in st.ranks do
			spent += r
		end
		Feedback.modal(scope, {
			title = "Reset skill tree",
			tone = "danger",
			icon = "arcane_orb",
			glow = C.arcane,
			body = `Unlearn every skill and refund <b>{spent}</b> point{if spent == 1 then "" else "s"}?`,
			confirm = { text = "Reset", variant = "danger" },
			onConfirm = function()
				store:set({ ranks = {}, points = st.points + spent })
			end,
		})
	end })
	resetBtn.Instance.Parent = row2
	local reason = Surface.text({ role = "lore", text = "", size = 12, color = C.textFaint, wrap = true, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 9, Parent = paneBody })
	local reqScope: any = nil

	local function render(st)
		pointsNum.Text = tostring(st.points)
		local total = 0
		for _, b in Skills.branches do
			local s = SkillTree.branchSpent(st, b.id)
			total += s
			branchHeads[b.id].Text = tostring(s)
		end
		spentText.Text = `{total} spent across three branches`
		for _, v in views do
			local node = v.node
			local r = rank(st, node.id)
			local reqOk = SkillTree.requirements(st, node)
			local learnable = SkillTree.canLearn(st, node)
			v.learnable = learnable and r == 0
			local color = Skills.branches[branchIndex[node.branch]].color
			local locked = not reqOk and r == 0
			v.paint = function()
				v.lock.Visible = locked
				v.icon.ImageColor3 = if locked then Color3.fromRGB(95, 88, 80) elseif r == 0 then Color3.fromRGB(175, 168, 158) else Color3.new(1, 1, 1)
				v.icon.ImageTransparency = if locked then 0.35 else 0
				v.frame.ImageColor3 = if r >= node.max then Color3.new(1, 1, 1) elseif r > 0 then Color3.fromRGB(235, 225, 210) elseif locked then Color3.fromRGB(110, 100, 90) else Color3.fromRGB(190, 180, 165)
				v.bg.ImageColor3 = if r > 0 then color:Lerp(C.void, 0.72) else C.leather0
				v.badge.Visible = node.max > 1 or r > 0
				v.rankText.Text = `{r}/{node.max}`
				v.rankText.TextColor3 = if r >= node.max then C.goldBright elseif r > 0 then C.text else C.textFaint
				v.ring.Visible = st.selected == node.id or v.hover
				v.ring:FindFirstChildOfClass("UIStroke").Color = if st.selected == node.id then C.goldBright else C.arcane
				if not v.learnable then
					v.pulse.ImageTransparency = if r >= node.max then 0.62 else 1
					v.pulse.ImageColor3 = color
				else
					v.pulse.ImageColor3 = C.arcane
				end
			end
			v.paint()
		end
		for _, e in edges do
			local lit = rank(st, e.to) > 0
			if lit ~= e.lit then
				e.lit = lit
				Motion.tween(e.fill, { Size = UDim2.new(if lit then 1 else 0, 0, 0, 3) }, if lit then 0.45 else 0.2, Enum.EasingStyle.Quad, nil, "fill")
			end
		end
		-- detail pane
		local node = Skills.get(st.selected)
		local r = rank(st, node.id)
		local color = Skills.branches[branchIndex[node.branch]].color
		for k, val in Atlas.icon(node.icon) do
			(dIcon :: any)[k] = val
		end
		Atlas.set(dFrame, "chrome", if node.kind == "active" then "node_diamond" elseif node.kind == "keystone" then "node_keystone" else "node_round")
		Atlas.set(dBg, "chrome", if node.kind == "active" then "diamond" else "disc")
		dGlow.ImageColor3 = color
		dName.Text = node.name
		dKind.Text = string.upper(`{node.kind} · {Skills.branches[branchIndex[node.branch]].name}`) .. (if node.cost then ` · {node.cost} mana · {node.cooldown}s` else "")
		for _, ch in pips:GetChildren() do
			if ch:IsA("GuiObject") then
				ch:Destroy()
			end
		end
		for i = 1, node.max do
			Atlas.image("chrome", "pip", { Size = UDim2.fromOffset(13, 13), ImageColor3 = if i <= r then Color3.new(1, 1, 1) else Color3.fromRGB(70, 60, 50), LayoutOrder = i, Parent = pips })
		end
		dNow.Text = if r > 0 then `<b>Rank {r}:</b> {Skills.describe(node, r)}` else Skills.describe(node, 1)
		dNow.TextColor3 = if r > 0 then C.text else C.textSoft
		dNext.Visible = r > 0 and r < node.max
		dNext.Text = `<b>Next rank:</b> {Skills.describe(node, r + 1)}`
		if reqScope then
			reqScope:Destroy()
		end
		reqScope = scope:child()
		local _, reqs = SkillTree.requirements(st, node)
		for i, q in reqs do
			local row = reqScope:add(Create.box({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = i, Parent = reqBox }, { Create.list("x", 6) }))
			Atlas.image("glyph", if q.met then "check" else "close", { Size = UDim2.fromOffset(14, 14), Position = UDim2.fromOffset(0, 2), ImageColor3 = if q.met then C.good else C.bad, LayoutOrder = 1, Parent = row })
			local t = Surface.text({ role = "small", text = q.text, color = if q.met then C.textSoft else C.text, size = 12, wrap = true, LayoutOrder = 2, Parent = row })
			t.Size = UDim2.new(1, -20, 0, 0)
		end
		local canL, why = SkillTree.canLearn(st, node)
		local canU, whyU = SkillTree.canUnlearn(st, node)
		learnBtn:setDisabled(not canL)
		learnBtn:setText(if r >= node.max then "Mastered" elseif r > 0 then "Learn next rank" else "Learn")
		unlearnBtn:setDisabled(not canU)
		local spent = 0
		for _, rr in st.ranks do
			spent += rr
		end
		resetBtn:setDisabled(spent == 0)
		reason.Text = if canL then "Costs 1 point" elseif r > 0 and not canU and whyU and whyU ~= "Not learned" then `Can't unlearn: {whyU}` else (why or "")
		reason.TextColor3 = if canL then C.textFaint else C.warn
	end
	scope:add(store:subscribe(render))
	render(store:get())

	return {
		Instance = panel,
		store = store,
		views = views,
		reset = function()
			store:reset()
		end,
		select = function(_, id: string)
			store:set({ selected = id })
		end,
		learn = function(_, id: string)
			local st = Store.copy(store:get())
			st.selected = id
			local ok = SkillTree.learn(st, id)
			store:set(st)
			if ok then
				Motion.pop(views[id].pop, 0.25)
			end
			return ok
		end,
	}
end

return SkillTree
]]></ProtectedString></Properties>
      </Item>
    </Item>
  </Item>
  <Item class="Folder" referent="RBX47"><Properties><string name="Name">VellumGallery</string></Properties>
    <Item class="ModuleScript" referent="RBX34"><Properties><string name="Name">App</string><ProtectedString name="Source"><![CDATA[--!strict
-- Gallery app: a neutral shell for browsing specimens. Sidebar (families → specimens), header (title,
-- blurb, stage width presets, reduced motion, capture mode, reset), the stage, and an action bar with
-- the specimen's state actions. The shell deliberately uses plain system type and greys so the
-- Vellum pieces are the only styled thing on screen.
local UserInputService = game:GetService("UserInputService")

local Lib = require(script.Parent.Lib)
local Create = require(Lib.Core.Create)
local Scope = require(Lib.Core.Scope)
local Signal = require(Lib.Core.Signal)
local Motion = require(Lib.Core.Motion)
local Registry = require(script.Parent.Registry)
local Stage = require(script.Parent.Stage)

local App = {}

local G = {
	bg = Color3.fromHex("0B0A09"),
	side = Color3.fromHex("121110"),
	line = Color3.fromHex("26231F"),
	text = Color3.fromHex("E8E2D8"),
	soft = Color3.fromHex("9A938A"),
	faint = Color3.fromHex("5F5952"),
	hi = Color3.fromHex("1F1C19"),
	accent = Color3.fromHex("D4A55A"),
}
local FONT = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Medium)
local FONT_B = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Bold)

local function label(text: string, size: number, color: Color3, props: { [string]: any }?): TextLabel
	local p: { [string]: any } = {
		BackgroundTransparency = 1,
		Text = text,
		TextSize = size,
		TextColor3 = color,
		FontFace = FONT,
		TextXAlignment = Enum.TextXAlignment.Left,
		AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.new(),
	}
	for k, v in props or {} do
		p[k] = v
	end
	return Create("TextLabel", p)
end

local function chip(text: string, onClick: () -> (), props: { [string]: any }?): TextButton
	local p: { [string]: any } = {
		Text = text,
		TextSize = 13,
		FontFace = FONT,
		TextColor3 = G.soft,
		BackgroundColor3 = G.hi,
		AutoButtonColor = false,
		Size = UDim2.fromOffset(0, 28),
		AutomaticSize = Enum.AutomaticSize.X,
	}
	for k, v in props or {} do
		p[k] = v
	end
	local b = Create("TextButton", p, { Create.corner(6), Create.padding(0, 12, 0, 12), Create.stroke(G.line, 1, 0) })
	b.MouseEnter:Connect(function()
		b.TextColor3 = G.text
	end)
	b.MouseLeave:Connect(function()
		if not b:GetAttribute("On") then
			b.TextColor3 = G.soft
		end
	end)
	b.Activated:Connect(onClick)
	return b
end

local function setOn(b: TextButton, on: boolean)
	b:SetAttribute("On", on)
	b.TextColor3 = if on then G.bg else G.soft
	b.BackgroundColor3 = if on then G.accent else G.hi
end

function App.start(gui: ScreenGui)
	local self = {
		current = nil :: any,
		mounted = nil :: any,
		changed = Signal.new(),
		capture = false,
		width = "full",
	}
	local root = Create("Frame", { Name = "Gallery", BackgroundColor3 = G.bg, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Parent = gui })

	-- sidebar
	local side = Create("Frame", { Name = "Sidebar", BackgroundColor3 = G.side, BorderSizePixel = 0, Size = UDim2.new(0, 250, 1, 0), Parent = root }, { Create.stroke(G.line, 1, 0) })
	local brand = Create.box({ Size = UDim2.new(1, 0, 0, 84), Parent = side }, { Create.padding(20, 18, 0, 20) })
	label("VELLUM", 20, G.accent, { FontFace = FONT_B, Parent = brand })
	label("Fantasy RPG UI Library", 13, G.soft, { Position = UDim2.fromOffset(0, 28), Parent = brand })
	label("Component gallery · Studio", 11, G.faint, { Position = UDim2.fromOffset(0, 46), Parent = brand })
	local list = Create("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 84),
		Size = UDim2.new(1, 0, 1, -84 - 64),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = G.line,
		Parent = side,
	}, { Create.padding(4, 10, 16, 10), Create.list("y", 2) })
	local entries = {}
	local order = 0
	for _, fam in Registry.families do
		order += 1
		local h = label(string.upper(fam.title), 11, G.faint, { FontFace = FONT_B, LayoutOrder = order, Parent = list })
		Create.padding(14, 0, 6, 10).Parent = h
		for _, s in Registry.inFamily(fam.id) do
			order += 1
			local b = Create("TextButton", {
				Name = s.id,
				Text = s.title,
				TextSize = 14,
				FontFace = FONT,
				TextColor3 = G.soft,
				TextXAlignment = Enum.TextXAlignment.Left,
				BackgroundColor3 = G.hi,
				BackgroundTransparency = 1,
				AutoButtonColor = false,
				Size = UDim2.new(1, 0, 0, 30),
				LayoutOrder = order,
				Parent = list,
			}, { Create.corner(6), Create.padding(0, 10, 0, 10) })
			b.MouseEnter:Connect(function()
				if self.current ~= s then
					b.BackgroundTransparency = 0.5
				end
			end)
			b.MouseLeave:Connect(function()
				if self.current ~= s then
					b.BackgroundTransparency = 1
				end
			end)
			b.Activated:Connect(function()
				self.show(s.id)
			end)
			entries[s.id] = b
		end
	end
	local leak = label("", 11, G.faint, { Position = UDim2.new(0, 20, 1, -52), Parent = side })
	label("PgUp/PgDn specimen · Ctrl+R reset · F8 capture", 11, G.faint, { Position = UDim2.new(0, 20, 1, -30), Parent = side })

	-- main column
	local main = Create.box({ Name = "Main", Position = UDim2.fromOffset(250, 0), Size = UDim2.new(1, -250, 1, 0), Parent = root })
	local header = Create("Frame", { Name = "Header", BackgroundColor3 = G.bg, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 76), Parent = main }, { Create.padding(16, 24, 0, 28) })
	local title = label("", 22, G.text, { FontFace = FONT_B, Parent = header })
	local blurb = label("", 13, G.soft, { Position = UDim2.fromOffset(0, 32), Size = UDim2.new(1, -520, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true, Parent = header })
	local tools = Create.box({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 4), Size = UDim2.fromOffset(0, 28), AutomaticSize = Enum.AutomaticSize.X, Parent = header }, { Create.list("x", 6, nil, Enum.VerticalAlignment.Center) })
	local widthChips = {}
	for i, w in { { "full", "Fit" }, { "1024", "1024 px" }, { "720", "720 px" } } do
		local c = chip(w[2], function()
			self.setWidth(w[1])
		end, { LayoutOrder = i, Parent = tools })
		widthChips[w[1]] = c
	end
	Create.box({ Size = UDim2.fromOffset(8, 1), LayoutOrder = 10, Parent = tools })
	local motionChip = chip("Motion", function()
		Motion.reduced = not Motion.reduced
		self.refreshChips()
	end, { LayoutOrder = 11, Parent = tools })
	local captureChip = chip("Capture", function()
		self.setCapture(not self.capture)
	end, { LayoutOrder = 12, Parent = tools })
	chip("Reset", function()
		self.reset()
	end, { LayoutOrder = 13, Parent = tools })

	local stageHost = Create.box({ Name = "StageHost", Position = UDim2.fromOffset(0, 76), Size = UDim2.new(1, 0, 1, -76 - 56), ClipsDescendants = true, Parent = main })
	local actionBar = Create("Frame", { Name = "Actions", BackgroundColor3 = G.side, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 56), Parent = main }, {
		Create.stroke(G.line, 1, 0),
		Create.padding(0, 24, 0, 24),
		Create.list("x", 8, nil, Enum.VerticalAlignment.Center),
	})

	function self.refreshChips()
		for k, c in widthChips do
			setOn(c, self.width == k)
		end
		setOn(motionChip, not Motion.reduced)
		setOn(captureChip, self.capture)
	end

	local function mount()
		if self.mounted then
			self.mounted.scope:Destroy()
			self.mounted = nil
		end
		local s = self.current
		local insets = { 0, 0, 0, 0 }
		if self.width ~= "full" and not self.capture then
			local w = tonumber(self.width) :: number
			local avail = stageHost.AbsoluteSize.X
			local side = math.max(0, (avail - w) / 2)
			insets = { side, 0, side, 0 }
		end
		if self.capture then
			-- keep the canvas clear of Roblox's top-bar buttons (top-left corner of the viewport)
			insets = { 8, 64, 8, 8 }
		end
		local host: GuiObject = if self.capture then root else stageHost
		self.mounted = Stage.mount(host, s, {
			capture = self.capture,
			tiled = self.capture and self.tiled,
			fixedScale = self.captureScale or 2,
			maxScale = if self.capture then (self.captureScale or 2) else 1.5,
			insets = insets,
			margin = if self.capture then 28 else 36,
		})
		if self.capture then
			self.mounted.canvas.Parent.Parent.ZIndex = 50
			for _, d in self.mounted.canvas.Parent.Parent:GetDescendants() do
				if d:IsA("GuiObject") then
					d.ZIndex += 50
				end
			end
		end
		-- actions
		for _, ch in actionBar:GetChildren() do
			if ch:IsA("GuiObject") then
				ch:Destroy()
			end
		end
		label("STATE", 11, G.faint, { FontFace = FONT_B, LayoutOrder = 0, Parent = actionBar })
		for i, a in self.mounted.built.actions or {} do
			chip(a.label, function()
				task.spawn(a.run)
			end, { LayoutOrder = i, Parent = actionBar })
		end
		if not self.mounted.built.actions or #self.mounted.built.actions == 0 then
			label("Hover, click and focus the pieces directly.", 12, G.faint, { LayoutOrder = 1, Parent = actionBar })
		end
	end

	function self.show(id: string)
		local s = Registry.get(id)
		if not s then
			return false
		end
		if self.current then
			local prev = entries[self.current.id]
			prev.BackgroundTransparency = 1
			prev.TextColor3 = G.soft
		end
		self.current = s
		local e = entries[id]
		e.BackgroundTransparency = 0
		e.TextColor3 = G.text
		title.Text = s.title
		blurb.Text = s.blurb
		mount()
		self.changed:Fire(id)
		return true
	end

	function self.reset()
		if not self.mounted then
			return
		end
		local r = self.mounted.built.onReset
		if r then
			r()
		else
			mount()
		end
	end

	function self.remount()
		mount()
	end

	function self.setWidth(w: string)
		self.width = w
		self.refreshChips()
		mount()
	end

	function self.setCapture(on: boolean, scale: number?)
		if not on then
			self.tiled = false
		end
		Motion.paused = false
		self.capture = on
		self.captureScale = scale
		UserInputService.MouseIconEnabled = not on
		side.Visible = not on
		header.Visible = not on
		actionBar.Visible = not on
		self.refreshChips()
		mount()
	end

	-- Tiled capture: render the current specimen at `scale` and walk the tile grid, holding each tile with
	-- its marker so tools/capture/tiles.py can grab and stitch them. Returns the grid geometry.
	-- prep: action labels to run (in order) on the fresh mount before tiling; prepWait: settle time after.
	function self.captureTiles(scale: number, prep: { string }?, prepWait: number?)
		local hold = nil
		self.tiled = true
		self.setCapture(true, scale)
		task.wait(0.3)
		local m = self.mounted
		for _, label in prep or {} do
			for _, a in m.built.actions or {} do
				if a.label == label then
					a.run()
				end
			end
			task.wait(0.2)
		end
		task.wait(prepWait or 0.4)
		Motion.paused = true
		local size = m.canvas.AbsoluteSize -- scaled canvas, logical px
		local win = m.slot.AbsoluteSize
		local stepX = math.floor(win.X / 4) * 4
		local stepY = math.floor(win.Y / 4) * 4
		local cols = math.max(1, math.ceil(size.X / stepX))
		local rows = math.max(1, math.ceil(size.Y / stepY))
		local token = {}
		self.tileToken = token
		task.spawn(function()
			local i = 0
			for r = 0, rows - 1 do
				for c = 0, cols - 1 do
					if self.tileToken ~= token then
						return
					end
					m.setTile(c * stepX, r * stepY)
					m.marker(62) -- "moving"
					task.wait(0.35)
					m.marker(i)
					task.wait(if i == 0 then 6 else (hold or 0.9))
					i += 1
				end
			end
			m.marker(63)
		end)
		return { w = size.X, h = size.Y, winW = win.X, winH = win.Y, stepX = stepX, stepY = stepY, cols = cols, rows = rows }
	end

	-- Batch capture: jobs = { {id, scale, prep, wait} }. Returns every job's geometry at once and then walks
	-- them in order (job index in the upper marker row, tile index in the lower one; tile 63 = job done).
	function self.captureBatch(jobs: { any })
		local vp = workspace.CurrentCamera.ViewportSize
		local winW, winH = vp.X - 16, vp.Y - 64 - 8
		local stepX, stepY = math.floor(winW / 4) * 4, math.floor(winH / 4) * 4
		local geo = {}
		for j, job in jobs do
			local s = Registry.get(job.id)
			assert(s, job.id)
			local scale = job.scale or 2
			local w, h = (s.size.X + 56) * scale, (s.size.Y + 56) * scale
			geo[j] = { id = job.id, w = w, h = h, winW = winW, winH = winH, stepX = stepX, stepY = stepY, cols = math.ceil(w / stepX), rows = math.ceil(h / stepY) }
		end
		local token = {}
		self.tileToken = token
		task.spawn(function()
			for j, job in jobs do
				if self.tileToken ~= token then
					return
				end
				self.show(job.id)
				self.tiled = true
				self.setCapture(true, job.scale or 2)
				task.wait(0.4)
				local m = self.mounted
				m.marker(62, j - 1)
				for _, label in job.prep or {} do
					for _, a in m.built.actions or {} do
						if a.label == label then
							a.run()
						end
					end
					task.wait(0.25)
				end
				task.wait(job.wait or 0.5)
				Motion.paused = true
				local g = geo[j]
				local i = 0
				for r = 0, g.rows - 1 do
					for c = 0, g.cols - 1 do
						m.setTile(c * stepX, r * stepY)
						m.marker(62, j - 1)
						task.wait(0.3)
						m.marker(i, j - 1)
						task.wait(if j == 1 and i == 0 then 15 else 0.8)
						i += 1
					end
				end
				m.marker(63, j - 1)
				task.wait(0.8)
				Motion.paused = false
			end
			self.setCapture(false)
		end)
		return geo
	end

	function self.step(d: number)
		local i = table.find(Registry.list, self.current) or 1
		local n = #Registry.list
		self.show(Registry.list[(i - 1 + d + n) % n + 1].id)
	end

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.PageDown or (input.KeyCode == Enum.KeyCode.Down and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)) then
			self.step(1)
		elseif input.KeyCode == Enum.KeyCode.PageUp or (input.KeyCode == Enum.KeyCode.Up and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)) then
			self.step(-1)
		elseif input.KeyCode == Enum.KeyCode.R and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
			self.reset()
		elseif input.KeyCode == Enum.KeyCode.F8 then
			self.setCapture(not self.capture)
		end
	end)

	-- live leak counter: scopes and listeners alive, instances under the stage
	task.spawn(function()
		while root.Parent do
			local n = 0
			if self.mounted then
				n = #self.mounted.canvas:GetDescendants()
			end
			leak.Text = `Scopes {Scope.liveCount()} · listeners {Signal.listenerCount()} · instances {n}`
			task.wait(0.5)
		end
	end)

	self.refreshChips()
	self.show(Registry.list[1].id)
	return self
end

return App
]]></ProtectedString></Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX35"><Properties><string name="Name">Captures</string><ProtectedString name="Source"><![CDATA[--!strict
